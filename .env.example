# Settings of the sign-up backend (worker/). Copy this file to `.env` and fill it in:
# `npm run dev` and `npm run preview` read it. `.env` is ignored by git; never commit real values.
#
# In production, set the same names as secrets on the Cloudflare Worker:
#   npx wrangler secret put RESEND_API_KEY        (or dashboard → Worker → Settings → Variables and Secrets)

# Resend API key (https://resend.com/api-keys). "Sending access" is enough.
RESEND_API_KEY=

# Sender of the e-mails. Its domain must be verified in Resend (https://resend.com/domains).
# An address alone works too: it is sent as "Carinova <address>".
EMAIL_FROM="Carinova <casillero@carinovanic.com>"

# Neon connection string, copied from the Neon dashboard with "Connection pooling" on:
#   postgresql://USER:PASSWORD@ep-…-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Its host contains "-pooler"; keep the parameters as Neon gives them.
# The table is created by db/schema.sql.
DATABASE_URL=

# Encrypts the confirmation links. Any random text of 32 characters or more; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it invalidates the links already sent.
SIGNUP_TOKEN_SECRET=

# Optional: an inbox that gets an e-mail for every new customer.
SIGNUP_NOTIFY_TO=
