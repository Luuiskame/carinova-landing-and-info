---
// What an address that does not exist gets. Built twice, like every page: /404.html for the Spanish
// site and /en/404.html for addresses under /en (astro.config.ts), which is where Cloudflare looks
// for the nearest 404 page.
import Layout from '~/layouts/PageLayout.astro';
import CtaGroup from '~/components/carinova/CtaGroup.astro';
import { i18n } from '~/i18n';

const { locale, href, data } = i18n(Astro);
const { WA_MESSAGES } = data;

const t = {
  es: {
    metaTitle: 'Página no encontrada',
    title: 'No encontramos esta página',
    lead: '¿Buscabas otra cosa?',
  },
  en: {
    metaTitle: 'Page not found',
    title: 'We could not find this page',
    lead: 'Were you looking for something else?',
  },
}[locale];

const linkClass = 'font-semibold text-link underline underline-offset-4';
---

<Layout metadata={{ title: t.metaTitle, robots: { index: false, follow: true } }}>
  <section class="mx-auto flex max-w-xl flex-col items-center px-4 py-20 text-center md:py-28">
    <p class="font-heading text-8xl font-extrabold text-primary md:text-9xl" aria-hidden="true">404</p>
    <h1 class="mt-6 font-heading text-3xl font-bold text-heading">{t.title}</h1>
    {
      locale === 'en' ? (
        <p class="mt-4 text-lg text-muted">
          The link may be mistyped or the page may no longer exist. Try from the{' '}
          <a class={linkClass} href={href('/')}>
            home page
          </a>{' '}
          or carry on with what you came to do:
        </p>
      ) : (
        <p class="mt-4 text-lg text-muted">
          Puede que el enlace esté mal escrito o que la página ya no exista. Probá desde el{' '}
          <a class={linkClass} href={href('/')}>
            inicio
          </a>{' '}
          o seguí con lo que viniste a hacer:
        </p>
      )
    }
    <CtaGroup class="mt-8 w-full" whatsapp={WA_MESSAGES.notFound} whatsappLead={t.lead} />
  </section>
</Layout>
