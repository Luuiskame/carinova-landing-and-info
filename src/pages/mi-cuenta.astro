---
// Mi cuenta. One address, two views, and CSS shows the one that applies (SessionState.astro):
//
// - A customer who is signed in gets their account (AccountPanel.astro): Carinova ID, packages,
//   payments, address in the United States and their details, all fetched from the Worker.
// - A visitor gets what an account is made of (ACCOUNT_PARTS) and the two ways in: "Ingresá", which
//   opens the sign-in dialog, and "Crear cuenta". Companies have their own page (/empresas).
//
// The file itself holds nobody's data, so it can be indexed like any other page.
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import AccountPanel from '~/components/carinova/AccountPanel.astro';
import ClosingCta from '~/components/carinova/ClosingCta.astro';
import ServiceBadge from '~/components/carinova/ServiceBadge.astro';

import { CARINOVA_ID_EXAMPLE, LAST_MILE } from '~/data/carinova';
import { PACKAGE_STAGES, SIGNIN_DIALOG_ID } from '~/data/account';
import { i18n } from '~/i18n';

const { locale, href, data } = i18n(Astro);
const { ACCOUNT_PARTS, BRANCHES, CTA, RECEPTION_POINTS, WA_MESSAGES } = data;

const cityNames = BRANCHES.map((branch) => branch.city);

const t = {
  es: {
    tagline: 'Mi cuenta',
    metaTitle: 'Mi cuenta: Carinova ID, paquetes y pagos',
    description: `Ingresá a tu cuenta Carinova: tu Carinova ID, tu dirección en Estados Unidos, tus paquetes con su estado y tus pagos. Retirá en ${cityNames.join(' o ')}.`,
    title: 'Tu cuenta Carinova',
    subtitle:
      'Realizá todas tus gestiones desde un mismo lugar: tu Carinova ID, tu dirección, tus paquetes y tus pagos.',
    signin: 'Ingresá a tu cuenta',
    noAccount: '¿Todavía no tenés cuenta?',
    includes: 'Lo que encontrás en tu cuenta',
    looksLike: 'Se ve así',
    idFacts: [
      'El sistema te lo asigna al confirmar tu correo.',
      'Es el mismo para aéreo, marítimo, encomiendas y compras asistidas.',
    ],
    company: '¿Sos empresa?',
    companyLink: 'Conocé Carinova para negocios',
    fullAddress: 'Ves la dirección completa al ingresar.',
    stages: 'Cada paquete, con su etapa:',
    paymentFacts: [
      'Cada factura con su monto y su estado.',
      'Un pago aparece como confirmado cuando nuestro equipo lo verifica.',
    ],
    pickup: 'Retirás en',
    homeDelivery: 'Entrega a domicilio',
    branches: 'Ver sucursales',
    closing: {
      title: 'Creá tu cuenta en un par de minutos',
      subtitle: 'Llenás un formulario corto, confirmás tu correo y listo: ya tenés tu Carinova ID.',
      lead: '¿Tenés dudas antes de registrarte?',
    },
  },
  en: {
    tagline: 'My account',
    metaTitle: 'My account: Carinova ID, packages and payments',
    description: `Sign in to your Carinova account: your Carinova ID, your address in the United States, your packages with their status and your payments. Pick up in ${cityNames.join(' or ')}.`,
    title: 'Your Carinova account',
    subtitle: 'Handle everything from one place: your Carinova ID, your address, your packages and your payments.',
    signin: 'Sign in to your account',
    noAccount: 'Do you not have an account yet?',
    includes: 'What you find in your account',
    looksLike: 'It looks like this',
    idFacts: [
      'The system assigns it when you confirm your e-mail.',
      'It is the same for air, sea, packages and assisted purchases.',
    ],
    company: 'Are you a company?',
    companyLink: 'See Carinova for business',
    fullAddress: 'You see the full address when you sign in.',
    stages: 'Every package, with its stage:',
    paymentFacts: [
      'Every invoice with its amount and its status.',
      'A payment shows as confirmed once our team verifies it.',
    ],
    pickup: 'You pick up in',
    homeDelivery: 'Home delivery',
    branches: 'See branches',
    closing: {
      title: 'Create your account in a couple of minutes',
      subtitle: 'You fill in a short form, confirm your e-mail and that is it: you have your Carinova ID.',
      lead: 'Any questions before you sign up?',
    },
  },
}[locale];

const metadata = { title: t.metaTitle, description: t.description };

const part = (id: string) => ACCOUNT_PARTS.find((item) => item.id === id)!;
const cardClass = 'flex scroll-mt-24 flex-col rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 sm:p-7';
const titleClass = 'flex items-center gap-2 font-heading text-xl font-bold text-heading';
const linkClass = 'inline-flex min-h-11 items-center font-semibold text-link underline underline-offset-4';
const factClass = 'flex gap-2';
---

<Layout metadata={metadata} breadcrumb={t.tagline}>
  <AccountPanel />

  <div data-auth="out">
    <HeroText tagline={t.tagline} title={t.title} subtitle={t.subtitle} />

    <div class="px-4 pb-4 text-center">
      <div class="mx-auto flex max-w-sm flex-col justify-center gap-3 sm:max-w-none sm:flex-row">
        <a class="btn-primary" href={href(CTA.signin.path)} data-dialog-open={SIGNIN_DIALOG_ID}>
          {t.signin}
          <Icon name="tabler:arrow-up-right" class="h-5 w-5 shrink-0" />
        </a>
        <a class="btn" href={href(CTA.signup.path)}>
          {CTA.signup.text}
          <Icon name="tabler:arrow-up-right" class="h-5 w-5 shrink-0" />
        </a>
      </div>
    </div>

    <WidgetWrapper id="cuenta" containerClass="max-w-6xl" bg='<div class="absolute inset-0 bg-slate-50"></div>'>
      <h2 class="mb-8 text-center font-heading text-3xl font-bold tracking-tight text-heading md:text-4xl">
        {t.includes}
      </h2>
      <div class="grid gap-6 md:grid-cols-2">
        <article id="carinova-id" class={cardClass}>
          <h3 class={titleClass}>
            <Icon name={part('carinova-id').icon} class="h-7 w-7 text-primary" />
            {part('carinova-id').title}
          </h3>
          <p class="mt-2 text-muted">{part('carinova-id').summary}</p>
          <p class="mt-5 text-xs font-semibold tracking-wide text-slate-600 uppercase">{t.looksLike}</p>
          <p
            class="mt-1 w-fit rounded-xl bg-navy px-5 py-2 font-heading text-2xl font-extrabold tracking-wide text-white"
          >
            {CARINOVA_ID_EXAMPLE}
          </p>
          <ul class="mt-5 flex-1 space-y-2.5 text-sm">
            {
              t.idFacts.map((fact) => (
                <li class={factClass}>
                  <Icon name="tabler:circle-check-filled" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                  <span>{fact}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-5 flex flex-wrap items-center gap-x-1.5 text-sm text-muted">
            <span>{t.company}</span>
            <a class={linkClass} href={href('/empresas')}>{t.companyLink}</a>
          </p>
        </article>

        <article id="direccion-eeuu" class={cardClass}>
          <h3 class={titleClass}>
            <Icon name={part('direccion').icon} class="h-7 w-7 text-primary" />
            {part('direccion').title}
          </h3>
          <ul class="mt-5 space-y-3">
            {
              RECEPTION_POINTS.map((point) => (
                <li
                  class:list={[
                    'rounded-xl p-4',
                    point.available ? 'bg-slate-50 ring-1 ring-slate-200' : 'border-2 border-dashed border-slate-300',
                  ]}
                >
                  <p class="flex flex-wrap items-center gap-2 font-semibold text-heading">
                    {point.city}, {point.state}
                    {!point.available && <ServiceBadge kind="soon" />}
                  </p>
                  {point.available && <p class="mt-1 text-sm text-muted">{t.fullAddress}</p>}
                </li>
              ))
            }
          </ul>
        </article>

        <article id="tus-paquetes" class={cardClass}>
          <h3 class={titleClass}>
            <Icon name={part('paquetes').icon} class="h-7 w-7 text-primary" />
            {part('paquetes').title}
          </h3>
          <p class="mt-2 text-muted">{part('paquetes').summary}</p>
          <p class="mt-5 text-sm font-semibold text-heading">{t.stages}</p>
          <ol class="mt-2 flex flex-wrap gap-2 text-sm">
            {
              PACKAGE_STAGES.map((stage, index) => (
                <li class="rounded-full bg-slate-100 px-3 py-1 font-medium text-slate-800">
                  {`${index + 1}. ${stage[locale].name}`}
                </li>
              ))
            }
          </ol>
          <p class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
            <span>{t.pickup} {cityNames.join(locale === 'en' ? ' or ' : ' o ')}.</span>
            {
              LAST_MILE.available && (
                <span class="font-semibold text-heading">
                  {t.homeDelivery}
                  {LAST_MILE.extraCharge && <ServiceBadge kind="extra" />}
                </span>
              )
            }
          </p>
          <a class:list={['mt-2', linkClass]} href={href('/sucursales')}>{t.branches}</a>
        </article>

        <article id="tus-pagos" class={cardClass}>
          <h3 class={titleClass}>
            <Icon name={part('pagos').icon} class="h-7 w-7 text-primary" />
            {part('pagos').title}
          </h3>
          <p class="mt-2 text-muted">{part('pagos').summary}</p>
          <ul class="mt-5 flex-1 space-y-2.5 text-sm">
            {
              t.paymentFacts.map((fact) => (
                <li class={factClass}>
                  <Icon name="tabler:circle-check-filled" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                  <span>{fact}</span>
                </li>
              ))
            }
          </ul>
        </article>
      </div>
      <p class="mt-8 flex flex-wrap items-center justify-center gap-x-1.5 text-muted">
        <span>{t.noAccount}</span>
        <a class={linkClass} href={href(CTA.signup.path)}>{CTA.signup.text}</a>
      </p>
    </WidgetWrapper>

    <ClosingCta
      title={t.closing.title}
      subtitle={t.closing.subtitle}
      whatsapp={WA_MESSAGES.accountClosing}
      whatsappLead={t.closing.lead}
    />
  </div>
</Layout>
