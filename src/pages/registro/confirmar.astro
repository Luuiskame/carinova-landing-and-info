---
import Layout from '~/layouts/PageLayout.astro';
import SignupConfirm from '~/components/carinova/SignupConfirm.astro';
import { i18n } from '~/i18n';

const { locale } = i18n(Astro);

// Reached only through the link of the confirmation e-mail: nothing here for search engines.
const metadata = {
  title: { es: 'Confirmá tu correo', en: 'Confirm your e-mail' }[locale],
  robots: { index: false, follow: false },
};
---

<Layout metadata={metadata}>
  <!-- The address of this page carries the confirmation token: never pass it on as a referrer. -->
  <meta slot="head" name="referrer" content="no-referrer" />

  <SignupConfirm />
</Layout>
