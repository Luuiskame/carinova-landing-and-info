---
// Crear cuenta: the sign-up form. Part of "Mi cuenta"; the only exits offered besides the form
// are signing in, for people who already have an account, and WhatsApp, for people who prefer to be
// helped.
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import SignupForm from '~/components/carinova/SignupForm.astro';
import WhatsAppHelp from '~/components/carinova/WhatsAppHelp.astro';

import { i18n } from '~/i18n';

const { locale, href, data } = i18n(Astro);
const { BRANCHES, CTA, WA_MESSAGES } = data;

const cityNames = BRANCHES.map((branch) => branch.city);

const t = {
  es: {
    tagline: 'Mi cuenta',
    title: 'Creá tu cuenta',
    description: `Un solo registro: creá tu cuenta en línea y recibí tu Carinova ID y tu dirección en Estados Unidos para comprar en cualquier tienda y recibir en ${cityNames.join(' o ')}.`,
    subtitle:
      'Un solo registro. Al confirmar tu correo, el sistema te asigna automáticamente tu Carinova ID y te muestra tu dirección en Estados Unidos.',
    existing: '¿Ya tenés cuenta?',
    next: '¿Qué pasa después?',
    steps: [
      { title: 'Confirmá tu correo', description: 'Te mandamos un enlace. Abrilo para activar tu cuenta.' },
      {
        title: 'Recibí tu Carinova ID y tu dirección en Estados Unidos',
        description: 'Los ves en pantalla al confirmar y también te llegan por correo.',
      },
      {
        title: 'Comprá y nosotros lo traemos',
        description: `Usá tu dirección en la tienda, seguí tu paquete en tu cuenta y retiralo en ${cityNames.join(' o ')}.`,
      },
    ],
    helpTitle: '¿Preferís que te ayudemos?',
    helpText: 'Escribinos y creamos tu cuenta por WhatsApp.',
  },
  en: {
    tagline: 'My account',
    title: 'Create your account',
    description: `One sign-up: create your account online and get your Carinova ID and your address in the United States to buy at any store and receive in ${cityNames.join(' or ')}.`,
    subtitle:
      'One sign-up. When you confirm your e-mail, the system assigns your Carinova ID automatically and shows you your address in the United States.',
    existing: 'Already have an account?',
    next: 'What happens next?',
    steps: [
      { title: 'Confirm your e-mail', description: 'We send you a link. Open it to activate your account.' },
      {
        title: 'Get your Carinova ID and your address in the United States',
        description: 'You see them on screen when you confirm, and they also reach you by e-mail.',
      },
      {
        title: 'Buy, and we bring it',
        description: `Use your address at the store, follow your package in your account and pick it up in ${cityNames.join(' or ')}.`,
      },
    ],
    helpTitle: 'Would you rather we help you?',
    helpText: 'Write to us and we will create your account through WhatsApp.',
  },
}[locale];

const metadata = { title: t.title, description: t.description };
---

<Layout metadata={metadata} breadcrumb={t.title}>
  <HeroText tagline={t.tagline} title={t.title} subtitle={t.subtitle} />

  <p class="flex flex-wrap items-center justify-center gap-x-1.5 px-4 text-muted" data-auth="out">
    <span>{t.existing}</span>
    <a
      class="inline-flex min-h-11 items-center font-semibold text-link underline underline-offset-4"
      href={href(CTA.signin.path)}
    >
      {CTA.signin.text}
    </a>
  </p>

  <section class="mx-auto max-w-6xl px-4 pt-6 pb-16 sm:px-6 md:pb-20">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:gap-12">
      <SignupForm />

      <aside class="lg:pt-2">
        <h2 class="font-heading text-xl font-bold text-heading">{t.next}</h2>
        <ol class="mt-5 space-y-5">
          {
            t.steps.map((step, index) => (
              <li class="flex gap-4">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-navy font-heading font-bold text-white">
                  {index + 1}
                </span>
                <div>
                  <h3 class="font-semibold text-heading">{step.title}</h3>
                  <p class="mt-1 text-sm text-muted">{step.description}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="mt-8 rounded-2xl bg-slate-50 p-6 ring-1 ring-slate-200">
          <h2 class="font-heading text-lg font-bold text-heading">{t.helpTitle}</h2>
          <p class="mt-1 text-sm text-muted">{t.helpText}</p>
          <WhatsAppHelp class="mt-2" message={WA_MESSAGES.signupAssist} />
        </div>
      </aside>
    </div>
  </section>
</Layout>
