---
// Inicio. The sections, their look and their order follow Carinova's "Signature" design: hero, the
// three facts under it, the four solutions (with the stores), the two ways of shipping, the
// calculator, the three steps, tracking (with the article search), the band for companies, the
// branches, the questions and the closing call (docs/INFORMATION-ARCHITECTURE.md → "The home page").
// Each section is a component; what it says comes from src/data and src/i18n/ui, so the pages that
// own each subject cannot disagree with it. Like every page, it renders in Spanish at its own
// address and in each translation under its prefix (src/i18n).
import Layout from '~/layouts/PageLayout.astro';

import HomeHero from '~/components/carinova/HomeHero.astro';
import ProofStrip from '~/components/carinova/ProofStrip.astro';
import SectionHeading from '~/components/carinova/SectionHeading.astro';
import Solutions from '~/components/carinova/Solutions.astro';
import ShippingModes from '~/components/carinova/ShippingModes.astro';
import QuoteCalculator from '~/components/carinova/QuoteCalculator.astro';
import HowItWorks from '~/components/carinova/HowItWorks.astro';
import TrackingSection from '~/components/carinova/TrackingSection.astro';
import BusinessBand from '~/components/carinova/BusinessBand.astro';
import Locations from '~/components/carinova/Locations.astro';
import HomeFaq from '~/components/carinova/HomeFaq.astro';
import HomeClosing from '~/components/carinova/HomeClosing.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import { REVIEWS } from '~/data/carinova';
import { i18n } from '~/i18n';
import { homeSchema } from '~/utils/schema';

const page = i18n(Astro);
const { ui } = page;
const t = ui.homePage;

const hasReviews = REVIEWS.length > 0;
const metadata = { title: t.title, ignoreTitleTemplate: true, description: t.description };
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={homeSchema(page)} />

  <HomeHero />

  <ProofStrip />

  <Solutions />

  <ShippingModes />

  <section id="cotizador" class="scroll-mt-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-20 lg:py-28">
      <SectionHeading number="03" eyebrow={t.calculator.eyebrow} title={t.calculator.title} />
      <p class="mt-4 max-w-xl text-base leading-relaxed text-muted sm:text-lg">{t.calculator.intro}</p>
      <div class="mt-10">
        <QuoteCalculator place="home" headingTag="h3" />
      </div>
    </div>
  </section>

  <HowItWorks />

  <TrackingSection />

  <BusinessBand />

  <Locations />

  {
    hasReviews && (
      <Testimonials
        id="resenas"
        tagline={t.reviews.tagline}
        title={t.reviews.title}
        testimonials={REVIEWS.map((review) => ({
          testimonial: review.text,
          name: review.name,
          job: review.source ?? t.reviews.source,
          rating: review.rating,
        }))}
      />
    )
  }

  <HomeFaq />

  <HomeClosing />
</Layout>
