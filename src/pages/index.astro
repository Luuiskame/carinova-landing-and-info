---
// Inicio: the page Carinova wrote on 2026-11-18, section by section, in its order and in its words
// (docs/INFORMATION-ARCHITECTURE.md → "The home page"): the notices, the header, the opening with
// the rates, "Nuestras raíces", the four steps, Carinova Bot, Personal Shopper, the calculator,
// Carinova Business, what customers say, the questions and the closing.
//
// It keeps Carinova's look (src/assets/styles/landing.css) and is built the way the rest of the
// site is: a static page per language (like every page, it renders in Spanish at its own address
// and in each translation under its prefix), its words in the dictionaries (`ui.landing`), its
// facts in src/data. What the original did against an account simulated in the browser (sign-up,
// sign-in, tracking) is done by the site's own pages and its Worker.
//
// For speed, each part comes when it is needed: the page itself is HTML and one stylesheet written
// into it; the calculator's script, the article search with its catalogue, the dialogs and the
// directory of stores with its logos are fetched when they are used (components/landing/scripts).
import StructuredData from '~/components/common/StructuredData.astro';
import About from '~/components/landing/About.astro';
import Account from '~/components/landing/Account.astro';
import Announce from '~/components/landing/Announce.astro';
import ArticleCheck from '~/components/landing/ArticleCheck.astro';
import Business from '~/components/landing/Business.astro';
import Calculator from '~/components/landing/Calculator.astro';
import Dialogs from '~/components/landing/Dialogs.astro';
import Faq from '~/components/landing/Faq.astro';
import Footer from '~/components/landing/Footer.astro';
import Header from '~/components/landing/Header.astro';
import Hero from '~/components/landing/Hero.astro';
import Shopper from '~/components/landing/Shopper.astro';
import Sprite from '~/components/landing/Sprite.astro';
import Steps from '~/components/landing/Steps.astro';
import Testimonials from '~/components/landing/Testimonials.astro';
import Layout from '~/layouts/LandingLayout.astro';

import { i18n } from '~/i18n';
import { homeSchema } from '~/utils/schema';

const page = i18n(Astro);
const { ui } = page;

// The title and the description are the ones written for search engines (they say what people
// search for); what the page itself says is Carinova's.
const metadata = { title: ui.homePage.title, ignoreTitleTemplate: true, description: ui.homePage.description };
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={homeSchema(page)} />

  <Sprite part="first" />
  <a href="#main" class="skip-link">{ui.landing.skipContent}</a>
  <Announce />
  <Header />

  <main id="main" tabindex="-1">
    <Hero />
    <About />
    <Steps />
    <ArticleCheck />
    <Shopper />
    <Calculator />
    <Business />
    <Testimonials />
    <Faq />
  </main>

  <Footer />
  <Dialogs />
  <Account />
  <Sprite part="rest" />

  <script>
    import '~/components/landing/scripts/boot';
  </script>
</Layout>
