---
// "Casillero en Miami" (/casillero-en-miami): the page for the name people search this service by.
// The site calls it "cuenta" everywhere a customer acts (the buttons, the navigation, the account);
// here it says what a casillero is, that it comes with the account, what it costs and how it is
// used, with the facts of src/data. What an account holds in detail stays on /mi-cuenta, the steps
// on /como-comprar and the rates on /cotizador: this page summarises them and leads there.
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import ClosingCta from '~/components/carinova/ClosingCta.astro';
import CtaGroup from '~/components/carinova/CtaGroup.astro';
import ServiceBadge from '~/components/carinova/ServiceBadge.astro';

import { i18n } from '~/i18n';
import { formatUSD } from '~/utils/rates';

const { href, data, ui } = i18n(Astro);
const { ACCOUNT_PARTS, FAQ_GROUPS, PROCESS_STEPS, RATES, RECEPTION_POINTS, WA_MESSAGES } = data;
const t = ui.lockerPage;
const modes = ui.shippingModes;

const metadata = { title: t.metaTitle, description: t.description };

const rates = [
  { rate: RATES.air, label: modes.air.overline, extra: undefined },
  { rate: RATES.sea, label: modes.sea.overline, extra: modes.orPerCubicFoot(formatUSD(RATES.sea.pricePerCubicFoot)) },
];
const questions = FAQ_GROUPS.find((group) => group.id === 'cuenta')?.items ?? [];

const sectionClass = 'mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-14';
const titleClass = 'font-heading text-3xl font-extrabold tracking-[-0.03em] text-heading md:text-4xl';
const linkClass = 'inline-flex min-h-11 items-center gap-1.5 font-semibold text-link underline underline-offset-4';
---

<Layout metadata={metadata} breadcrumb={t.tagline}>
  <HeroText tagline={t.tagline} title={t.title} subtitle={t.subtitle} />
  <CtaGroup class="mx-auto max-w-3xl px-4 pb-6" />

  <section class={sectionClass}>
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div>
        <h2 class={titleClass}>{t.whatTitle}</h2>
        <div class="mt-5 space-y-4 text-lg leading-relaxed text-muted">
          {t.what.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <div>
        <h2 class="font-heading text-xl font-extrabold text-heading">{t.addressTitle}</h2>
        <ul class="mt-4 space-y-3">
          {
            RECEPTION_POINTS.map((point) => (
              <li
                class:list={[
                  'flex items-start gap-3.5 rounded-2xl p-5',
                  point.available ? 'bg-slate-50 ring-1 ring-slate-200' : 'border-2 border-dashed border-slate-300',
                ]}
              >
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[#fff0df] text-[#b65307]">
                  <Icon name="tabler:building-warehouse" class="h-6 w-6" />
                </span>
                <p>
                  <strong class="flex flex-wrap items-center gap-2 font-heading text-lg text-heading">
                    {point.city}, {point.state}
                    {!point.available && <ServiceBadge kind="soon" />}
                  </strong>
                  {point.available && <span class="mt-0.5 block text-sm text-muted">{t.addressNote}</span>}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-slate-50">
    <div class={sectionClass}>
      <h2 class={titleClass}>{t.includesTitle}</h2>
      <ul class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          ACCOUNT_PARTS.map((part) => (
            <li class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
              <Icon name={part.icon} class="h-8 w-8 text-primary" />
              <h3 class="mt-4 font-heading text-lg font-bold text-heading">{part.title}</h3>
              <p class="mt-1 text-muted">{part.summary}</p>
            </li>
          ))
        }
      </ul>
      <a class:list={[linkClass, 'mt-4']} href={href('/mi-cuenta')}>
        {t.includesLink}
        <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
      </a>
    </div>
  </section>

  <section class={sectionClass}>
    <h2 class={titleClass}>{t.costTitle}</h2>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">{t.cost}</p>
    <ul class="mt-7 grid gap-4 md:grid-cols-2">
      {
        rates.map(({ rate, label, extra }) => (
          <li class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3 rounded-2xl border border-[#dfe6f0] bg-white p-6 shadow-sm">
            <div>
              <p class="flex items-center gap-2 text-xs font-black tracking-[0.16em] text-secondary uppercase">
                <Icon name={rate.icon} class="h-5 w-5" />
                {label}
              </p>
              <p class="mt-2 font-heading text-4xl font-extrabold tracking-[-0.04em] text-navy tabular-nums">
                {formatUSD(rate.pricePerLb)}
                <span class="text-base font-semibold tracking-normal text-[#56657c]">{modes.perPound}</span>
              </p>
              {extra && <p class="mt-1 text-sm font-semibold text-[#56657c]">{extra}</p>}
            </div>
            <p class="flex items-center gap-2 text-sm text-muted">
              <Icon name="tabler:clock" class="h-5 w-5 shrink-0 text-[#b85600]" />
              <span>
                <strong class="block text-base text-heading">{rate.transit}</strong>
                {modes.delivery}
              </span>
            </p>
          </li>
        ))
      }
    </ul>
    <a class:list={[linkClass, 'mt-4']} href={href('/cotizador')}>
      {t.costLink}
      <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
    </a>
  </section>

  <section class="bg-slate-50">
    <div class={sectionClass}>
      <h2 class={titleClass}>{t.stepsTitle}</h2>
      <ol class="mt-7 grid gap-4 md:grid-cols-3">
        {
          PROCESS_STEPS.map((step, index) => (
            <li class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
              <p class="flex items-center justify-between text-sm font-black tracking-[0.12em] text-secondary">
                {String(index + 1).padStart(2, '0')}
                <Icon name={step.icon} class="h-7 w-7 text-primary" />
              </p>
              <h3 class="mt-4 font-heading text-xl font-bold text-heading">{step.title}</h3>
              <p class="mt-2 text-muted">{step.summary}</p>
            </li>
          ))
        }
      </ol>
      <a class:list={[linkClass, 'mt-4']} href={href('/como-comprar')}>
        {t.stepsLink}
        <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
      </a>
    </div>
  </section>

  <FAQs
    id="preguntas"
    title={t.faqTitle}
    items={questions}
    defaultOpen={-1}
    classes={{
      container: 'py-10 md:py-14 lg:py-14',
      headline: { container: 'max-w-3xl mb-4 md:mb-6', title: 'text-3xl md:text-4xl' },
    }}
  />

  <ClosingCta
    title={t.closing.title}
    subtitle={t.closing.subtitle}
    whatsapp={WA_MESSAGES.lockerClosing}
    whatsappLead={t.closing.lead}
  />
</Layout>
