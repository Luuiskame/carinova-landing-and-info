---
// Carinova: the footer of the prototype. The wordmark and Carinova's line, three columns of links
// ("Explorá", "Tu Carinova", "Estamos cerca"), and under them the note, the route, the other
// language and the social links.
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import { SIGNIN_DIALOG_ID } from '~/data/account';
import { i18n } from '~/i18n';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
  /** Shown only to visitors ('out') or only to customers who are signed in ('in'). */
  auth?: 'in' | 'out';
  /** "Ingresá": opens the sign-in dialog of the page, where there is one. */
  signin?: boolean;
  /** Leaves the site (WhatsApp): opens in a new tab. */
  external?: boolean;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  socialLinks: Array<Link>;
  /** Carinova's line, under the wordmark. */
  description?: string;
  /** Where from and where to: "USA ↗ NICARAGUA". */
  route?: Array<string>;
  /** The link to the same page in the other language (src/navigation.ts). */
  language?: { name: string; lang: string; href: string };
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], links = [], description, route, language, footNote = '', theme = 'light' } = Astro.props;
const { href: localized } = i18n(Astro);

const linkClass = 'text-muted transition duration-150 ease-in-out hover:text-accent hover:underline';
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative not-prose']}>
  <div class="pointer-events-none absolute inset-0 bg-[#020d22]" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-7xl px-4 text-default sm:px-6">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 py-12 md:py-16 lg:grid-cols-[1.4fr_1fr_1fr_1fr] lg:gap-x-12">
      <div class="col-span-2 lg:col-span-1">
        <a class="inline-block" href={localized('/')}><Logo class="h-10 sm:h-11" /></a>
        {description && <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">{description}</p>}
      </div>
      {
        links.map(({ title, links }) => (
          <div>
            <h2 class="text-sm font-bold tracking-wide text-heading">{title}</h2>
            <ul class="mt-4 space-y-2.5 text-sm">
              {links.map(({ text, href, ariaLabel, auth, signin, external }) => (
                <li data-auth={auth}>
                  <a
                    class={linkClass}
                    href={href}
                    aria-label={ariaLabel}
                    data-dialog-open={signin ? SIGNIN_DIALOG_ID : undefined}
                    {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- pb-24 on phones, pr-24 from md: room for the floating WhatsApp button. -->
    <div
      class="flex flex-col gap-4 border-t border-white/15 pt-6 pb-24 text-sm text-muted md:flex-row md:items-center md:justify-between md:py-8 md:pr-24"
    >
      <p class="max-w-2xl">
        {footNote}
        {
          language && (
            <>
              {' · '}
              <a class={linkClass} href={language.href} hreflang={language.lang} lang={language.lang}>
                {language.name}
              </a>
            </>
          )
        }
      </p>
      <div class="flex items-center gap-4">
        {
          socialLinks.length > 0 && (
            <ul class="-ml-2 flex">
              {socialLinks.map(({ ariaLabel, href, icon }) => (
                <li>
                  <a
                    class="inline-flex rounded-lg p-2.5 text-muted hover:bg-white/10 hover:text-white focus:ring-4 focus:ring-white/20 focus:outline-none"
                    aria-label={ariaLabel}
                    href={href}
                  >
                    {icon && <Icon name={icon} class="h-5 w-5" />}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        {
          route && (
            <p class="flex items-center gap-1.5 font-extrabold tracking-wide whitespace-nowrap text-accent uppercase">
              {route[0]}
              <Icon name="tabler:arrow-up-right" class="h-4 w-4" aria-hidden="true" />
              {route[1]}
            </p>
          )
        }
      </div>
    </div>
  </div>
</footer>
