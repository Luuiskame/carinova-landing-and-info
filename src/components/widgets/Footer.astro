---
// Carinova: the footer. From the top: Carinova's channels as a carousel (only the ones that have an
// address: src/data/carinova.ts → SOCIAL_LINKS and CONTACT), the wordmark with Carinova's line and
// the route, three columns of links to every page, and the note with the languages.
//
// The carousel is a list that scrolls sideways and snaps to each channel, so it works by touch and
// without JavaScript; the script only adds the arrows, and only while there is more than fits.
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import { SIGNIN_DIALOG_ID } from '~/data/account';
import { i18n } from '~/i18n';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
  /** Shown only to visitors ('out') or only to customers who are signed in ('in'). */
  auth?: 'in' | 'out';
  /** "Ingresá": opens the sign-in dialog of the page, where there is one. */
  signin?: boolean;
  /** Leaves the site (WhatsApp): opens in a new tab. */
  external?: boolean;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

/** One of Carinova's channels: a social network, WhatsApp, the e-mail. */
interface Channel {
  name: string;
  icon: string;
  href: string;
  /** What identifies the account: "@carinova_nic", the number, the address. */
  handle: string;
}

/** A language the page can be read in (src/navigation.ts). */
interface Language {
  name: string;
  lang: string;
  href: string;
  current: boolean;
}

export interface Props {
  links: Array<Links>;
  channels?: Array<Channel>;
  /** Carinova's line, under the wordmark. */
  description?: string;
  /** Where from and where to: "USA → NICARAGUA". */
  route?: Array<string>;
  /** The languages of the site, each leading to this page in it. */
  languages?: Array<Language>;
  footNote?: string;
  theme?: string;
}

const { channels = [], links = [], description, route, languages = [], footNote = '', theme = 'light' } = Astro.props;
const { href: localized, ui } = i18n(Astro);
const t = ui.footer;

const linkClass = 'text-muted transition duration-150 ease-in-out hover:text-accent hover:underline';
const roundButton =
  'grid h-11 w-11 place-items-center rounded-full border border-white/20 bg-white/5 text-white transition hover:border-cta hover:bg-cta hover:text-navy focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cta disabled:opacity-35 disabled:hover:border-white/20 disabled:hover:bg-white/5 disabled:hover:text-white';
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative not-prose']}>
  <div class="pointer-events-none absolute inset-0 bg-[#020d22]" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-7xl px-4 text-default sm:px-6">
    {
      channels.length > 0 && (
        <cn-channels class="block border-b border-white/10 py-9 md:py-11">
          <div class="flex items-end justify-between gap-4">
            <div>
              <p class="eyebrow">{t.channelsEyebrow}</p>
              <h2 class="mt-2 font-heading text-2xl font-extrabold tracking-[-0.03em] text-heading">
                {t.channelsTitle}
              </h2>
            </div>
            <div class="flex shrink-0 gap-2" data-cn-controls hidden>
              <button type="button" class={roundButton} aria-label={t.previous} data-cn-step="-1">
                <Icon name="tabler:arrow-left" class="h-5 w-5" />
              </button>
              <button type="button" class={roundButton} aria-label={t.next} data-cn-step="1">
                <Icon name="tabler:arrow-right" class="h-5 w-5" />
              </button>
            </div>
          </div>
          <ul
            class="mt-6 flex snap-x snap-mandatory gap-3 overflow-x-auto overscroll-x-contain rounded-2xl [scrollbar-width:none] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cta [&::-webkit-scrollbar]:hidden"
            aria-label={t.channelsTitle}
            data-cn-track
          >
            {channels.map((channel) => (
              <li class="w-[78%] shrink-0 snap-start sm:w-[calc((100%-0.75rem)/2)] lg:w-[calc((100%-2.25rem)/4)]">
                <a
                  class="group flex h-full min-h-[4.75rem] items-center gap-3.5 rounded-2xl border border-white/15 bg-white/[0.04] p-4 transition hover:border-cta/60 hover:bg-white/[0.08] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-cta"
                  href={channel.href}
                  {...(channel.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-cta/15 text-secondary transition group-hover:bg-cta group-hover:text-navy">
                    <Icon name={channel.icon} class="h-6 w-6" />
                  </span>
                  <span class="min-w-0">
                    <b class="block font-heading text-base font-extrabold text-heading">{channel.name}</b>
                    <span class="block truncate text-sm text-muted" dir="ltr">
                      {channel.handle}
                    </span>
                  </span>
                  <Icon name="tabler:arrow-up-right" class="ms-auto h-5 w-5 shrink-0 text-secondary" />
                </a>
              </li>
            ))}
          </ul>
        </cn-channels>
      )
    }

    <div class="grid grid-cols-2 gap-x-6 gap-y-10 py-12 md:py-16 lg:grid-cols-[1.4fr_1fr_1fr_1fr] lg:gap-x-12">
      <div class="col-span-2 lg:col-span-1">
        <a class="inline-block" href={localized('/')}><Logo class="h-10 sm:h-11" /></a>
        {description && <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">{description}</p>}
        {
          route && (
            <p class="mt-5 flex items-center gap-1.5 text-xs font-extrabold tracking-[0.15em] whitespace-nowrap text-accent uppercase">
              {route[0]}
              <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
              {route[1]}
            </p>
          )
        }
      </div>
      {
        links.map(({ title, links }) => (
          <div>
            <h2 class="text-sm font-bold tracking-wide text-heading">{title}</h2>
            <ul class="mt-4 space-y-2.5 text-sm">
              {links.map(({ text, href, ariaLabel, auth, signin, external }) => (
                <li data-auth={auth}>
                  <a
                    class={linkClass}
                    href={href}
                    aria-label={ariaLabel}
                    data-dialog-open={signin ? SIGNIN_DIALOG_ID : undefined}
                    {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- pb-24 on phones, pe-24 from md: room for the floating WhatsApp button. -->
    <div
      class="flex flex-col gap-5 border-t border-white/15 pt-6 pb-24 text-sm text-muted md:flex-row md:items-start md:justify-between md:py-8 md:pe-24"
    >
      <p class="max-w-xl">{footNote}</p>
      {
        languages.length > 1 && (
          <nav aria-label={t.languages}>
            <ul class="flex flex-wrap gap-x-4 gap-y-1">
              {languages.map((language) => (
                <li>
                  <a
                    class:list={[
                      'inline-flex min-h-9 items-center',
                      language.current ? 'font-bold text-heading' : linkClass,
                    ]}
                    href={language.href}
                    hreflang={language.lang}
                    lang={language.lang}
                    aria-current={language.current ? 'true' : undefined}
                    data-language-link={language.lang}
                  >
                    {language.name}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </div>
</footer>

<script>
  /** The arrows of the channels' carousel: they show only while there is more than fits. */
  class CnChannels extends HTMLElement {
    private track!: HTMLElement;
    private frame = 0;
    private observer?: ResizeObserver;

    connectedCallback() {
      const track = this.querySelector<HTMLElement>('[data-cn-track]');
      const controls = this.querySelector<HTMLElement>('[data-cn-controls]');
      if (!track || !controls) return;
      this.track = track;

      for (const button of this.querySelectorAll<HTMLButtonElement>('[data-cn-step]')) {
        button.addEventListener('click', () => this.step(Number(button.dataset.cnStep)));
      }
      const refresh = () => {
        window.cancelAnimationFrame(this.frame);
        this.frame = window.requestAnimationFrame(() => this.refresh(controls));
      };
      track.addEventListener('scroll', refresh, { passive: true });
      this.observer = new ResizeObserver(refresh);
      this.observer.observe(track);
      this.refresh(controls);
    }

    disconnectedCallback() {
      window.cancelAnimationFrame(this.frame);
      this.observer?.disconnect();
    }

    /** One channel forwards or backwards, whichever way the page is written. */
    private step(direction: number) {
      const [first, second] = Array.from(this.track.children) as Array<HTMLElement>;
      const stride = second ? Math.abs(second.offsetLeft - first.offsetLeft) : this.track.clientWidth;
      const rtl = getComputedStyle(this.track).direction === 'rtl';
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      this.track.scrollBy({ left: direction * stride * (rtl ? -1 : 1), behavior: calm ? 'auto' : 'smooth' });
    }

    private refresh(controls: HTMLElement) {
      const hidden = this.track.scrollWidth - this.track.clientWidth;
      controls.hidden = hidden <= 1;
      const at = Math.abs(this.track.scrollLeft);
      const [previous, next] = Array.from(controls.querySelectorAll<HTMLButtonElement>('[data-cn-step]'));
      if (previous) previous.disabled = at <= 1;
      if (next) next.disabled = at >= hidden - 1;
    }
  }

  if (!customElements.get('cn-channels')) customElements.define('cn-channels', CnChannels);
</script>
