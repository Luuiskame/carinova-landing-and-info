---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';

import { SIGNIN_DIALOG_ID } from '~/data/account';
import { i18n } from '~/i18n';
import { trimSlash, getAsset } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
  /** Extra classes for the item, e.g. to hide it at the widths where it does not fit. */
  class?: string;
  /** Carinova: shown only to visitors ('out') or only to customers who are signed in ('in'). */
  auth?: 'in' | 'out';
}

/** Carinova: a language the page can be read in, leading to this same page in it (src/navigation.ts). */
interface LanguageLink {
  code: string;
  name: string;
  lang: string;
  dir: string;
  href: string;
  home: string;
  current: boolean;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  /**
   * Carinova: "Ingresá", for visitors (a white button; hidden once a customer is signed in). It opens the sign-in
   * dialog of the page (SigninDialog.astro); where there is none it is a link to the sign-in page.
   */
  signin?: { text: string; href: string };
  /** Carinova: "Rastreá tu paquete", the outlined button from 1280 px. */
  track?: { text: string; href: string };
  /** Carinova: the orange button for visitors ("Crear cuenta") and for customers ("Mi cuenta"). */
  primary?: { text: string; href: string };
  account?: { text: string; href: string };
  /** Carinova: the languages of the site; the menu shows with two or more. */
  languages?: Array<LanguageLink>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  signin,
  track,
  primary,
  account,
  languages = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

// Carinova: the labels of the header's own controls, in the page's language.
const { href, ui } = i18n(Astro);
const t = ui.header;
const currentLanguage = languages.find((language) => language.current);

// Carinova: the space on each side of a link of the desktop bar. The bar is drawn for the Spanish
// labels and has no room to spare, and other languages need more of it ("Comment ça marche", "Как
// это работает"). So most of that space is not padding but an element of its own on each side of
// the link, which gives way: it keeps its width while the bar fits (with the link's own padding,
// what the padding used to be: 8 px, 10 px from 1280 px) and narrows only when the labels of a
// language would push the bar off the screen. The labels never shrink. The list and the
// navigation are allowed to be narrower than their content (`min-w-0`) so that the giving way
// happens there and not as a page that scrolls sideways.
const linkSpace = 'hidden lg:block lg:w-1.5 lg:min-w-0.5 lg:shrink xl:w-2';
/** Whether a link is in the desktop bar (the first ones are only in the phone menu). */
const inBar = (className?: string) => !className?.split(' ').includes('lg:hidden');

// Compare paths without trailing slashes so the active link is detected
// regardless of the `trailingSlash` setting (`getPermalink()` emits `/contact/`
// when it is enabled, while `currentPath` above never has one, see #557).
const isActive = (href?: string) => typeof href === 'string' && `/${trimSlash(href)}` === currentPath;

// The header is kept across view transitions (transition:persist) so its state
// survives client-side navigations. Astro matches persisted elements by name,
// so the name must change whenever the header content does: otherwise a page
// with its own menu (the demo homes, the landing pages) would keep showing the
// header of the page the visitor came from. Hash the props that shape the markup.
// (Carinova: the language menu's addresses change with every page, so only the page's language is
// part of the key; the script below keeps the addresses current while the header persists.)
const persistKey = `header-${Array.from(
  JSON.stringify({
    links,
    signin,
    track,
    primary,
    account,
    language: currentLanguage?.lang,
    isSticky,
    isDark,
    isFullWidth,
    showToggleTheme,
    showRssFeed,
    position,
  })
)
  .reduce((hash, char) => (hash * 31 + char.charCodeAt(0)) >>> 0, 7)
  .toString(36)}`;
---

<aw-header transition:persist={persistKey}>
  <header
    class:list={[
      // `bg-dark` keeps the dark header solid before scrolling too (Carinova: navy header).
      { sticky: isSticky, relative: !isSticky, dark: isDark, 'bg-dark': isDark },
      'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out',
    ]}
    {...isSticky ? { 'data-aw-sticky-header': true } : {}}
    {...id ? { id } : {}}
  >
    <div class="absolute inset-0"></div>
    <div
      class:list={[
        'relative text-default py-3 px-3 lg:px-6 mx-auto w-full',
        {
          'lg:flex lg:justify-between': position !== 'center',
        },
        {
          'lg:grid lg:grid-cols-3 lg:items-center': position === 'center',
        },
        {
          'max-w-7xl': !isFullWidth,
        },
      ]}
    >
      <div class:list={[{ 'me-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between']}>
        <a class="flex items-center" href={href('/')}>
          <Logo />
        </a>
        <div class="flex items-center gap-1 lg:hidden">
          {
            /* Carinova: on a phone the sign-in is not hidden in the menu: it is here, beside it. The menu has its own
               while it is open. */
            signin && (
              <a
                class="btn-light min-h-11 px-3.5 py-2.5 text-sm whitespace-nowrap [.expanded_&]:hidden"
                href={signin.href}
                data-auth="out"
                data-dialog-open={SIGNIN_DIALOG_ID}
              >
                <Icon name="tabler:user-circle" class="h-5 w-5 shrink-0" />
                {signin.text}
              </a>
            )
          }
          <ToggleMenu label={t.menu} />
        </div>
      </div>
      <nav
        class="items-center w-full lg:w-auto lg:min-w-0 hidden lg:flex lg:mx-1 text-default overflow-y-auto overflow-x-hidden lg:overflow-visible lg:justify-self-center"
        aria-label={t.navigation}
      >
        <ul
          class="flex flex-col lg:flex-row lg:self-center w-full lg:w-auto lg:min-w-0 text-xl lg:text-sm xl:text-[0.9375rem] 2xl:text-sm tracking-[0.01rem] font-semibold lg:justify-center"
        >
          {
            links.map(({ text, href, links, class: className, auth }) => (
              <>
                {inBar(className) && <li class={linkSpace} role="presentation" aria-hidden="true" />}
                <li class:list={[{ dropdown: links?.length }, className, 'lg:shrink-0']} data-auth={auth}>
                  {links?.length ? (
                    <>
                      <button
                        type="button"
                        class="hover:text-link dark:hover:text-white px-4 lg:px-2 xl:px-2.5 py-3 flex items-center whitespace-nowrap"
                      >
                        {text}{' '}
                        <Icon
                          name="tabler:chevron-down"
                          class="w-3.5 h-3.5 ms-0.5 rtl:ml-0 rtl:mr-0.5 hidden lg:inline"
                        />
                      </button>
                      <ul class="dropdown-menu lg:backdrop-blur-md dark:lg:bg-slate-900 dark:lg:border dark:lg:border-slate-700/50 rounded lg:absolute ps-4 lg:ps-0 lg:hidden font-medium lg:bg-white/90 lg:min-w-[200px] drop-shadow-xl">
                        {links.map(({ text: text2, href: href2 }) => (
                          <li>
                            <a
                              class:list={[
                                'first:rounded-t last:rounded-b lg:hover:bg-gray-100 hover:text-link dark:hover:text-white dark:hover:bg-gray-700 py-2 px-5 block whitespace-nowrap',
                                { 'aw-link-active': isActive(href2) },
                              ]}
                              href={href2}
                            >
                              {text2}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </>
                  ) : (
                    <a
                      class:list={[
                        'hover:text-link dark:hover:text-white px-4 lg:px-0.5 py-3 flex items-center whitespace-nowrap',
                        { 'aw-link-active': isActive(href) },
                      ]}
                      href={href}
                    >
                      {text}
                    </a>
                  )}
                </li>
                {inBar(className) && <li class={linkSpace} role="presentation" aria-hidden="true" />}
              </>
            ))
          }
        </ul>
      </nav>
      <div
        class:list={[
          { 'ms-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
          'hidden lg:self-center lg:flex items-center lg:mb-0 fixed w-full lg:w-auto lg:static justify-end start-0 rtl:left-auto rtl:right-0 bottom-0 p-3 lg:p-0 lg:justify-self-end',
        ]}
      >
        <div class="items-center flex justify-between w-full lg:w-auto">
          <div class="flex items-center">
            {
              /* Carinova: the language menu. Its button shows the language of the page ("ES"); the list names
                 every language in its own words, each leading to this same page in it. A native <details>:
                 it opens without JavaScript; the script closes it on a click outside, on Esc and on leaving
                 the page. It opens downwards in the desktop bar and upwards in the phone menu's bottom bar. */
              currentLanguage && languages.length > 1 && (
                <details class="group/language relative" data-language-menu>
                  <summary
                    class="inline-flex min-h-11 cursor-pointer list-none items-center gap-1 rounded-lg px-2 text-base font-semibold text-default hover:text-link focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cta lg:text-sm xl:text-[0.9375rem] 2xl:text-sm dark:hover:text-white [&::-webkit-details-marker]:hidden"
                    aria-label={`${ui.nav.language}: ${currentLanguage.name}`}
                  >
                    <Icon name="tabler:world" class="h-5 w-5 lg:hidden xl:block" />
                    <span aria-hidden="true">{currentLanguage.code}</span>
                    <Icon
                      name="tabler:chevron-down"
                      class="h-3.5 w-3.5 transition group-open/language:rotate-180 motion-reduce:transition-none"
                    />
                  </summary>
                  <ul
                    class="absolute start-0 bottom-full z-50 mb-2 w-52 rounded-xl border border-white/15 bg-[#0b2247] p-1.5 shadow-[0_1.5rem_3rem_rgb(0_0_0/0.45)] lg:start-auto lg:end-0 lg:top-full lg:bottom-auto lg:mt-2 lg:mb-0"
                    aria-label={ui.nav.languageChoose}
                  >
                    {languages.map((language) => (
                      <li>
                        <a
                          class="flex min-h-11 items-center justify-between gap-3 rounded-lg px-3 text-[0.9375rem] font-semibold text-white transition hover:bg-white/10 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-cta aria-[current=true]:bg-white/10 aria-[current=true]:text-secondary"
                          href={language.href}
                          hreflang={language.lang}
                          lang={language.lang}
                          aria-current={language.current ? 'true' : undefined}
                          data-language-link={language.lang}
                          data-home={language.home}
                        >
                          <span dir={language.dir}>{language.name}</span>
                          {language.current ? (
                            <Icon name="tabler:check" class="h-4 w-4 shrink-0" />
                          ) : (
                            <span class="text-xs tracking-wide text-[#9fb0c6]" aria-hidden="true">
                              {language.code}
                            </span>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              )
            }
            {
              /* Carinova: sign-in, for visitors: a white button, the most visible thing in the bar. It opens the
                 dialog; the same button sits beside the menu button on a phone (above). */
              signin && (
                <a
                  class="btn-light min-h-11 px-3.5 py-2.5 text-sm whitespace-nowrap"
                  href={signin.href}
                  data-auth="out"
                  data-dialog-open={SIGNIN_DIALOG_ID}
                >
                  <Icon name="tabler:user-circle" class="h-5 w-5 shrink-0" />
                  {signin.text}
                </a>
              )
            }
            {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 lg:w-5 lg:h-5 lg:inline-block" />}
            {
              showRssFeed && (
                <a
                  class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label="RSS Feed"
                  href={getAsset('/rss.xml')}
                >
                  <Icon name="tabler:rss" class="w-5 h-5" />
                </a>
              )
            }
          </div>
          <span class="ms-3 flex items-center gap-2 lg:ms-1 xl:ms-2">
            {
              /* Carinova: the buttons. Each one is in the page for visitors and for customers (data-auth). */
              track && (
                <a class="btn hidden min-h-11 px-3 py-2.5 text-sm whitespace-nowrap xl:inline-flex" href={track.href}>
                  {track.text}
                </a>
              )
            }
            {
              primary && (
                <a
                  class="btn-primary min-h-11 px-4 py-2.5 text-sm whitespace-nowrap"
                  href={primary.href}
                  data-auth="out"
                >
                  {primary.text}
                </a>
              )
            }
            {
              account && (
                <a
                  class="btn-primary min-h-11 px-4 py-2.5 text-sm whitespace-nowrap"
                  href={account.href}
                  data-auth="in"
                >
                  {account.text}
                </a>
              )
            }
          </span>
        </div>
      </div>
    </div>
  </header>
</aw-header>

<style>
  aw-header {
    display: contents;
  }
</style>

<script>
  class AwHeader extends HTMLElement {
    private onScroll?: () => void;
    private mql?: MediaQueryList;
    private onMqlChange?: () => void;
    private onPageLoad = () => {
      this.updateActiveLinks();
      this.updateLanguageLinks();
      this.closeOpenDropdown();
      this.closeLanguageMenu();
    };
    private onDocumentClick = (event: MouseEvent) => {
      const menu = this.querySelector<HTMLDetailsElement>('[data-language-menu]');
      if (menu?.open && !menu.contains(event.target as Node)) menu.open = false;
    };
    private onDocumentKey = (event: KeyboardEvent) => {
      const menu = this.querySelector<HTMLDetailsElement>('[data-language-menu]');
      if (event.key !== 'Escape' || !menu?.open) return;
      menu.open = false;
      menu.querySelector('summary')?.focus();
    };

    connectedCallback() {
      const header = this.querySelector<HTMLElement>('#header');
      const toggle = this.querySelector<HTMLElement>('[data-aw-toggle-menu]');
      const nav = this.querySelector<HTMLElement>('#header nav');
      const lastChild = this.querySelector<HTMLElement>('#header > div > div:last-child');

      // The header persists across view transitions (transition:persist), so
      // the server-rendered `aw-link-active` class would go stale. Re-compute it
      // on every navigation (astro:page-load fires on load and after each swap).
      this.updateActiveLinks();
      this.updateLanguageLinks();
      document.addEventListener('astro:page-load', this.onPageLoad);
      // Carinova: the language menu closes with a click anywhere else and with Esc.
      document.addEventListener('click', this.onDocumentClick);
      document.addEventListener('keydown', this.onDocumentKey);

      const closeMenu = () => {
        toggle?.classList.remove('expanded');
        toggle?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('overflow-hidden');
        header?.classList.remove('h-screen', 'expanded', 'bg-page');
        nav?.classList.add('hidden');
        lastChild?.classList.add('hidden');
        this.closeLanguageMenu();
      };

      // Mobile menu toggle.
      toggle?.addEventListener('click', () => {
        const expanded = toggle.classList.toggle('expanded');
        toggle.setAttribute('aria-expanded', String(expanded));
        document.body.classList.toggle('overflow-hidden');
        header?.classList.toggle('h-screen');
        header?.classList.toggle('expanded');
        header?.classList.toggle('bg-page');
        nav?.classList.toggle('hidden');
        lastChild?.classList.toggle('hidden');
      });

      // Close the mobile menu when a nav link is clicked.
      nav?.addEventListener('click', closeMenu);

      // Desktop dropdowns open on hover/`:focus-within`. When a dropdown link is
      // clicked it keeps focus, and because the header uses `transition:persist`
      // the dropdown would stay open after the client-side navigation. Blur the
      // link on click so it closes right away (the `astro:page-load` handler is
      // the safety net if focus is restored during the swap).
      nav?.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement)?.closest<HTMLElement>('.dropdown-menu a');
        if (link) link.blur();
      });

      // Close it when leaving the mobile/tablet breakpoint (desktop nav starts at `lg`).
      this.mql = window.matchMedia('(max-width: 1023px)');
      this.onMqlChange = () => closeMenu();
      this.mql.addEventListener('change', this.onMqlChange);

      // Sticky header: toggle the `scroll` class past a small threshold.
      if (header?.hasAttribute('data-aw-sticky-header')) {
        let ticking = false;
        const applyStyles = () => {
          if (window.scrollY > 60) header.classList.add('scroll');
          else header.classList.remove('scroll');
          ticking = false;
        };
        this.onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(applyStyles);
            ticking = true;
          }
        };
        applyStyles();
        document.addEventListener('scroll', this.onScroll, { passive: true });
      }

      document.documentElement.classList.add('motion-safe:scroll-smooth');
    }

    disconnectedCallback() {
      if (this.onScroll) document.removeEventListener('scroll', this.onScroll);
      if (this.mql && this.onMqlChange) this.mql.removeEventListener('change', this.onMqlChange);
      document.removeEventListener('astro:page-load', this.onPageLoad);
      document.removeEventListener('click', this.onDocumentClick);
      document.removeEventListener('keydown', this.onDocumentKey);
    }

    private closeLanguageMenu() {
      const menu = this.querySelector<HTMLDetailsElement>('[data-language-menu]');
      if (menu) menu.open = false;
    }

    // With `transition:persist` the header (and its focus) survives client-side
    // navigations, so a clicked dropdown link keeps `:focus-within` and its menu
    // would stay open on the next page. Drop the focus so the CSS closes it.
    private closeOpenDropdown() {
      const active = document.activeElement as HTMLElement | null;
      if (active && this.contains(active) && active.closest('.dropdown')) active.blur();
    }

    // Carinova: each entry of the language menu leads to this page in that language, and the header
    // persists from page to page. Each page names its translations in the <head> (hreflang); a page
    // without them (404) sends to each language's home page. What the address carries (a filled-in
    // calculator, a confirmation token, an anchor) goes along. The footer's list is kept the same way.
    private updateLanguageLinks() {
      for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-language-link]')) {
        const alternate = document.head.querySelector<HTMLLinkElement>(
          `link[rel="alternate"][hreflang="${link.dataset.languageLink}"]`
        );
        link.href = alternate
          ? new URL(alternate.href).pathname + window.location.search + window.location.hash
          : (link.dataset.home ?? link.getAttribute('href') ?? '/');
      }
    }

    private updateActiveLinks() {
      const norm = (p: string) => '/' + p.replace(/^\/+|\/+$/g, '');
      const current = norm(window.location.pathname);
      this.querySelectorAll<HTMLAnchorElement>('nav a[href]').forEach((a) => {
        const url = new URL(a.href, window.location.href);
        // Anchor-only links (`#`, `/#features`) resolve to the current page and
        // would light up everywhere; only path links can be "the current page".
        const isPathLink =
          url.origin === window.location.origin && !url.hash && !a.getAttribute('href')?.startsWith('#');
        a.classList.toggle('aw-link-active', isPathLink && norm(url.pathname) === current);
      });
    }
  }

  if (!customElements.get('aw-header')) {
    customElements.define('aw-header', AwHeader);
  }
</script>
