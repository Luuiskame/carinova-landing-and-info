---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';

import { SIGNIN_DIALOG_ID } from '~/data/account';
import { i18n } from '~/i18n';
import { trimSlash, getAsset } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
  /** Extra classes for the item, e.g. to hide it at the widths where it does not fit. */
  class?: string;
  /** Carinova: shown only to visitors ('out') or only to customers who are signed in ('in'). */
  auth?: 'in' | 'out';
}

/** Carinova: the link to the same page in the other language (src/navigation.ts). */
interface LanguageLink {
  code: string;
  name: string;
  lang: string;
  href: string;
  home: string;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  /**
   * Carinova: "Ingresá", for visitors (a white button; hidden once a customer is signed in). It opens the sign-in
   * dialog of the page (SigninDialog.astro); where there is none it is a link to the sign-in page.
   */
  signin?: { text: string; href: string };
  /** Carinova: "Rastreá tu paquete", the outlined button from 1280 px: a visitor's and a customer's destination. */
  track?: { text: string; href: string; accountHref: string };
  /** Carinova: the orange button for visitors ("Crear cuenta") and for customers ("Mi cuenta"). */
  primary?: { text: string; href: string };
  account?: { text: string; href: string };
  language?: LanguageLink;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  signin,
  track,
  primary,
  account,
  language,
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

// Carinova: the labels of the header's own controls, in the page's language.
const { locale, href } = i18n(Astro);
const t = {
  es: { navigation: 'Navegación principal', menu: 'Menú' },
  en: { navigation: 'Main navigation', menu: 'Menu' },
}[locale];

// Compare paths without trailing slashes so the active link is detected
// regardless of the `trailingSlash` setting (`getPermalink()` emits `/contact/`
// when it is enabled, while `currentPath` above never has one, see #557).
const isActive = (href?: string) => typeof href === 'string' && `/${trimSlash(href)}` === currentPath;

// The header is kept across view transitions (transition:persist) so its state
// survives client-side navigations. Astro matches persisted elements by name,
// so the name must change whenever the header content does: otherwise a page
// with its own menu (the demo homes, the landing pages) would keep showing the
// header of the page the visitor came from. Hash the props that shape the markup.
// (Carinova: the language link's address changes with every page, so only its language is part of the
// key; the script below keeps the address current while the header persists.)
const persistKey = `header-${Array.from(
  JSON.stringify({
    links,
    signin,
    track,
    primary,
    account,
    language: language?.lang,
    isSticky,
    isDark,
    isFullWidth,
    showToggleTheme,
    showRssFeed,
    position,
  })
)
  .reduce((hash, char) => (hash * 31 + char.charCodeAt(0)) >>> 0, 7)
  .toString(36)}`;
---

<aw-header transition:persist={persistKey}>
  <header
    class:list={[
      // `bg-dark` keeps the dark header solid before scrolling too (Carinova: navy header).
      { sticky: isSticky, relative: !isSticky, dark: isDark, 'bg-dark': isDark },
      'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out',
    ]}
    {...isSticky ? { 'data-aw-sticky-header': true } : {}}
    {...id ? { id } : {}}
  >
    <div class="absolute inset-0"></div>
    <div
      class:list={[
        'relative text-default py-3 px-3 lg:px-6 mx-auto w-full',
        {
          'lg:flex lg:justify-between': position !== 'center',
        },
        {
          'lg:grid lg:grid-cols-3 lg:items-center': position === 'center',
        },
        {
          'max-w-7xl': !isFullWidth,
        },
      ]}
    >
      <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between']}>
        <a class="flex items-center" href={href('/')}>
          <Logo />
        </a>
        <div class="flex items-center gap-1 lg:hidden">
          {
            /* Carinova: on a phone the sign-in is not hidden in the menu: it is here, beside it. The menu has its own
               while it is open. */
            signin && (
              <a
                class="btn-light min-h-11 px-3.5 py-2.5 text-sm whitespace-nowrap [.expanded_&]:hidden"
                href={signin.href}
                data-auth="out"
                data-dialog-open={SIGNIN_DIALOG_ID}
              >
                <Icon name="tabler:user-circle" class="h-5 w-5 shrink-0" />
                {signin.text}
              </a>
            )
          }
          <ToggleMenu label={t.menu} />
        </div>
      </div>
      <nav
        class="items-center w-full lg:w-auto hidden lg:flex lg:mx-1 text-default overflow-y-auto overflow-x-hidden lg:overflow-visible lg:justify-self-center"
        aria-label={t.navigation}
      >
        <ul
          class="flex flex-col lg:flex-row lg:self-center w-full lg:w-auto text-xl lg:text-sm xl:text-[0.9375rem] 2xl:text-sm tracking-[0.01rem] font-semibold lg:justify-center"
        >
          {
            links.map(({ text, href, links, class: className, auth }) => (
              <li class:list={[{ dropdown: links?.length }, className]} data-auth={auth}>
                {links?.length ? (
                  <>
                    <button
                      type="button"
                      class="hover:text-link dark:hover:text-white px-4 lg:px-2 xl:px-2.5 py-3 flex items-center whitespace-nowrap"
                    >
                      {text}{' '}
                      <Icon
                        name="tabler:chevron-down"
                        class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden lg:inline"
                      />
                    </button>
                    <ul class="dropdown-menu lg:backdrop-blur-md dark:lg:bg-slate-900 dark:lg:border dark:lg:border-slate-700/50 rounded lg:absolute pl-4 lg:pl-0 lg:hidden font-medium lg:bg-white/90 lg:min-w-[200px] drop-shadow-xl">
                      {links.map(({ text: text2, href: href2 }) => (
                        <li>
                          <a
                            class:list={[
                              'first:rounded-t last:rounded-b lg:hover:bg-gray-100 hover:text-link dark:hover:text-white dark:hover:bg-gray-700 py-2 px-5 block whitespace-nowrap',
                              { 'aw-link-active': isActive(href2) },
                            ]}
                            href={href2}
                          >
                            {text2}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <a
                    class:list={[
                      'hover:text-link dark:hover:text-white px-4 lg:px-2 xl:px-2.5 py-3 flex items-center whitespace-nowrap',
                      { 'aw-link-active': isActive(href) },
                    ]}
                    href={href}
                  >
                    {text}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
      <div
        class:list={[
          { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
          'hidden lg:self-center lg:flex items-center lg:mb-0 fixed w-full lg:w-auto lg:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 lg:p-0 lg:justify-self-end',
        ]}
      >
        <div class="items-center flex justify-between w-full lg:w-auto">
          <div class="flex items-center">
            {
              /* Carinova: the other language of this page. "EN" is what shows; its name is what is read. */
              language && (
                <a
                  class="inline-flex min-h-11 items-center gap-1 rounded-lg px-2 text-base lg:text-sm xl:text-[0.9375rem] 2xl:text-sm font-semibold text-default hover:text-link dark:hover:text-white"
                  href={language.href}
                  hreflang={language.lang}
                  lang={language.lang}
                  aria-label={language.name}
                  data-language-switch={language.lang}
                  data-home={language.home}
                >
                  <Icon name="tabler:world" class="h-5 w-5 lg:hidden xl:block" />
                  <span aria-hidden="true">{language.code}</span>
                </a>
              )
            }
            {
              /* Carinova: sign-in, for visitors: a white button, the most visible thing in the bar. It opens the
                 dialog; the same button sits beside the menu button on a phone (above). */
              signin && (
                <a
                  class="btn-light min-h-11 px-3.5 py-2.5 text-sm whitespace-nowrap"
                  href={signin.href}
                  data-auth="out"
                  data-dialog-open={SIGNIN_DIALOG_ID}
                >
                  <Icon name="tabler:user-circle" class="h-5 w-5 shrink-0" />
                  {signin.text}
                </a>
              )
            }
            {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 lg:w-5 lg:h-5 lg:inline-block" />}
            {
              showRssFeed && (
                <a
                  class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label="RSS Feed"
                  href={getAsset('/rss.xml')}
                >
                  <Icon name="tabler:rss" class="w-5 h-5" />
                </a>
              )
            }
          </div>
          <span class="ml-3 flex items-center gap-2 lg:ml-1 xl:ml-2">
            {
              /* Carinova: the buttons. Each one is in the page for visitors and for customers (data-auth). */
              track && (
                <>
                  <a
                    class="btn hidden min-h-11 px-3 py-2.5 text-sm whitespace-nowrap xl:inline-flex"
                    href={track.href}
                    data-auth="out"
                  >
                    {track.text}
                  </a>
                  <a
                    class="btn hidden min-h-11 px-3 py-2.5 text-sm whitespace-nowrap xl:inline-flex"
                    href={track.accountHref}
                    data-auth="in"
                  >
                    {track.text}
                  </a>
                </>
              )
            }
            {
              primary && (
                <a
                  class="btn-primary min-h-11 px-4 py-2.5 text-sm whitespace-nowrap"
                  href={primary.href}
                  data-auth="out"
                >
                  {primary.text}
                </a>
              )
            }
            {
              account && (
                <a
                  class="btn-primary min-h-11 px-4 py-2.5 text-sm whitespace-nowrap"
                  href={account.href}
                  data-auth="in"
                >
                  {account.text}
                </a>
              )
            }
          </span>
        </div>
      </div>
    </div>
  </header>
</aw-header>

<style>
  aw-header {
    display: contents;
  }
</style>

<script>
  class AwHeader extends HTMLElement {
    private onScroll?: () => void;
    private mql?: MediaQueryList;
    private onMqlChange?: () => void;
    private onPageLoad = () => {
      this.updateActiveLinks();
      this.updateLanguageLink();
      this.closeOpenDropdown();
    };

    connectedCallback() {
      const header = this.querySelector<HTMLElement>('#header');
      const toggle = this.querySelector<HTMLElement>('[data-aw-toggle-menu]');
      const nav = this.querySelector<HTMLElement>('#header nav');
      const lastChild = this.querySelector<HTMLElement>('#header > div > div:last-child');

      // The header persists across view transitions (transition:persist), so
      // the server-rendered `aw-link-active` class would go stale. Re-compute it
      // on every navigation (astro:page-load fires on load and after each swap).
      this.updateActiveLinks();
      this.updateLanguageLink();
      document.addEventListener('astro:page-load', this.onPageLoad);

      const closeMenu = () => {
        toggle?.classList.remove('expanded');
        toggle?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('overflow-hidden');
        header?.classList.remove('h-screen', 'expanded', 'bg-page');
        nav?.classList.add('hidden');
        lastChild?.classList.add('hidden');
      };

      // Mobile menu toggle.
      toggle?.addEventListener('click', () => {
        const expanded = toggle.classList.toggle('expanded');
        toggle.setAttribute('aria-expanded', String(expanded));
        document.body.classList.toggle('overflow-hidden');
        header?.classList.toggle('h-screen');
        header?.classList.toggle('expanded');
        header?.classList.toggle('bg-page');
        nav?.classList.toggle('hidden');
        lastChild?.classList.toggle('hidden');
      });

      // Close the mobile menu when a nav link is clicked.
      nav?.addEventListener('click', closeMenu);

      // Desktop dropdowns open on hover/`:focus-within`. When a dropdown link is
      // clicked it keeps focus, and because the header uses `transition:persist`
      // the dropdown would stay open after the client-side navigation. Blur the
      // link on click so it closes right away (the `astro:page-load` handler is
      // the safety net if focus is restored during the swap).
      nav?.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement)?.closest<HTMLElement>('.dropdown-menu a');
        if (link) link.blur();
      });

      // Close it when leaving the mobile/tablet breakpoint (desktop nav starts at `lg`).
      this.mql = window.matchMedia('(max-width: 1023px)');
      this.onMqlChange = () => closeMenu();
      this.mql.addEventListener('change', this.onMqlChange);

      // Sticky header: toggle the `scroll` class past a small threshold.
      if (header?.hasAttribute('data-aw-sticky-header')) {
        let ticking = false;
        const applyStyles = () => {
          if (window.scrollY > 60) header.classList.add('scroll');
          else header.classList.remove('scroll');
          ticking = false;
        };
        this.onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(applyStyles);
            ticking = true;
          }
        };
        applyStyles();
        document.addEventListener('scroll', this.onScroll, { passive: true });
      }

      document.documentElement.classList.add('motion-safe:scroll-smooth');
    }

    disconnectedCallback() {
      if (this.onScroll) document.removeEventListener('scroll', this.onScroll);
      if (this.mql && this.onMqlChange) this.mql.removeEventListener('change', this.onMqlChange);
      document.removeEventListener('astro:page-load', this.onPageLoad);
    }

    // With `transition:persist` the header (and its focus) survives client-side
    // navigations, so a clicked dropdown link keeps `:focus-within` and its menu
    // would stay open on the next page. Drop the focus so the CSS closes it.
    private closeOpenDropdown() {
      const active = document.activeElement as HTMLElement | null;
      if (active && this.contains(active) && active.closest('.dropdown')) active.blur();
    }

    // Carinova: the language link leads to this page in the other language, and the header persists
    // from page to page. Each page names its translation in the <head> (hreflang); a page without one
    // (404) sends to the other language's home page. What the address carries (a filled-in calculator,
    // a confirmation token, an anchor) goes along.
    private updateLanguageLink() {
      const link = this.querySelector<HTMLAnchorElement>('[data-language-switch]');
      if (!link) return;
      const alternate = document.head.querySelector<HTMLLinkElement>(
        `link[rel="alternate"][hreflang="${link.dataset.languageSwitch}"]`
      );
      link.href = alternate
        ? new URL(alternate.href).pathname + window.location.search + window.location.hash
        : (link.dataset.home ?? '/');
    }

    private updateActiveLinks() {
      const norm = (p: string) => '/' + p.replace(/^\/+|\/+$/g, '');
      const current = norm(window.location.pathname);
      this.querySelectorAll<HTMLAnchorElement>('nav a[href]').forEach((a) => {
        const url = new URL(a.href, window.location.href);
        // Anchor-only links (`#`, `/#features`) resolve to the current page and
        // would light up everywhere; only path links can be "the current page".
        const isPathLink =
          url.origin === window.location.origin && !url.hash && !a.getAttribute('href')?.startsWith('#');
        a.classList.toggle('aw-link-active', isPathLink && norm(url.pathname) === current);
      });
    }
  }

  if (!customElements.get('aw-header')) {
    customElements.define('aw-header', AwHeader);
  }
</script>
