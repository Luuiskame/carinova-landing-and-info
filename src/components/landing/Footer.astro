---
// The end of the home page, as Carinova drew it: the closing call, the links to the sections, the
// branches with their hours, how to reach Carinova, and the floating WhatsApp button.
//
// - "Crear cuenta personal" and "Crear cuenta empresarial" open the account's dialog on that kind of
//   account (scripts/account.ts); without the script they lead to /registro and to /empresas.
// - The branches are the ones of Carinova's page ("Miami · Los Ángeles", "Managua · Bluefields") and
//   their hours the ones of src/data, written as that page writes them (helpers.ts → hoursRange).
// - Contact is one line, as in Carinova's page: the e-mail once CONTACT has one and, until then, the
//   WhatsApp number (the address the page came with, info@carinova.com, is on a domain that is not
//   Carinova's: docs/PROJECT-LOG.md → D-116). Under it, the networks of SOCIAL_LINKS that have an icon.
// - The company's legal name and RUC show once COMPANY has them.
// - "Privacidad" opens Carinova's note on privacy, which leads to the site's policy; "Condiciones del
//   servicio" opens Carinova's summary (Dialogs.astro). Without the script: the policy and the terms.
// - The WhatsApp button carries the message of the page it is on (WA_MESSAGES.floating).
//
// The same footer ends the page about Carinova (`inner`, D-137), without the closing call (that
// page has its own): the sections it names are the home page's, and what opens a dialog on the
// home page is a plain link to its page there. Its look comes with it (LandingChrome.astro).
import { COMPANY, CONTACT, SOCIAL_LINKS } from '~/data/carinova';
import { i18n, spanishPath } from '~/i18n';
import { whatsappLink } from '~/utils/whatsapp';

import { SOCIAL_ICONS, hoursRange } from './helpers';
import Icon from './Icon.astro';

export interface Props {
  /** On another page of the site than the home page (D-137). */
  inner?: boolean;
}

const { inner = false } = Astro.props;
const { locale, href, data, ui } = i18n(Astro);
const { BRANCHES, CTA, RECEPTION_HOURS, RECEPTION_POINTS, WA_MESSAGES } = data;
const t = ui.landing;

/** The branches open at the same times: their hours are said once (the first one's). */
const [branchHours] = BRANCHES[0].hours;

/** A section of the home page: from this page, or from another page of the site. */
const section = (id: string) => (inner ? href(`/#${id}`) : `#${id}`);
/** What opens a view of the home page's dialog there; elsewhere the link leads to its page. */
const dialog = (view: string) => (inner ? undefined : view);
const services = [
  { text: t.footerQuote, href: section('cotizador') },
  { text: t.trackCta, href: href(CTA.track.path), dialog: dialog('tracking') },
  { text: t.shopperName, href: section('personal-shopper') },
  { text: t.businessName, href: section('business') },
];
const help = [
  { text: t.navHow, href: section('como-funciona') },
  { text: t.navCheck, href: section('restricciones') },
  { text: t.faqTitle, href: section('preguntas') },
  // Two pages of their own: who Carinova is (with "Nuestras raíces", once a section of this page) and what its customers say.
  { text: t.footerAbout, href: href('/nosotros') },
  { text: ui.nav.reviews, href: href('/opiniones') },
];
const networks = SOCIAL_LINKS.filter((link) => SOCIAL_ICONS[link.name]);
const hasCompany = Boolean(COMPANY.legalName || COMPANY.ruc);
const year = new Date().getFullYear();
// The messages are kept by the page's Spanish path, whatever language it is read in.
const floating = WA_MESSAGES.floating[spanishPath(Astro.url.pathname)] ?? WA_MESSAGES.floatingDefault;
---

<footer class="site-footer on-navy">
  {
    !inner && (
      <div class="footer-cta hero-section">
        <div class="wrap final">
          <div class="final-head">
            <h2 class="final-title" id="final-title">
              {t.finalHeading}
            </h2>
            <p class="final-lead">{t.finalLead}</p>
          </div>
          <div class="final-actions hero-cta">
            <a class="btn btn-primary" href={href(CTA.signup.path)} data-dialog="account" data-account-kind="personal">
              <Icon name="user" />
              <span>{t.finalCtaPersonal}</span>
            </a>
            <a class="btn btn-ghost" href={href('/empresas')} data-dialog="account" data-account-kind="business">
              <Icon name="briefcase" />
              <span>{t.finalCtaBusiness}</span>
            </a>
          </div>
        </div>
      </div>
    )
  }
  <div class="footer-body">
    <div class="wrap footer-main">
      <nav class="footer-col" aria-labelledby="footer-services">
        <h2 id="footer-services">{t.footerServices}</h2>
        <ul>
          {
            services.map((link) => (
              <li>
                <a href={link.href} data-dialog={link.dialog}>
                  {link.text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav class="footer-col" aria-labelledby="footer-help">
        <h2 id="footer-help">{t.footerHelp}</h2>
        <ul>
          {
            help.map((link) => (
              <li>
                <a href={link.href}>{link.text}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      {/* Where the home page's menu leads for "Sucursales". Elsewhere the page may have a section of that name. */}
      <section class="footer-col footer-branches" id={inner ? undefined : 'sucursales'} aria-labelledby="footer-places">
        <h2 id="footer-places">{t.navLocations}</h2>
        <div class="footer-places">
          <div>
            <p class="footer-city">{RECEPTION_POINTS.map((point) => point.city).join(' · ')}</p>
            <p class="footer-hours">
              <span>{RECEPTION_HOURS.days}</span>
              {
                /* No `dir` here: in Arabic the hours carry Arabic letters ("8:00 ص – 5:00 م") and read from the right like the rest of the line. */
              }
              <span>{hoursRange(locale, RECEPTION_HOURS)}</span>
            </p>
          </div>
          <div>
            <p class="footer-city">{BRANCHES.map((branch) => branch.city).join(' · ')}</p>
            <p class="footer-hours">
              <span>{branchHours.days}</span>
              <span>{hoursRange(locale, branchHours)}</span>
            </p>
          </div>
        </div>
      </section>
      <section class="footer-col footer-contact" aria-labelledby="footer-contact">
        <h2 id="footer-contact">{t.footerContactTitle}</h2>
        {
          CONTACT.email ? (
            <a class="footer-email" href={`mailto:${CONTACT.email}`}>
              <span dir="ltr">{CONTACT.email}</span>
            </a>
          ) : (
            <a
              class="footer-email"
              href={whatsappLink(CONTACT.whatsapp, WA_MESSAGES.footer)}
              target="_blank"
              rel="noopener"
            >
              <span dir="ltr">{CONTACT.whatsappDisplay}</span>
            </a>
          )
        }
        {
          networks.length > 0 && (
            <ul class="socials">
              {networks.map((link) => (
                <li>
                  <a class="social" href={link.href} target="_blank" rel="noopener" aria-label={link.name}>
                    <svg aria-hidden="true">
                      <use href={`#${SOCIAL_ICONS[link.name]}`} />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </div>
    {
      hasCompany && (
        <section class="wrap footer-company" aria-labelledby="footer-company-title">
          <div>
            <h2 id="footer-company-title">{t.footerCorporateInfo}</h2>
            <p>{t.footerEntityType}</p>
          </div>
          <dl>
            <div>
              <dt>{t.footerLegalName}</dt>
              <dd>{COMPANY.legalName || '—'}</dd>
            </div>
            <div>
              <dt>{t.footerRuc}</dt>
              <dd dir="ltr">{COMPANY.ruc || '—'}</dd>
            </div>
          </dl>
        </section>
      )
    }
    <div class="wrap footer-bottom">
      <p class="footer-copy">© <span id="year">{year}</span> Carinova. <span>{t.allRights}</span></p>
      <div class="footer-legal">
        <a href={href('/privacidad')} data-dialog={dialog('privacy')}>{t.footerPrivacy}</a>
        <a href={href('/terminos')} data-dialog={dialog('conditions')}>{t.serviceConditions}</a>
      </div>
    </div>
  </div>
  <a
    class="wa-fab"
    href={whatsappLink(CONTACT.whatsapp, floating)}
    target="_blank"
    rel="noopener"
    aria-label={t.whatsappAria}><Icon name="chat" /></a
  >
  {/* A short notice that goes away by itself ("Sesión cerrada."): written by scripts/dialogs.ts. */}
  {!inner && <div class="toast" id="toast" role="status" aria-live="polite" hidden />}
</footer>
