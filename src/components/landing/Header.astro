---
// The header of the home page, as Carinova drew it: the wordmark, three sections of the page, the
// language, the account and a menu with the rest.
//
// "Crear cuenta" and the account's icon open the account in the page's dialog (scripts/account.ts):
// a visitor creates one or signs in, a customer gets "Mi cuenta", and a dot on the icon says a
// session is open (data-auth: SessionState.astro). Each is a link (to /registro, to /mi-cuenta),
// which is where it leads without the script. The languages are links too: each one is this page at
// the address of that language, in the order of Carinova's menu; the script keeps the visitor's
// place and remembers the choice (scripts/boot.ts).
//
// The language button and its menu are drawn the same way in every language, from left to right:
// the flag, then the name or the code. A row does not turn around for a language written from right
// to left, nor does the menu on the Arabic page; only the name of a language is written in its own
// direction (D-135). Whoever cannot read the page they landed on finds the same menu there.
//
// The same header is the header of every other page of the site (`inner`, D-137, D-139): the
// wordmark leads to the home page, and each section to the page that owns it (SECTION_PAGES), so
// that from any page the others are a link away; the account and "Crear cuenta" are links to their
// pages (no other page has the home page's dialogs), and a link to the page in view says so. There
// a customer who is signed in finds "Mi cuenta" where a visitor finds "Crear cuenta" (data-auth),
// as everywhere on the site; on the home page the button opens the dialog, which gives a customer
// their account. Its look comes with it (LandingChrome.astro); its script is scripts/chrome.ts.
import wordmarkSvg from '~/assets/images/landing/wordmark.svg?raw';
import { LANGUAGE_ORDER, SECTION_PAGES } from '~/data/landing';
import { LOCALE_INFO, i18n, languagesOf, spanishPath } from '~/i18n';
import { getPermalink } from '~/utils/permalinks';

import { FLAGS } from './helpers';
import Icon from './Icon.astro';

export interface Props {
  /** On another page of the site than the home page (D-137, D-139). */
  inner?: boolean;
}

const { inner = false } = Astro.props;
const { locale, href, data, ui } = i18n(Astro);
const { CTA } = data;
const t = ui.landing;

// In the order of the menu of Carinova's page (Español, English, Português, Français, 中文), then the two the site adds.
const languages = [...languagesOf(Astro.url.pathname)].sort(
  (a, b) => LANGUAGE_ORDER.indexOf(a.locale) - LANGUAGE_ORDER.indexOf(b.locale)
);
// The wordmark is drawn in the page: it is the first thing seen, and it waits for no request.
const wordmark = wordmarkSvg.replace('<svg ', '<svg class="logo" aria-hidden="true" ');

/** The sections the bar names, and the ones only the menu has. */
const sections = [
  { id: 'como-funciona', text: t.navHow },
  { id: 'restricciones', text: t.navCheck },
  { id: 'cotizador', text: t.navRates },
];
const more = [
  { id: 'business', text: t.businessName },
  { id: 'sucursales', text: t.navLocations },
  { id: 'preguntas', text: t.faqTitle },
];
/** The Spanish path of the page in view. */
const here = spanishPath(Astro.url.pathname);
/** A section of the home page: there, the section; on another page, the page that owns it (D-139). */
const section = (id: string) => (inner ? href(SECTION_PAGES[id] ?? `/#${id}`) : `#${id}`);
/** Whether a section's link leads to the page in view. */
const isHere = (id: string) => inner && SECTION_PAGES[id] === here;
/** What opens a view of the home page's dialog there; elsewhere the link leads to its page. */
const dialog = (view: string) => (inner ? undefined : view);
const about = '/nosotros';
/**
 * The rows of the menu: the sections of the home page, then the page about Carinova. "Nuestras
 * raíces" was the second thing a visitor saw here; since it is a page (D-131) the menu leads to
 * it, in the words of the footer's link (D-133).
 */
const menu = [
  ...[...sections, ...more].map(({ id, text }) => ({ href: section(id), text, current: isHere(id) })),
  { href: href(about), text: t.footerAbout, current: here === about },
];
---

<header class="site-header on-navy">
  <div class="wrap header-inner">
    <a class="brand" href={inner ? href('/') : '#inicio'} aria-label={t.homeAria}><Fragment set:html={wordmark} /></a>
    <nav class="nav-desktop" aria-label={t.mainNavAria}>
      {
        sections.map(({ id, text }) => (
          <a href={section(id)} data-spy={inner ? undefined : id} aria-current={isHere(id) ? 'page' : undefined}>
            {text}
          </a>
        ))
      }
    </nav>
    <div class="header-tools">
      {
        inner ? (
          <>
            <a class="btn btn-primary btn-sm header-cta" href={href(CTA.signup.path)} data-auth="out">
              {t.createCta}
            </a>
            <a class="btn btn-primary btn-sm header-cta" href={href(CTA.account.path)} data-auth="in">
              {t.account}
            </a>
          </>
        ) : (
          <a class="btn btn-primary btn-sm header-cta" href={href(CTA.signup.path)} data-dialog="account">
            {t.createCta}
          </a>
        )
      }
      {
        languages.length > 0 && (
          <div class="lang-wrap">
            <button
              class="lang-btn"
              id="lang-button"
              type="button"
              dir="ltr"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="lang-menu"
            >
              <svg class="lang-flag" aria-hidden="true">
                <use href={`#${FLAGS[locale]}`} />
              </svg>
              <span class="sr-only">
                <span>{t.language}</span>:{' '}
              </span>
              <span id="lang-current">{LOCALE_INFO[locale].code}</span>
            </button>
            <div class="lang-menu" id="lang-menu" hidden>
              {languages.map(({ locale: code, path, current }) => (
                <a
                  href={getPermalink(path)}
                  hreflang={LOCALE_INFO[code].htmlLang}
                  data-lang={code}
                  lang={LOCALE_INFO[code].htmlLang}
                  dir="ltr"
                  aria-current={current ? 'true' : undefined}
                >
                  <Icon name="check" class="lang-check" />
                  <svg class="lang-flag" aria-hidden="true">
                    <use href={`#${FLAGS[code]}`} />
                  </svg>
                  <span dir={LOCALE_INFO[code].dir}>{LOCALE_INFO[code].name}</span>
                  <span class="lang-code">{LOCALE_INFO[code].code}</span>
                </a>
              ))}
            </div>
          </div>
        )
      }
      <a class="icon-btn" href={href(CTA.account.path)} aria-label={t.account} data-dialog={dialog('account')}
        ><Icon name="user" /><span class="account-dot" data-auth="in"></span></a
      >
      <button
        class="icon-btn"
        id="menu-button"
        type="button"
        aria-label={t.menu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-open={t.menu}
        data-close={t.uiClose}><Icon name="menu" /></button
      >
    </div>
    <nav class="mobile-nav" id="mobile-menu" aria-label={t.menuAria} hidden>
      {
        menu.map(({ href: to, text, current }) => (
          <a href={to} aria-current={current ? 'page' : undefined}>
            <span>{text}</span>
            <Icon name="chevron" />
          </a>
        ))
      }
      <div class="mobile-nav-actions">
        <a class="btn btn-ghost btn-sm" href={href(CTA.track.path)} data-dialog={dialog('tracking')}>{t.trackCta}</a>
        {
          inner ? (
            <>
              <a class="btn btn-primary btn-sm" href={href(CTA.signup.path)} data-auth="out">
                {t.createCta}
              </a>
              <a class="btn btn-primary btn-sm" href={href(CTA.account.path)} data-auth="in">
                {t.account}
              </a>
            </>
          ) : (
            <a class="btn btn-primary btn-sm" href={href(CTA.signup.path)} data-dialog="account">
              {t.createCta}
            </a>
          )
        }
      </div>
    </nav>
  </div>
</header>
