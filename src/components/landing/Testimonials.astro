---
// "Lo que dicen nuestros clientes": one card at a time, advancing by themselves
// (scripts/carousel.ts). With reviews in REVIEWS, the cards are the reviews. Until there are any,
// the section shows the three cards of Carinova's page, which say that a customer's own words will
// go there: a place kept for reviews, not a review.
import { REVIEWS } from '~/data/carinova';
import { i18n } from '~/i18n';

import Icon from './Icon.astro';
import ScriptData from './ScriptData.astro';

const { ui } = i18n(Astro);
const t = ui.landing;

/** The three cards of Carinova's page while there is nothing to quote. */
const SLOTS = 3;
const cards =
  REVIEWS.length > 0
    ? REVIEWS.map((review) => ({ quote: review.text, name: review.name, place: review.source ?? '', slot: false }))
    : Array.from({ length: SLOTS }, () => ({
        quote: t.testimonialSlotQuote,
        name: t.testimonialSlotName,
        place: t.testimonialSlotPlace,
        slot: true,
      }));

const config = { carousel: t.uiCarousel, slide: t.uiSlide, slideLabel: t.uiSlideLabel };
---

<section class="hero-section testimonials on-navy" id="clientes" aria-labelledby="testimonials-title">
  <div class="wrap">
    <h2 class="hero-title" id="testimonials-title">{t.testimonialsTitle}</h2>
    <div
      class="t-viewport"
      id="t-viewport"
      role="group"
      aria-roledescription={t.uiCarousel}
      aria-labelledby="testimonials-title"
      aria-describedby="t-keys"
      tabindex="0"
    >
      {/* The first card is in view before the script takes over; the script shows the others in turn. */}
      <div class="t-track" id="t-track" aria-live="off">
        {
          cards.map(({ quote, name, place, slot }, index) => (
            <div class:list={['t-card', slot && 'is-slot', index === 0 && 'is-active']} role="group">
              <Icon name="quote" class="t-mark" />
              <blockquote>
                <p dir="auto">{quote}</p>
              </blockquote>
              <p class="t-who">
                <strong dir="auto">{name}</strong>
                {place && <span>{place}</span>}
              </p>
            </div>
          ))
        }
      </div>
    </div>
    <p class="sr-only" id="t-keys">{t.uiCarouselKeys}</p>
  </div>
</section>
<ScriptData name="carousel" value={config} />
