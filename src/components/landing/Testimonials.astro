---
// "Lo que dicen nuestros clientes": one card at a time, advancing by themselves
// (scripts/carousel.ts). The cards are the reviews of REVIEWS (src/data/carinova.ts), newest first,
// in the words and under the name each person wrote them, never translated. A card says where the
// review was published (Facebook or Google) and when, shows the person's photo from Carinova's R2
// bucket (their initials until there is one), what the source says of it (a recommendation, or a
// Google review's stars) and a link to it there. Under the cards, a link to every review of each
// source. Until there are reviews, the section shows the three cards of Carinova's page, which say
// that a customer's own words will go there: a place kept for reviews, not a review.
import { REVIEWS, REVIEW_SOURCES } from '~/data/carinova';
import { LOCALE_INFO, i18n } from '~/i18n';
import { initials, newestFirst, paragraphsOf, photoUrl, reviewMonth, reviewUrl, sourcesOf } from '~/utils/reviews';
import { fill } from '~/utils/template';

import Icon from './Icon.astro';
import { REVIEW_SOURCE_ICONS } from './icons';
import ScriptData from './ScriptData.astro';

const { locale, ui } = i18n(Astro);
const t = ui.landing;
const { intl } = LOCALE_INFO[locale];

const reviews = newestFirst(REVIEWS).map((review, index) => ({
  ...review,
  nameId: `t-name-${index + 1}`,
  paragraphs: paragraphsOf(review.text),
  initials: initials(review.name, review.lang),
  photo: photoUrl(review.photo),
  url: reviewUrl(review),
  month: reviewMonth(intl, review.date),
  sourceName: REVIEW_SOURCES[review.source].name,
  logo: REVIEW_SOURCE_ICONS[review.source],
  stars: review.source === 'google' ? review.rating : 0,
}));
const sources = sourcesOf(REVIEWS).map((source) => ({
  ...REVIEW_SOURCES[source],
  logo: REVIEW_SOURCE_ICONS[source],
  source,
}));

/** The three cards of Carinova's page while there is nothing to quote. */
const SLOTS = 3;

const config = { carousel: t.uiCarousel, slide: t.uiSlide, slideLabel: t.uiSlideLabel };
---

<section class="hero-section testimonials on-navy" id="clientes" aria-labelledby="testimonials-title">
  <div class="wrap">
    <h2 class="hero-title" id="testimonials-title">{t.testimonialsTitle}</h2>
    <div
      class="t-viewport"
      id="t-viewport"
      role="group"
      aria-roledescription={t.uiCarousel}
      aria-labelledby="testimonials-title"
      aria-describedby="t-keys"
      tabindex="0"
    >
      {/* The first card is in view before the script takes over; the script shows the others in turn. */}
      <div class="t-track" id="t-track" aria-live="off">
        {
          reviews.length > 0
            ? reviews.map((review, index) => (
                <div class:list={['t-card', index === 0 && 'is-active']} role="group">
                  <div class="t-top">
                    <Icon name="quote" class="t-mark" />
                    <p class="t-source">
                      <svg aria-hidden="true" class={`t-logo is-${review.source}`}>
                        <use href={`#${review.logo}`} />
                      </svg>
                      <span>{review.sourceName}</span>
                      <time datetime={review.date}>{review.month}</time>
                    </p>
                  </div>
                  <blockquote lang={review.lang} cite={review.url || undefined}>
                    {review.paragraphs.map((paragraph) => (
                      <p dir="auto">{paragraph}</p>
                    ))}
                  </blockquote>
                  <div class="t-who t-by">
                    <div class="t-avatar" aria-hidden="true">
                      {review.initials}
                      {review.photo && (
                        <img src={review.photo} alt="" width="48" height="48" loading="lazy" decoding="async" />
                      )}
                    </div>
                    <p class="t-person">
                      <strong dir="auto" id={review.nameId}>
                        {review.name}
                      </strong>
                      {review.stars > 0 ? (
                        <span class="t-stars" role="img" aria-label={fill(t.reviewRating, { rating: review.stars })}>
                          {Array.from({ length: 5 }, (_, star) => (
                            <Icon name="star" class={star < review.stars ? undefined : 'is-off'} />
                          ))}
                        </span>
                      ) : (
                        <span>{t.reviewRecommends}</span>
                      )}
                    </p>
                    {review.url && (
                      <a
                        class="link t-link"
                        href={review.url}
                        target="_blank"
                        rel="noopener"
                        aria-describedby={review.nameId}
                      >
                        {fill(t.reviewSeeOn, { source: review.sourceName })}
                        <Icon name="external" />
                      </a>
                    )}
                  </div>
                </div>
              ))
            : Array.from({ length: SLOTS }, (_, index) => (
                <div class:list={['t-card', 'is-slot', index === 0 && 'is-active']} role="group">
                  <Icon name="quote" class="t-mark" />
                  <blockquote>
                    <p dir="auto">{t.testimonialSlotQuote}</p>
                  </blockquote>
                  <p class="t-who">
                    <strong dir="auto">{t.testimonialSlotName}</strong>
                    <span>{t.testimonialSlotPlace}</span>
                  </p>
                </div>
              ))
        }
      </div>
    </div>
    <p class="sr-only" id="t-keys">{t.uiCarouselKeys}</p>
    {
      sources.length > 0 && (
        <ul class="t-sources">
          {sources.map(({ name, url, logo, source }) => (
            <li>
              <a class="link link-light t-all" href={url} target="_blank" rel="noopener">
                <span class="t-badge" aria-hidden="true">
                  <svg class={`t-logo is-${source}`}>
                    <use href={`#${logo}`} />
                  </svg>
                </span>
                {fill(t.reviewsAllOn, { source: name })}
                <Icon name="external" />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
<ScriptData name="carousel" value={config} />
