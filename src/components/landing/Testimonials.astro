---
// "Lo que dicen nuestros clientes": the newest reviews in a row, with the edge of the next card in
// view so that it shows there are more, and the way to all of them (/opiniones). The row came in
// on 2026-11-21 (D-130), moved by hand with two arrows and a bar under it; since 2026-11-25 it
// moves by itself, one card at a time and without end, and nothing is drawn to move it (D-136).
// Carinova's page showed one card at a time, changing by itself, with nothing to move it.
//
// - The cards are a preview: the newest of REVIEWS (src/data/carinova.ts), Facebook and Google
//   taking turns once both have reviews (utils/reviews.ts → previewOf). Each is the review as its
//   source publishes it, never translated: where and when it was published, the person's photo from
//   Carinova's R2 bucket (their initials until there is one, or if it cannot be loaded), what the
//   source says of it (a recommendation, or a Google review's stars) and a link to it there.
// - A long review shows its beginning and leads to the whole of it on the page of reviews.
// - When there are more reviews than cards, the last card of the row says so and leads to them.
// - The row is a list that scrolls sideways (a finger, a trackpad, the keyboard): the script makes
//   it move by itself and without end (scripts/carousel.ts), and without it nothing is lost.
// - Until there are reviews, the section shows the three cards of Carinova's page, which say that
//   a customer's own words will go there: a place kept for reviews, not a review.
import { REVIEWS, REVIEW_SOURCES } from '~/data/carinova';
import { LOCALE_INFO, i18n } from '~/i18n';
import { previewOf, reviewCards, sourcesOf } from '~/utils/reviews';
import { fill } from '~/utils/template';

import Icon from './Icon.astro';
import { REVIEW_SOURCE_ICONS } from './icons';

const { locale, href, ui } = i18n(Astro);
const t = ui.landing;
const words = ui.reviews;

/** How many reviews the home page previews. */
const PREVIEW = 6;
/** The three cards of Carinova's page while there is nothing to quote. */
const SLOTS = 3;

const reviews = reviewCards(previewOf(REVIEWS, PREVIEW), LOCALE_INFO[locale].intl, REVIEWS).map((review) => ({
  ...review,
  logo: REVIEW_SOURCE_ICONS[review.source],
}));
const hasMore = REVIEWS.length > reviews.length;
const sources = sourcesOf(REVIEWS).map((source) => ({
  ...REVIEW_SOURCES[source],
  logo: REVIEW_SOURCE_ICONS[source],
  source,
}));
const all = href('/opiniones');
---

<section class="hero-section testimonials on-navy" id="clientes" aria-labelledby="testimonials-title">
  <div class="wrap">
    <h2 class="hero-title" id="testimonials-title">{t.testimonialsTitle}</h2>
  </div>
  {/* The row is as wide as the screen, so a card leaves it at the edge of the screen. */}
  <div
    class="t-viewport"
    id="t-viewport"
    role="group"
    aria-roledescription={t.uiCarousel}
    aria-labelledby="testimonials-title"
    aria-describedby="t-keys"
    tabindex="0"
  >
    <ul class="t-track" id="t-track">
      {
        reviews.length > 0
          ? reviews.map((review) => (
              <li class:list={['t-card', review.long && 'is-long']}>
                <div class="t-top">
                  <Icon name="quote" class="t-mark" />
                  <p class="t-source">
                    <svg aria-hidden="true" class={`t-logo is-${review.source}`}>
                      <use href={`#${review.logo}`} />
                    </svg>
                    <span>{review.sourceName}</span>
                    <time datetime={review.date.slice(0, 7)}>{review.month}</time>
                  </p>
                </div>
                <blockquote lang={review.lang} cite={review.link || undefined}>
                  {review.long ? (
                    <p dir="auto">{review.text}</p>
                  ) : (
                    review.paragraphs.map((paragraph) => <p dir="auto">{paragraph}</p>)
                  )}
                </blockquote>
                {review.long && (
                  <a class="link t-read" href={`${all}#${review.id}`} aria-describedby={`t-name-${review.id}`}>
                    {words.readAll}
                    <Icon name="arrow" />
                  </a>
                )}
                <div class="t-who t-by">
                  <div class="t-avatar" aria-hidden="true">
                    {review.initials}
                    {review.photoSrc && (
                      <img
                        src={review.photoSrc}
                        alt=""
                        width="48"
                        height="48"
                        loading="lazy"
                        decoding="async"
                        onerror="this.remove()"
                      />
                    )}
                  </div>
                  <p class="t-person">
                    <strong dir="auto" id={`t-name-${review.id}`}>
                      {review.name}
                    </strong>
                    {review.stars > 0 ? (
                      <span class="t-stars" role="img" aria-label={fill(words.rating, { rating: review.stars })}>
                        {Array.from({ length: 5 }, (_, star) => (
                          <Icon name="star" class={star < review.stars ? undefined : 'is-off'} />
                        ))}
                      </span>
                    ) : (
                      <span>{words.recommends}</span>
                    )}
                  </p>
                  {review.link && (
                    <a
                      class="link t-link"
                      href={review.link}
                      target="_blank"
                      rel="noopener"
                      aria-describedby={`t-name-${review.id}`}
                    >
                      {fill(words.seeOn, { source: review.sourceName })}
                      <Icon name="external" />
                    </a>
                  )}
                </div>
              </li>
            ))
          : Array.from({ length: SLOTS }, () => (
              <li class="t-card is-slot">
                <Icon name="quote" class="t-mark" />
                <blockquote>
                  <p dir="auto">{t.testimonialSlotQuote}</p>
                </blockquote>
                <p class="t-who">
                  <strong dir="auto">{t.testimonialSlotName}</strong>
                  <span>{t.testimonialSlotPlace}</span>
                </p>
              </li>
            ))
      }
      {
        hasMore && (
          <li class="t-card t-more">
            <Icon name="quote" class="t-mark" />
            <p class="t-more-title">{words.moreTitle}</p>
            <p class="t-more-text">{words.moreText}</p>
            <a class="btn btn-primary btn-sm" href={all}>
              <span>{words.seeAll}</span>
              <Icon name="arrow" />
            </a>
          </li>
        )
      }
    </ul>
  </div>
  <div class="wrap">
    <p class="sr-only" id="t-keys">{t.uiCarouselKeys}</p>
    {
      reviews.length > 0 && (
        <ul class="t-sources">
          <li>
            <a class="link link-light t-all" href={all}>
              {words.seeAll}
              <Icon name="arrow" />
            </a>
          </li>
          {sources.map(({ name, url, logo, source }) => (
            <li>
              <a class="link link-light t-all" href={url} target="_blank" rel="noopener">
                <span class="t-badge" aria-hidden="true">
                  <svg class={`t-logo is-${source}`}>
                    <use href={`#${logo}`} />
                  </svg>
                </span>
                {fill(words.allOn, { source: name })}
                <Icon name="external" />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
