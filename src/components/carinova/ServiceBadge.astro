---
// "Próximamente" (grey) next to what is not available yet (the Los Ángeles warehouse), or "Cargo
// adicional" (amber) next to a service that is charged apart (home delivery), in the page's
// language. It brings its own leading space, so the text around it never reads "Entrega a
// domicilioCargo adicional" (screen readers, search engines); flex containers ignore that space.
import { i18n } from '~/i18n';

export interface Props {
  kind: 'soon' | 'extra';
}

const { kind } = Astro.props;
const { locale } = i18n(Astro);

const label = {
  es: { soon: 'Próximamente', extra: 'Cargo adicional' },
  en: { soon: 'Coming soon', extra: 'Additional charge' },
}[locale][kind];
const tone = kind === 'extra' ? 'bg-amber-100 text-amber-950' : 'bg-slate-200 text-slate-800';
---

{' '}<span
  class:list={['inline-block rounded-full px-2.5 py-0.5 font-sans text-xs font-semibold tracking-normal', tone]}
  >{label}</span
>
