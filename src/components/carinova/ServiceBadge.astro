---
// "Gratis" (green) or "Próximamente" (grey) next to a service, a reception point or a delivery option,
// in the page's language. It brings its own leading space, so the text around it never reads
// "Compras asistidasGratis" (screen readers, search engines); flex containers ignore that space.
import { i18n } from '~/i18n';

export interface Props {
  kind: 'free' | 'soon';
}

const { kind } = Astro.props;
const { locale } = i18n(Astro);

const label = {
  es: { free: 'Gratis', soon: 'Próximamente' },
  en: { free: 'Free', soon: 'Coming soon' },
}[locale][kind];
const tone = kind === 'free' ? 'bg-green-100 text-green-900' : 'bg-slate-200 text-slate-800';
---

{' '}<span
  class:list={['inline-block rounded-full px-2.5 py-0.5 font-sans text-xs font-semibold tracking-normal', tone]}
  >{label}</span
>
