---
// The heading of a section of the home page: one <h2> in two parts. A small first line (the
// "eyebrow", after the section's number) says what the section is about in the words people search
// for; the display line under it is the brand's voice, with its last words in orange. Both are the
// heading, so a search engine and a screen reader get "Envío aéreo y marítimo a Nicaragua: Dos
// modalidades. Un destino." where the eye gets a label and a title.
//
// With `aside`, the heading takes the left and a short paragraph the right (one under the other on
// phones); with `center`, heading and paragraph are centred.
export interface Props {
  /** "01", "02"… Shown before the eyebrow; it is not part of the heading's words. */
  number?: string;
  eyebrow: string;
  /** The display line, in two parts: plain words, then the ones in orange. */
  title: Array<string>;
  /** A short paragraph beside the heading (or under it, when centred). */
  aside?: string;
  center?: boolean;
  /** Extra classes for the display line, e.g. a smaller size inside a band. */
  titleClass?: string;
  /** Extra classes for the paragraph. */
  asideClass?: string;
  class?: string;
}

const {
  number,
  eyebrow,
  title,
  aside,
  center = false,
  titleClass,
  asideClass = 'text-muted',
  class: className,
} = Astro.props;
---

<div
  class:list={[
    center
      ? 'mx-auto max-w-3xl text-center'
      : aside && 'flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between lg:gap-12',
    className,
  ]}
>
  <h2>
    <span class:list={['eyebrow', center && 'justify-center']}>
      <span>{number && <span aria-hidden="true">{number} / </span>}{eyebrow}</span>
    </span>{' '}
    <span class:list={['display-title mt-5 block', titleClass]}>{title[0]}{' '}<em>{title[1]}</em></span>
  </h2>
  {
    aside && (
      <p
        class:list={[
          'text-base leading-relaxed',
          center ? 'mx-auto mt-5 max-w-2xl sm:text-lg' : 'max-w-sm lg:pb-1.5',
          asideClass,
        ]}
      >
        {aside}
      </p>
    )
  }
</div>
