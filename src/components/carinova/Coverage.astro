---
// "Nos movemos para llegar hasta vos" (home page), the coverage section of the prototype: a drawn
// map of Nicaragua with the branches on it, the branches as links to their card on /sucursales, the
// opening hours and how home delivery is arranged. The map is an illustration: it shows no
// addresses and no routes, and says so.
import { Icon } from 'astro-icon/components';
import WhatsAppHelp from '~/components/carinova/WhatsAppHelp.astro';
import { i18n } from '~/i18n';

const { locale, href, data } = i18n(Astro);
const { BRANCHES, WA_MESSAGES, describeHours } = data;

const cities = BRANCHES.map((branch) => branch.city);
const [hours] = BRANCHES[0].hours;

const t = {
  es: {
    eyebrow: '¡Más cerca de vos!',
    title: 'Nos movemos para llegar hasta vos.',
    intro:
      'Realizamos envíos a todo el país. Podés retirar tus paquetes en nuestras sucursales o consultar opciones de entrega a domicilio.',
    mapLabel: `Mapa ilustrativo de Nicaragua con puntos de atención en ${cities.join(' y ')}`,
    mapCaption: 'Mapa ilustrativo: no muestra direcciones físicas ni rutas operativas.',
    pickup: 'Sucursal de retiro',
    hoursTitle: 'Horario de atención',
    hours: (text: string) => text.charAt(0).toUpperCase() + text.slice(1),
    fine: 'Las direcciones, la cobertura específica y los cargos de domicilio se confirman al coordinar.',
    delivery: 'Consultar entrega a domicilio',
  },
  en: {
    eyebrow: 'Closer to you!',
    title: 'We move to reach you.',
    intro:
      'We deliver anywhere in the country. You can pick up your packages at our branches or ask about home delivery options.',
    mapLabel: `Illustrative map of Nicaragua with service points in ${cities.join(' and ')}`,
    mapCaption: 'Illustrative map: it does not show physical addresses or operating routes.',
    pickup: 'Pickup branch',
    hoursTitle: 'Opening hours',
    hours: (text: string) => text,
    fine: 'Addresses, specific coverage and home delivery charges are confirmed when the delivery is arranged.',
    delivery: 'Ask about home delivery',
  },
}[locale];

// Where each branch is on the drawing (viewBox 350 × 390), by its id; a branch without a pin is
// still listed beside the map.
const PINS: Record<string, { x: number; y: number; labelX: number; anchor: 'start' | 'end' }> = {
  managua: { x: 125, y: 210, labelX: 108, anchor: 'end' },
  bluefields: { x: 226, y: 270, labelX: 244, anchor: 'start' },
};
const pins = BRANCHES.filter((branch) => PINS[branch.id]).map((branch) => ({ city: branch.city, ...PINS[branch.id] }));
---

<section id="cobertura" class="scroll-mt-20 bg-white">
  <div
    class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 md:py-20 lg:grid-cols-2 lg:items-center lg:gap-20 lg:py-24"
  >
    <figure class="min-w-0">
      <div
        class="relative flex min-h-80 items-center justify-center overflow-hidden rounded-2xl bg-[radial-gradient(circle_at_70%_21%,#1a4674,#09294f_55%,#06192f)] p-6 sm:min-h-[28rem]"
      >
        <div
          class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgb(255_255_255/0.045)_1px,transparent_1px),linear-gradient(90deg,rgb(255_255_255/0.045)_1px,transparent_1px)] bg-[size:3rem_3rem]"
          aria-hidden="true"
        >
        </div>
        <svg
          viewBox="0 0 350 390"
          class="relative h-auto w-56 drop-shadow-2xl sm:w-72"
          role="img"
          aria-label={t.mapLabel}
        >
          <path
            d="M100 13 138 29 155 65 171 89 211 80 239 108 236 146 266 172 255 194 275 229 262 248 290 278 277 301 238 310 216 338 189 355 167 377 146 347 128 324 90 314 71 281 61 251 43 232 59 203 40 171 54 145 44 113 64 92 58 60 75 38Z"
            fill="#1f5488"
            stroke="#66a1d0"
            stroke-linejoin="round"
            stroke-width="3"></path>
          <path
            d="M118 40c38 53 37 91 74 128s27 61 64 120M72 189c46 11 69 62 114 59"
            fill="none"
            stroke="#7da9d4"
            stroke-dasharray="6 9"
            stroke-width="3"></path>
          {
            pins.map((pin) => (
              <>
                <circle cx={pin.x} cy={pin.y} r="10" fill="#ff8a00" stroke="#163862" stroke-width="5" />
                <text
                  x={pin.labelX}
                  y={pin.y + 5}
                  text-anchor={pin.anchor}
                  fill="#ffffff"
                  font-size="15"
                  font-weight="800"
                  paint-order="stroke"
                  stroke="#09294f"
                  stroke-width="4"
                >
                  {pin.city}
                </text>
              </>
            ))
          }
        </svg>
      </div>
      <figcaption class="mt-3 text-xs leading-relaxed text-slate-600">{t.mapCaption}</figcaption>
    </figure>

    <div>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="display-title mt-4">{t.title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted">{t.intro}</p>

      <ul class="mt-7 divide-y divide-[#e0e7ef] border-y border-[#e0e7ef]">
        {
          BRANCHES.map((branch) => (
            <li>
              <a
                class="group flex min-h-14 items-center justify-between gap-4 py-3 font-heading text-lg font-bold text-heading hover:text-link"
                href={href(`/sucursales#${branch.id}`)}
              >
                <span class="flex items-center gap-2">
                  <Icon name="tabler:arrow-up-right" class="h-5 w-5 text-cta transition group-hover:translate-x-0.5" />
                  {branch.city}
                </span>
                <small class="font-sans text-sm font-normal text-muted">{t.pickup}</small>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-6 rounded-lg border-l-[3px] border-cta bg-[#f0f5fb] p-4 text-[#4d6680]">
        <p>
          <b class="block text-heading">{t.hoursTitle}</b>
          {t.hours(describeHours(hours))}
        </p>
        <p class="mt-2 text-sm">{t.fine}</p>
        <WhatsAppHelp class="mt-1 text-sm" message={WA_MESSAGES.homeDelivery} text={t.delivery} />
      </div>
    </div>
  </div>
</section>
