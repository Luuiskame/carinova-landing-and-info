---
// "Estamos más cerca." (home page): where packages are picked up. A drawn map of Nicaragua with the
// branches on it and one card per branch (its region, its hours, its address once Carinova confirms
// it), each leading to its card on /sucursales, the page that owns them. The map is an illustration:
// it shows no addresses and no routes, and says so.
import { Icon } from 'astro-icon/components';
import SectionHeading from '~/components/carinova/SectionHeading.astro';
import WhatsAppHelp from '~/components/carinova/WhatsAppHelp.astro';
import { ADDRESS_PENDING, BRANCHES as BRANCH_FACTS } from '~/data/carinova';
import { i18n } from '~/i18n';

const { href, data, ui } = i18n(Astro);
const { BRANCHES, WA_MESSAGES, formatHours } = data;
const t = ui.locations;

// The branches whose address Carinova has not sent yet: theirs is a notice, set lighter than an address.
const addressPending = new Set(
  BRANCH_FACTS.filter((branch) => branch.address === ADDRESS_PENDING).map((branch) => branch.id)
);

// Where each branch is on the drawing (viewBox 350 × 390), by its id; a branch without a pin is
// still listed beside the map.
const PINS: Record<string, { x: number; y: number; labelX: number; anchor: 'start' | 'end' }> = {
  managua: { x: 125, y: 210, labelX: 108, anchor: 'end' },
  bluefields: { x: 226, y: 270, labelX: 244, anchor: 'start' },
};
const pins = BRANCHES.filter((branch) => PINS[branch.id]).map((branch) => ({ city: branch.city, ...PINS[branch.id] }));
const regions: Record<string, string> = t.regions;
---

<section id="sucursales" class="scroll-mt-20 bg-[#f3f6fb]">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-20 lg:py-28">
    <SectionHeading number="06" eyebrow={t.eyebrow} title={t.title} aside={t.intro} />

    <div class="mt-10 grid gap-4 lg:grid-cols-[0.82fr_1fr_1fr]">
      <figure class="flex min-w-0 flex-col max-lg:order-last">
        <div
          class="relative flex min-h-64 flex-1 items-center justify-center overflow-hidden rounded-[1.15rem] bg-[radial-gradient(circle_at_70%_21%,#1a4674,#09294f_55%,#06192f)] p-6"
        >
          <div
            class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgb(255_255_255/0.045)_1px,transparent_1px),linear-gradient(90deg,rgb(255_255_255/0.045)_1px,transparent_1px)] bg-[size:3rem_3rem]"
            aria-hidden="true"
          >
          </div>
          <svg
            viewBox="0 0 350 390"
            class="relative h-auto w-56 drop-shadow-2xl sm:w-64 lg:w-56 xl:w-64"
            role="img"
            aria-label={t.mapLabel}
          >
            <path
              d="M100 13 138 29 155 65 171 89 211 80 239 108 236 146 266 172 255 194 275 229 262 248 290 278 277 301 238 310 216 338 189 355 167 377 146 347 128 324 90 314 71 281 61 251 43 232 59 203 40 171 54 145 44 113 64 92 58 60 75 38Z"
              fill="#1f5488"
              stroke="#66a1d0"
              stroke-linejoin="round"
              stroke-width="3"></path>
            <path
              d="M118 40c38 53 37 91 74 128s27 61 64 120M72 189c46 11 69 62 114 59"
              fill="none"
              stroke="#7da9d4"
              stroke-dasharray="6 9"
              stroke-width="3"></path>
            {
              pins.map((pin) => (
                <>
                  <circle cx={pin.x} cy={pin.y} r="10" fill="#ff8a00" stroke="#163862" stroke-width="5" />
                  <text
                    x={pin.labelX}
                    y={pin.y + 5}
                    text-anchor={pin.anchor}
                    direction="ltr"
                    fill="#ffffff"
                    font-size="19"
                    font-weight="800"
                    paint-order="stroke"
                    stroke="#09294f"
                    stroke-width="4"
                  >
                    {pin.city}
                  </text>
                </>
              ))
            }
          </svg>
        </div>
        <figcaption class="mt-2.5 text-xs leading-relaxed text-slate-600">{t.mapCaption}</figcaption>
      </figure>

      {
        BRANCHES.map((branch) => (
          <article class="flex flex-col rounded-[1.15rem] border border-[#dfe7f1] bg-white p-6 shadow-[0_0.6rem_1.75rem_rgb(6_27_59/0.035)] sm:p-7">
            <div class="flex items-start gap-4">
              <span class="grid h-[3.25rem] w-[3.25rem] shrink-0 place-items-center rounded-xl bg-[#fff0df] text-[#b65307]">
                <Icon name="tabler:map-pin" class="h-6 w-6" />
              </span>
              <div class="min-w-0">
                <p class="pt-0.5 text-[0.6875rem] leading-snug font-black tracking-[0.12em] text-[#56657c] uppercase">
                  {regions[branch.id] ?? t.country}
                </p>
                <h3 class="mt-1.5 font-heading text-3xl font-extrabold tracking-[-0.04em] text-heading">
                  {branch.city}
                </h3>
              </div>
            </div>

            <ul class="mt-5 space-y-2 text-[0.9375rem] font-semibold text-heading">
              {branch.hours.map((row) => (
                <li class="flex items-start gap-2.5">
                  <Icon name="tabler:clock" class="mt-0.5 h-5 w-5 shrink-0 text-[#b85600]" />
                  <span>
                    {row.days}
                    <span class="block font-normal text-muted">{formatHours(row)}</span>
                  </span>
                </li>
              ))}
              <li class="flex items-start gap-2.5">
                <Icon name="tabler:home-2" class="mt-0.5 h-5 w-5 shrink-0 text-[#b85600]" />
                <span class:list={[addressPending.has(branch.id) && 'font-normal text-muted']}>{branch.address}</span>
              </li>
            </ul>

            <div class="mt-auto flex flex-col border-t border-[#e4eaf1] pt-3 text-sm [&]:mt-6">
              <a
                class="inline-flex min-h-11 items-center justify-between gap-3 font-extrabold text-secondary underline-offset-4 hover:underline"
                href={href(`/sucursales#${branch.id}`)}
              >
                {t.see(branch.city)}
                <Icon name="tabler:arrow-up-right" class="h-5 w-5 shrink-0" />
              </a>
              <WhatsAppHelp
                message={WA_MESSAGES.homeBranch(branch.city)}
                phone={branch.whatsapp}
                text={t.ask}
                context={`(${branch.city})`}
              />
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-6 flex flex-wrap items-center gap-x-2 text-sm text-muted">
      <span>{t.fine}</span>
      <WhatsAppHelp message={WA_MESSAGES.homeDelivery} text={t.delivery} />
    </p>
  </div>
</section>
