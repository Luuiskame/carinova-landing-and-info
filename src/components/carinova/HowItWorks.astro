---
// "Cómo funciona": four numbered steps and the mailbox call to action.
import { Icon } from 'astro-icon/components';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { BRANCHES, CONTACT, WA_MESSAGES } from '~/data/carinova';
import { whatsappLink } from '~/utils/whatsapp';

const cities = BRANCHES.map((branch) => branch.city).join(' o ');

// TODO: confirm the process with Carinova (mailbox in Miami, notifications, pickup only?).
const steps = [
  {
    icon: 'tabler:map-pin-share',
    title: 'Abre tu casillero',
    description: 'Escríbenos por WhatsApp y te damos tu dirección en Miami, a tu nombre.',
  },
  {
    icon: 'tabler:shopping-cart',
    title: 'Compra en línea',
    description: 'Compra en Amazon, Shein, Temu o cualquier tienda y usa tu dirección de Miami para el envío.',
  },
  {
    icon: 'tabler:plane-departure',
    title: 'Lo traemos a Nicaragua',
    description: 'Recibimos tu paquete y lo enviamos por avión o por barco. Te avisamos en cada paso.',
  },
  {
    icon: 'tabler:package',
    title: 'Retíralo cerca de ti',
    description: `Pasa por tu paquete a nuestra sucursal de ${cities}.`,
  },
];
---

<WidgetWrapper id="como-funciona" bg='<div class="absolute inset-0 bg-slate-50"></div>'>
  <Headline
    tagline="Cómo funciona"
    title="Tu compra en Estados Unidos, en 4 pasos"
    subtitle="Tú compras, nosotros nos encargamos de traerlo."
  />
  <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      steps.map((step, index) => (
        <li class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#011028] font-heading text-lg font-bold text-white">
              {index + 1}
            </span>
            <Icon name={step.icon} class="h-7 w-7 text-primary" />
          </div>
          <h3 class="mt-4 font-heading text-lg font-bold text-heading">{step.title}</h3>
          <p class="mt-2 text-muted">{step.description}</p>
        </li>
      ))
    }
  </ol>
  <div class="mt-10 text-center">
    <a
      class="btn-primary"
      href={whatsappLink(CONTACT.whatsapp, WA_MESSAGES.casillero)}
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="tabler:brand-whatsapp" class="mr-2 h-5 w-5" />
      Abrir mi casillero
    </a>
  </div>
</WidgetWrapper>
