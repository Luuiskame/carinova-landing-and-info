---
// "Tres pasos, de allá para acá." (home page): the steps of PROCESS_STEPS, one card each, with where
// each one leads. The page that owns them, with their details and worked examples, is /como-comprar.
//
// What a step leads to depends on who is looking: "Crear cuenta" is for visitors, and a customer who
// is signed in gets their account in its place. A step with a `homeAnchor` stays on this page (the
// article search of the tracker).
import { Icon } from 'astro-icon/components';
import SectionHeading from '~/components/carinova/SectionHeading.astro';
import { i18n } from '~/i18n';

const { href, data, ui } = i18n(Astro);
const { CTA, PROCESS_STEPS } = data;
const t = ui.howItWorks;

const steps = PROCESS_STEPS.map((step, index) => {
  const path = step.link?.path;
  return {
    ...step,
    number: String(index + 1).padStart(2, '0'),
    last: index === PROCESS_STEPS.length - 1,
    href: step.homeAnchor ?? (path && href(path)),
    forVisitors: path === CTA.signup.path,
  };
});

const linkClass =
  'mt-auto inline-flex min-h-11 items-center gap-1.5 pt-4 text-sm font-extrabold text-secondary underline-offset-4 hover:underline';
---

<section id="como-funciona" class="scroll-mt-20 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-20 lg:py-28">
    <SectionHeading number="04" eyebrow={t.eyebrow} title={t.title} aside={t.intro} />

    <ol class="mt-10 grid gap-4 md:grid-cols-3">
      {
        steps.map((step) => (
          <li class="flex flex-col rounded-[1.15rem] border border-[#e1e7ef] bg-white p-6 shadow-[0_0.75rem_2rem_rgb(2_23_55/0.035)] sm:p-7 md:min-h-80">
            <p class="flex items-center justify-between text-sm font-black tracking-[0.12em] text-secondary">
              <span>{step.number}</span>
              <Icon name={step.last ? 'tabler:check' : 'tabler:arrow-up-right'} class="h-5 w-5 text-cta" />
            </p>
            <span class="mt-7 grid h-14 w-14 place-items-center rounded-2xl bg-[#fff0de] text-[#b85600]">
              <Icon name={step.icon} class="h-7 w-7" />
            </span>
            <h3 class="mt-6 font-heading text-2xl leading-tight font-extrabold tracking-[-0.035em] text-heading">
              {step.title}
            </h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{step.summary}</p>
            {step.link && step.href && (
              <>
                <a class={linkClass} href={step.href} data-auth={step.forVisitors ? 'out' : undefined}>
                  {step.link.text}
                  <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
                </a>
                {step.forVisitors && (
                  <a class={linkClass} href={href(CTA.account.path)} data-auth="in">
                    {CTA.account.text}
                    <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
                  </a>
                )}
              </>
            )}
          </li>
        ))
      }
    </ol>

    <div class="mt-8 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-base text-muted">
        {t.closing}{' '}
        <a class="font-semibold text-link underline underline-offset-4" href={href('/como-comprar')}>{t.more}</a>
      </p>
      <div class="flex shrink-0">
        <a class="btn-navy w-full sm:w-auto" href={href(CTA.signup.path)} data-auth="out">
          {CTA.signup.text}
          <Icon name="tabler:arrow-up-right" class="h-5 w-5 shrink-0" />
        </a>
        <a class="btn-navy w-full sm:w-auto" href={href(CTA.account.path)} data-auth="in">
          {CTA.account.text}
          <Icon name="tabler:arrow-up-right" class="h-5 w-5 shrink-0" />
        </a>
      </div>
    </div>
  </div>
</section>
