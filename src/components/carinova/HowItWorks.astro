---
// "Cómo comprar" on the home page: the four steps in one line each (PROCESS_STEPS), the sign-up
// button and a link to the full page with worked examples.
import { Icon } from 'astro-icon/components';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import CtaGroup from '~/components/carinova/CtaGroup.astro';
import { i18n } from '~/i18n';

const { locale, href, data } = i18n(Astro);
const { PROCESS_STEPS } = data;

const t = {
  es: {
    tagline: 'Cómo comprar',
    title: `Tu compra en Estados Unidos, en ${PROCESS_STEPS.length} pasos`,
    subtitle: 'Vos comprás; nosotros lo traemos.',
    more: 'Ver el proceso con ejemplos por categoría',
  },
  en: {
    tagline: 'How to buy',
    title: `Your purchase in the United States, in ${PROCESS_STEPS.length} steps`,
    subtitle: 'You buy; we bring it.',
    more: 'See the process with examples by category',
  },
}[locale];
---

<WidgetWrapper id="como-comprar" bg='<div class="absolute inset-0 bg-slate-50"></div>'>
  <Headline tagline={t.tagline} title={t.title} subtitle={t.subtitle} />
  <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      PROCESS_STEPS.map((step, index) => (
        <li class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#011028] font-heading text-lg font-bold text-white">
              {index + 1}
            </span>
            <Icon name={step.icon} class="h-7 w-7 text-primary" />
          </div>
          <h3 class="mt-4 font-heading text-lg font-bold text-heading">{step.title}</h3>
          <p class="mt-2 text-muted">{step.summary}</p>
        </li>
      ))
    }
  </ol>
  <div class="mt-10 flex flex-col items-center gap-4">
    <CtaGroup quote={false} />
    <a class="font-semibold text-link underline underline-offset-4" href={href('/como-comprar')}>{t.more}</a>
  </div>
</WidgetWrapper>
