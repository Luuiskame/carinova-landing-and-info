---
// The customer's casillero (/mi-casillero): their Carinova ID, their address in Miami and the data
// they signed up with. The page is a static file, the same for everyone: it holds no customer data.
// The script asks the Worker for the account of whoever is signed in (GET /api/account, which reads
// the session cookie) and fills the page in; without a session it shows the way to sign in.
import { Icon } from 'astro-icon/components';
import CtaGroup from '~/components/carinova/CtaGroup.astro';
import MiamiAddressCard from '~/components/carinova/MiamiAddressCard.astro';
import WhatsAppHelp from '~/components/carinova/WhatsAppHelp.astro';
import { i18n } from '~/i18n';

const { locale, href, data } = i18n(Astro);
const { CTA, SIGNUP_COUNTRIES, WA_MESSAGES } = data;

const t = {
  es: {
    loading: 'Abriendo tu casillero…',
    noscript: 'Para ver tu casillero necesitás activar JavaScript en tu navegador.',
    hello: 'Hola, {name}',
    idLabel: 'Tu Carinova ID',
    idNote: 'Tenelo a mano cuando nos escribas o retires tus paquetes.',
    detailsTitle: 'Tus datos',
    detailsIntro: 'Con estos datos abriste tu casillero.',
    name: 'Nombre',
    email: 'Correo electrónico',
    phone: 'Teléfono',
    address: 'Dirección',
    since: 'Cliente desde',
    changed: '¿Cambió algo?',
    update: 'Pedir que actualicen mis datos',
    packagesTitle: 'Tus paquetes',
    packagesText:
      'Te avisamos por WhatsApp cuando tu paquete llega a nuestra bodega, cuando sale hacia Nicaragua y cuando está listo para retirar. Para saber de uno, escribinos con tu Carinova ID.',
    packagesLink: 'Consultar por mis paquetes',
    nextTitle: '¿Qué querés hacer?',
    howToBuy: 'Ver cómo comprar',
    restricted: 'Ver artículos prohibidos',
    signOut: 'Cerrar sesión',
    signingOut: 'Cerrando sesión…',
    signedOutTitle: 'Ingresá para ver tu casillero',
    signedOutText: 'Tu Carinova ID y tu dirección en Miami te esperan. Ingresás con tu correo, sin contraseña.',
    noMailbox: '¿Todavía no tenés casillero?',
    errorTitle: 'No pudimos abrir tu casillero',
    errorText: 'Revisá tu conexión e intentalo de nuevo. Si sigue fallando, escribinos por WhatsApp.',
    retry: 'Intentar de nuevo',
    documentTitle: 'Mi casillero {code} | Carinova',
  },
  en: {
    loading: 'Opening your mailbox…',
    noscript: 'To see your mailbox you need to turn on JavaScript in your browser.',
    hello: 'Hi, {name}',
    idLabel: 'Your Carinova ID',
    idNote: 'Keep it at hand when you write to us or pick up your packages.',
    detailsTitle: 'Your details',
    detailsIntro: 'You opened your mailbox with these details.',
    name: 'Name',
    email: 'E-mail',
    phone: 'Phone',
    address: 'Address',
    since: 'Customer since',
    changed: 'Has something changed?',
    update: 'Ask to have my details updated',
    packagesTitle: 'Your packages',
    packagesText:
      'We let you know on WhatsApp when your package arrives at our warehouse, when it leaves for Nicaragua and when it is ready for pickup. To ask about one, write to us with your Carinova ID.',
    packagesLink: 'Ask about my packages',
    nextTitle: 'What would you like to do?',
    howToBuy: 'See how to buy',
    restricted: 'See prohibited items',
    signOut: 'Sign out',
    signingOut: 'Signing out…',
    signedOutTitle: 'Sign in to see your mailbox',
    signedOutText:
      'Your Carinova ID and your address in Miami are waiting for you. You sign in with your e-mail, without a password.',
    noMailbox: 'Do you not have a mailbox yet?',
    errorTitle: 'We could not open your mailbox',
    errorText: 'Check your connection and try again. If it keeps failing, write to us on WhatsApp.',
    retry: 'Try again',
    documentTitle: 'My mailbox {code} | Carinova',
  },
}[locale];

const config = {
  /** For dates: Nicaragua writes "10 de noviembre de 2026". */
  dateLocale: locale === 'en' ? 'en-US' : 'es-NI',
  home: href('/'),
  countries: Object.fromEntries(SIGNUP_COUNTRIES.map((country) => [country.code, country.name])),
  text: {
    hello: t.hello,
    documentTitle: t.documentTitle,
    // The customer's Carinova ID goes into both messages.
    whatsappPackages: WA_MESSAGES.mailbox('{code}'),
    whatsappUpdate: WA_MESSAGES.mailboxUpdate('{code}'),
  },
};

const rows = [
  { id: 'name', label: t.name },
  { id: 'email', label: t.email },
  { id: 'phone', label: t.phone },
  { id: 'address', label: t.address },
  { id: 'since', label: t.since },
];

const messageClass = 'mx-auto max-w-xl px-4 py-16 text-center md:py-24';
const titleClass = 'mt-5 font-heading text-3xl font-bold text-heading outline-none md:text-4xl';
const textClass = 'mt-4 text-lg text-muted';
const cardClass = 'rounded-2xl bg-white p-6 text-left shadow-lg ring-1 ring-slate-200 sm:p-8';
const linkClass = 'inline-flex min-h-11 items-center font-semibold text-link underline underline-offset-4';
---

<cn-mailbox class="block" data-config={JSON.stringify(config)}>
  <section data-cn-state="loading" class={messageClass} aria-busy="true">
    <Icon name="tabler:loader-2" class="mx-auto h-12 w-12 text-primary motion-safe:animate-spin" />
    <p class={textClass} role="status">{t.loading}</p>
    <noscript>
      <p class="mt-6 rounded-xl bg-amber-100 p-4 text-sm text-amber-950">{t.noscript}</p>
    </noscript>
  </section>

  <section data-cn-state="ready" class="mx-auto max-w-3xl px-4 py-12 md:py-16" hidden>
    <div class="text-center">
      <h1 class={titleClass} tabindex="-1" data-cn-hello></h1>
      <p class="mt-6 text-sm font-semibold tracking-wide text-slate-600 uppercase">{t.idLabel}</p>
      <p
        class="mt-2 inline-block select-all rounded-2xl bg-[#011028] px-7 py-3 font-heading text-4xl font-extrabold tracking-wide text-white"
        data-cn-code
      >
      </p>
      <p class="mt-4 text-sm text-muted">{t.idNote}</p>
    </div>

    <div class="mt-10">
      <MiamiAddressCard />
    </div>

    <div class:list={['mt-8', cardClass]}>
      <h2 class="font-heading text-2xl font-bold text-heading">{t.packagesTitle}</h2>
      <p class="mt-2 text-muted">{t.packagesText}</p>
      {/* The script writes the customer's Carinova ID into the message, in the place of "…". */}
      <WhatsAppHelp class="mt-2" message={WA_MESSAGES.mailbox('…')} text={t.packagesLink} data-cn-whatsapp-packages />
    </div>

    <div class:list={['mt-8', cardClass]}>
      <h2 class="font-heading text-2xl font-bold text-heading">{t.detailsTitle}</h2>
      <p class="mt-1 text-muted">{t.detailsIntro}</p>
      <dl class="mt-5 divide-y divide-slate-100">
        {
          rows.map((row) => (
            <div class="flex flex-col gap-0.5 py-2.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <dt class="text-sm text-muted">{row.label}</dt>
              <dd class="font-semibold break-words text-heading sm:text-right" data-cn-detail={row.id} />
            </div>
          ))
        }
      </dl>
      <p class="mt-4 flex flex-wrap items-center gap-x-1.5 text-sm text-muted">
        <span>{t.changed}</span>
        {/* Like the link above, the script writes the customer's Carinova ID into the message. */}
        <WhatsAppHelp message={WA_MESSAGES.mailboxUpdate('…')} text={t.update} data-cn-whatsapp-update />
      </p>
    </div>

    <div class="mt-10 text-center">
      <h2 class="font-heading text-2xl font-bold text-heading">{t.nextTitle}</h2>
      <CtaGroup class="mt-6" signup={false} />
      <p class="mt-3 flex flex-wrap items-center justify-center gap-x-6">
        <a class={linkClass} href={href('/como-comprar')}>{t.howToBuy}</a>
        <a class={linkClass} href={href('/articulos-prohibidos')}>{t.restricted}</a>
      </p>
      <button
        type="button"
        class="mt-8 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-slate-600 underline underline-offset-4 hover:text-[#011028]"
        data-cn-signout
        data-busy-label={t.signingOut}
      >
        {t.signOut}
      </button>
    </div>
  </section>

  <section data-cn-state="signed-out" class={messageClass} hidden>
    <Icon name="tabler:lock" class="mx-auto h-14 w-14 text-primary" />
    <h1 class={titleClass} tabindex="-1">{t.signedOutTitle}</h1>
    <p class={textClass}>{t.signedOutText}</p>
    <a class="btn-primary mt-8 w-full sm:w-auto" href={href(CTA.signin.path)}>{CTA.signin.text}</a>
    <p class="mt-4 flex flex-wrap items-center justify-center gap-x-1.5 text-muted">
      <span>{t.noMailbox}</span>
      <a class={linkClass} href={href(CTA.signup.path)}>{CTA.signup.text}</a>
    </p>
  </section>

  <section data-cn-state="error" class={messageClass} hidden>
    <Icon name="tabler:alert-triangle" class="mx-auto h-14 w-14 text-secondary" />
    <h1 class={titleClass} tabindex="-1">{t.errorTitle}</h1>
    <p class={textClass}>{t.errorText}</p>
    <div class="mt-8 flex flex-col items-center gap-3">
      <button type="button" class="btn-primary w-full sm:w-auto" data-cn-retry>{t.retry}</button>
      <WhatsAppHelp message={WA_MESSAGES.mailboxError} />
    </div>
  </section>
</cn-mailbox>

<script>
  import { CONTACT, MIAMI_ADDRESS } from '~/data/carinova';
  import { getJson, postJson, setBusy } from '~/utils/forms';
  import { fill } from '~/utils/template';
  import { whatsappLink } from '~/utils/whatsapp';

  type State = 'loading' | 'ready' | 'signed-out' | 'error';

  /** What GET /api/account answers with (worker/store.ts → Account). */
  interface Account {
    code: string;
    firstName: string;
    lastName: string;
    email: string;
    phone: string;
    country: string;
    address1: string;
    address2: string;
    city: string;
    state: string;
    postalCode: string;
    createdAt: string;
  }

  interface Config {
    dateLocale: string;
    home: string;
    /** Country names by code, in the page's language. */
    countries: Record<string, string>;
    text: Record<'hello' | 'documentTitle' | 'whatsappPackages' | 'whatsappUpdate', string>;
  }

  class CnMailbox extends HTMLElement {
    private config!: Config;

    connectedCallback() {
      this.config = JSON.parse(this.dataset.config ?? '{}');
      this.querySelector('[data-cn-retry]')?.addEventListener('click', () => void this.load());
      this.querySelector('[data-cn-signout]')?.addEventListener('click', () => void this.signOut());
      void this.load();
    }

    private show(state: State, moveFocus = true) {
      for (const section of this.querySelectorAll<HTMLElement>('[data-cn-state]')) {
        section.hidden = section.dataset.cnState !== state;
      }
      if (moveFocus) this.querySelector<HTMLElement>(`[data-cn-state="${state}"] h1`)?.focus({ preventScroll: true });
    }

    private setText(selector: string, text: string) {
      const element = this.querySelector(selector);
      if (element) element.textContent = text;
    }

    private async load() {
      // Nobody is signed in on this browser (SessionState.astro read the flag cookie): there is no
      // account to ask for.
      if (document.documentElement.dataset.session !== 'in') return this.show('signed-out', false);

      this.show('loading', false);
      const { status, result } = await getJson('/api/account');

      if (status === 200 && result?.account) return this.showAccount(result.account as Account);
      if (status === 401) {
        // No session (it ended, or there never was one): the Worker cleared the cookies with its
        // answer, and the page goes back to what a visitor sees.
        document.documentElement.dataset.session = 'out';
        return this.show('signed-out');
      }
      this.show('error');
    }

    private showAccount(account: Account) {
      const { text, countries, dateLocale } = this.config;

      this.setText('[data-cn-hello]', fill(text.hello, { name: account.firstName }));
      this.setText('[data-cn-code]', account.code);
      this.setText('[data-cn-fill="firstName"]', MIAMI_ADDRESS.firstName(account.firstName));
      this.setText('[data-cn-fill="lastName"]', MIAMI_ADDRESS.lastName(account.lastName));

      const place = [account.city, account.state, account.postalCode].filter(Boolean).join(', ');
      const address = [account.address1, account.address2, place, countries[account.country] ?? account.country];
      const since = new Date(account.createdAt);
      const details: Record<string, string> = {
        name: `${account.firstName} ${account.lastName}`,
        email: account.email,
        phone: account.phone,
        address: address.filter(Boolean).join(' · '),
        since: Number.isNaN(since.getTime())
          ? ''
          : new Intl.DateTimeFormat(dateLocale, { dateStyle: 'long' }).format(since),
      };
      for (const [id, value] of Object.entries(details)) this.setText(`[data-cn-detail="${id}"]`, value);

      const links: Array<[string, string]> = [
        ['[data-cn-whatsapp-packages]', text.whatsappPackages],
        ['[data-cn-whatsapp-update]', text.whatsappUpdate],
      ];
      for (const [selector, message] of links) {
        const link = this.querySelector<HTMLAnchorElement>(selector);
        if (link) link.href = whatsappLink(CONTACT.whatsapp, fill(message, { code: account.code }));
      }

      document.documentElement.dataset.session = 'in';
      document.title = fill(text.documentTitle, { code: account.code });
      this.show('ready');
    }

    private async signOut() {
      const button = this.querySelector<HTMLButtonElement>('[data-cn-signout]');
      setBusy(button, true);
      const { status } = await postJson('/api/logout', {});
      if (status !== 200) return setBusy(button, false);
      // A full page load: every page is back to what a visitor sees.
      window.location.assign(this.config.home);
    }
  }

  if (!customElements.get('cn-mailbox')) customElements.define('cn-mailbox', CnMailbox);
</script>
