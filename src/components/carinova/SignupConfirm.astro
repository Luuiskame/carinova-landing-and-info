---
// What a confirmation link opens (/registro/confirmar?token=…). The page is static: the script
// reads the token from the address, and the button posts it to /api/signup/confirm, which creates
// the customer (worker/api.ts). Confirming takes a click rather than just opening the page,
// because e-mail scanners open links on their own.
//
// The confirmation that creates the account also signs the customer in on this browser (the Worker
// sets the session cookie), so their account is one click away. Opening the same link again shows
// the Carinova ID but signs nobody in.
import { Icon } from 'astro-icon/components';
import CtaGroup from '~/components/carinova/CtaGroup.astro';
import UsAddressCard from '~/components/carinova/UsAddressCard.astro';
import Restrictions from '~/components/carinova/Restrictions.astro';
import WhatsAppHelp from '~/components/carinova/WhatsAppHelp.astro';
import { CONFIRM_LINK_HOURS } from '~/data/signup';
import { i18n } from '~/i18n';

const { locale, href, data } = i18n(Astro);
const { CTA, WA_MESSAGES } = data;

const t = {
  es: {
    readyTitle: 'Confirmá tu correo',
    readyText:
      'Un paso más: confirmá tu correo para crear tu cuenta y ver tu Carinova ID y tu dirección en Estados Unidos.',
    confirm: 'Confirmar y crear mi cuenta',
    confirming: 'Creando tu cuenta…',
    noscript: 'Para confirmar tu correo necesitás activar JavaScript en tu navegador.',
    doneTitle: '¡Tu cuenta está lista!',
    doneIntro: 'Este es tu Carinova ID. Guardalo: con él identificamos tu cuenta.',
    emailed: 'También te enviamos estos datos por correo.',
    beforeTitle: 'Antes de comprar',
    beforeText: 'Revisá lo que no podemos traer.',
    nextTitle: '¿Y ahora?',
    nextText: 'Cotizá tu primer envío o mirá cómo funciona, con ejemplos.',
    howToBuy: 'Ver cómo funciona',
    signedIn:
      'Ya ingresaste en este navegador: en tu cuenta encontrás siempre tu Carinova ID, tu dirección, tus paquetes y tus pagos.',
    signedOut: 'Para ver estos datos cuando quieras, ingresá a tu cuenta con tu correo.',
    invalidTitle: 'Este enlace no es válido',
    invalidText: 'Puede que esté incompleto. Abrilo otra vez desde el correo que te mandamos o registrate de nuevo.',
    expiredTitle: 'Este enlace ya venció',
    expiredText: `Los enlaces de confirmación duran ${CONFIRM_LINK_HOURS} horas. Registrate de nuevo y te mandamos otro.`,
    signupAgain: 'Registrarme de nuevo',
    errorTitle: 'No pudimos crear tu cuenta',
    errorText: 'El problema es nuestro, no tuyo. Intentalo de nuevo y, si sigue fallando, escribinos por WhatsApp.',
    retry: 'Intentar de nuevo',
    retrying: 'Intentando…',
    // For the script.
    existingTitle: 'Ya tenés una cuenta',
    existingIntro: 'Este correo ya tiene una cuenta en Carinova. Este es tu Carinova ID:',
    documentTitle: 'Tu cuenta {code} | Carinova',
  },
  en: {
    readyTitle: 'Confirm your e-mail',
    readyText:
      'One more step: confirm your e-mail to create your account and see your Carinova ID and your address in the United States.',
    confirm: 'Confirm and create my account',
    confirming: 'Creating your account…',
    noscript: 'To confirm your e-mail you need to turn on JavaScript in your browser.',
    doneTitle: 'Your account is ready!',
    doneIntro: 'This is your Carinova ID. Keep it: it is how we identify your account.',
    emailed: 'We also sent you these details by e-mail.',
    beforeTitle: 'Before you buy',
    beforeText: 'Check what we cannot bring.',
    nextTitle: 'What now?',
    nextText: 'Get a quote for your first shipment or see how it works, with examples.',
    howToBuy: 'See how it works',
    signedIn:
      'You are signed in on this browser: your account always has your Carinova ID, your address, your packages and your payments.',
    signedOut: 'To see these details whenever you want, sign in to your account with your e-mail.',
    invalidTitle: 'This link is not valid',
    invalidText: 'It may be incomplete. Open it again from the e-mail we sent you, or sign up again.',
    expiredTitle: 'This link has expired',
    expiredText: `Confirmation links last ${CONFIRM_LINK_HOURS} hours. Sign up again and we will send you another one.`,
    signupAgain: 'Sign up again',
    errorTitle: 'We could not create your account',
    errorText: 'The problem is on our side, not yours. Try again and, if it keeps failing, write to us on WhatsApp.',
    retry: 'Try again',
    retrying: 'Trying…',
    existingTitle: 'You already have an account',
    existingIntro: 'This e-mail already has a Carinova account. This is your Carinova ID:',
    documentTitle: 'Your account {code} | Carinova',
  },
}[locale];

// What the script writes, in the page's language; {code} is the customer's Carinova ID.
const text = {
  existingTitle: t.existingTitle,
  existingIntro: t.existingIntro,
  documentTitle: t.documentTitle,
  whatsapp: WA_MESSAGES.customer('{code}'),
};

const signupUrl = href(CTA.signup.path);

const messageClass = 'mx-auto max-w-xl px-4 py-16 text-center md:py-24';
const titleClass = 'mt-5 font-heading text-3xl font-bold text-heading outline-none md:text-4xl';
const textClass = 'mt-4 text-lg text-muted';
const linkClass = 'inline-flex min-h-11 items-center font-semibold text-link underline underline-offset-4';
---

<cn-confirm class="block" data-text={JSON.stringify(text)}>
  <section data-cn-state="ready" class={messageClass}>
    <Icon name="tabler:mail-check" class="mx-auto h-14 w-14 text-primary" />
    <h1 class={titleClass} tabindex="-1">{t.readyTitle}</h1>
    <p class={textClass}>{t.readyText}</p>
    <button type="button" class="btn-primary mt-8 w-full sm:w-auto" data-cn-confirm data-busy-label={t.confirming}>
      {t.confirm}
    </button>
    <noscript>
      <p class="mt-6 rounded-xl bg-amber-100 p-4 text-sm text-amber-950">{t.noscript}</p>
    </noscript>
  </section>

  <section data-cn-state="done" class="mx-auto max-w-3xl px-4 py-12 md:py-16" hidden>
    <div class="text-center">
      <Icon name="tabler:circle-check" class="mx-auto h-14 w-14 text-green-700" />
      <h1 class={titleClass} tabindex="-1" data-cn-done-title>{t.doneTitle}</h1>
      <p class={textClass} data-cn-done-intro>{t.doneIntro}</p>
      <p
        class="mt-6 inline-block select-all rounded-2xl bg-navy px-7 py-3 font-heading text-4xl font-extrabold tracking-wide text-white"
        data-cn-code
      >
      </p>
      <p class="mt-4 text-sm text-muted" data-cn-emailed>{t.emailed}</p>
    </div>

    <div class="mt-10">
      <UsAddressCard />
    </div>

    <div class="mt-12">
      <h2 class="text-center font-heading text-2xl font-bold text-heading">{t.beforeTitle}</h2>
      <p class="mt-2 text-center text-muted">{t.beforeText}</p>
      <div class="mt-6">
        <Restrictions headingTag="h3" />
      </div>
    </div>

    <div class="mt-10 text-center">
      <h2 class="font-heading text-2xl font-bold text-heading">{t.nextTitle}</h2>
      <p class="mt-2 text-muted">{t.nextText}</p>
      <CtaGroup class="mt-6" signup={false} />
      <p class="mt-3 flex flex-wrap items-center justify-center gap-x-6">
        <a class={linkClass} href={href('/como-comprar')}>{t.howToBuy}</a>
        {/* The script puts the customer's Carinova ID in the message (WA_MESSAGES.customer). */}
        <WhatsAppHelp message={WA_MESSAGES.accountExisting} data-cn-whatsapp />
      </p>
      <p class="mx-auto mt-6 max-w-xl text-sm text-muted" data-auth="in">
        {t.signedIn}{' '}
        <a class="font-semibold text-link underline underline-offset-4" href={href(CTA.account.path)}
          >{CTA.account.text}</a
        >
      </p>
      <p class="mx-auto mt-6 max-w-xl text-sm text-muted" data-auth="out">
        {t.signedOut}{' '}
        <a class="font-semibold text-link underline underline-offset-4" href={href(CTA.signin.path)}
          >{CTA.signin.text}</a
        >
      </p>
    </div>
  </section>

  <section data-cn-state="invalid" class={messageClass} hidden>
    <Icon name="tabler:link-off" class="mx-auto h-14 w-14 text-muted" />
    <h1 class={titleClass} tabindex="-1">{t.invalidTitle}</h1>
    <p class={textClass}>{t.invalidText}</p>
    <a class="btn-primary mt-8 w-full sm:w-auto" href={signupUrl}>{CTA.signup.text}</a>
  </section>

  <section data-cn-state="expired" class={messageClass} hidden>
    <Icon name="tabler:clock-off" class="mx-auto h-14 w-14 text-muted" />
    <h1 class={titleClass} tabindex="-1">{t.expiredTitle}</h1>
    <p class={textClass}>{t.expiredText}</p>
    <a class="btn-primary mt-8 w-full sm:w-auto" href={signupUrl}>{t.signupAgain}</a>
  </section>

  <section data-cn-state="error" class={messageClass} hidden>
    <Icon name="tabler:alert-triangle" class="mx-auto h-14 w-14 text-secondary" />
    <h1 class={titleClass} tabindex="-1">{t.errorTitle}</h1>
    <p class={textClass}>{t.errorText}</p>
    <div class="mt-8 flex flex-col items-center gap-3">
      <button type="button" class="btn-primary w-full sm:w-auto" data-cn-confirm data-busy-label={t.retrying}>
        {t.retry}
      </button>
      <WhatsAppHelp message={WA_MESSAGES.confirmHelp} />
    </div>
  </section>
</cn-confirm>

<script>
  import { CONTACT, MIAMI_ADDRESS } from '~/data/carinova';
  import { fill } from '~/utils/template';
  import { whatsappLink } from '~/utils/whatsapp';

  type State = 'ready' | 'done' | 'invalid' | 'expired' | 'error';

  interface Customer {
    code: string;
    firstName: string;
    lastName: string;
  }

  /** The sentences of the page's language (see `text` above). */
  type Text = Record<'existingTitle' | 'existingIntro' | 'documentTitle' | 'whatsapp', string>;

  class CnConfirm extends HTMLElement {
    private token = '';
    private busy = false;
    private text!: Text;

    connectedCallback() {
      this.text = JSON.parse(this.dataset.text ?? '{}');
      this.token = new URLSearchParams(window.location.search).get('token') ?? '';
      for (const button of this.querySelectorAll<HTMLButtonElement>('[data-cn-confirm]')) {
        button.addEventListener('click', () => void this.confirm());
      }
      if (!this.token) this.show('invalid', false);
    }

    private show(state: State, moveFocus = true) {
      for (const section of this.querySelectorAll<HTMLElement>('[data-cn-state]')) {
        section.hidden = section.dataset.cnState !== state;
      }
      if (!moveFocus) return;
      window.scrollTo({ top: 0 });
      this.querySelector<HTMLElement>(`[data-cn-state="${state}"] h1`)?.focus({ preventScroll: true });
    }

    private setText(selector: string, text: string) {
      const element = this.querySelector(selector);
      if (element) element.textContent = text;
    }

    private setBusy(busy: boolean) {
      this.busy = busy;
      for (const button of this.querySelectorAll<HTMLButtonElement>('[data-cn-confirm]')) {
        button.dataset.label ??= button.textContent ?? '';
        button.disabled = busy;
        button.textContent = busy ? (button.dataset.busyLabel ?? '') : button.dataset.label;
      }
    }

    private showCustomer(customer: Customer, isNew: boolean, signedIn: boolean) {
      this.setText('[data-cn-code]', customer.code);
      this.setText('[data-cn-fill="firstName"]', MIAMI_ADDRESS.firstName(customer.firstName));
      this.setText('[data-cn-fill="lastName"]', MIAMI_ADDRESS.lastName(customer.lastName));

      if (!isNew) {
        this.setText('[data-cn-done-title]', this.text.existingTitle);
        this.setText('[data-cn-done-intro]', this.text.existingIntro);
      }
      const emailed = this.querySelector<HTMLElement>('[data-cn-emailed]');
      if (emailed) emailed.hidden = !isNew;

      const whatsapp = this.querySelector<HTMLAnchorElement>('[data-cn-whatsapp]');
      if (whatsapp) whatsapp.href = whatsappLink(CONTACT.whatsapp, fill(this.text.whatsapp, { code: customer.code }));

      // The confirmation that created the account also signed the customer in: the page (header,
      // buttons) now shows what a customer sees.
      if (signedIn) document.documentElement.dataset.session = 'in';

      document.title = fill(this.text.documentTitle, { code: customer.code });
      this.show('done');
    }

    private async confirm() {
      if (this.busy) return;
      this.setBusy(true);

      let status = 0;
      let result: { ok?: boolean; isNew?: boolean; signedIn?: boolean; customer?: Customer } | null = null;
      try {
        const response = await fetch('/api/signup/confirm', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token: this.token }),
        });
        status = response.status;
        result = await response.json().catch(() => null);
      } catch {
        // No connection: shown as an error the visitor can retry.
      }
      this.setBusy(false);

      if (status === 200 && result?.ok && result.customer)
        return this.showCustomer(result.customer, result.isNew === true, result.signedIn === true);
      this.show(status === 410 ? 'expired' : status === 400 ? 'invalid' : 'error');
    }
  }

  if (!customElements.get('cn-confirm')) customElements.define('cn-confirm', CnConfirm);
</script>
