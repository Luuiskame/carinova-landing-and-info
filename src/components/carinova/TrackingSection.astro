---
// "Sabé en qué etapa va tu envío." (home page): what happens to a package between the purchase and
// the pickup, right after the three steps that lead to it. On one side the journey, drawn stage by
// stage (the same stages a customer sees in their account); on the other the tracker, with its
// switch to the article search. The page for customers who want to track a package is /rastreo.
import PackageStages from '~/components/carinova/PackageStages.astro';
import SectionHeading from '~/components/carinova/SectionHeading.astro';
import Tracker from '~/components/carinova/Tracker.astro';
import { i18n } from '~/i18n';

const { ui } = i18n(Astro);
const t = ui.tracker;
---

<section id="rastreo" class="scroll-mt-20 bg-[#f3f6fb]">
  <div
    class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 md:py-20 lg:grid-cols-[1fr_1.02fr] lg:items-center lg:gap-16 lg:py-28"
  >
    <div class="min-w-0">
      <SectionHeading number="05" eyebrow={t.eyebrow} title={t.title} />
      <p class="mt-5 max-w-xl text-base leading-relaxed text-muted sm:text-lg">{t.intro}</p>
      <PackageStages class="mt-9" label={t.stagesLabel} column />
    </div>

    <Tracker place="home" />
  </div>
</section>
