---
// Rate cards (one per shipping service) with a WhatsApp quote button each, plus the conditions.
import { Icon } from 'astro-icon/components';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { CONTACT, RATES, WA_MESSAGES } from '~/data/carinova';
import { formatUSD } from '~/utils/rates';
import { whatsappLink } from '~/utils/whatsapp';
---

<WidgetWrapper id="tarifas" containerClass="max-w-5xl">
  <Headline
    tagline="Tarifas"
    title="Precios claros, por libra"
    subtitle="Elige rapidez o ahorro. Publicamos nuestras tarifas para que sepas cuánto pagas antes de comprar."
  />
  <div class="grid gap-6 md:grid-cols-2">
    {
      RATES.services.map((service) => (
        <article class="flex flex-col rounded-2xl bg-white p-6 shadow-lg ring-1 ring-slate-200 sm:p-8">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="flex items-center gap-2 font-heading text-2xl font-bold text-heading">
              <Icon name={service.icon} class="h-7 w-7 text-primary" />
              {service.name}
            </h3>
            <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700">
              {service.transit}
            </span>
          </div>
          <p class="mt-6 flex items-baseline gap-1.5 text-heading">
            <span class="font-heading text-5xl font-extrabold tracking-tight">{formatUSD(service.pricePerLb)}</span>
            <span class="text-lg text-muted">por libra</span>
          </p>
          <p class="mt-1 text-sm text-muted">Peso mínimo: {service.minLb} lb</p>
          <ul class="mt-6 flex-1 space-y-3">
            {service.features.map((feature) => (
              <li class="flex gap-3">
                <Icon name="tabler:circle-check-filled" class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
                <span>{feature}</span>
              </li>
            ))}
          </ul>
          <a
            class="btn-primary mt-8 w-full"
            href={whatsappLink(CONTACT.whatsapp, WA_MESSAGES.service(service.name))}
            target="_blank"
            rel="noopener noreferrer"
          >
            Cotizar envío {service.name.toLowerCase()}
          </a>
        </article>
      ))
    }
  </div>
  <ul class="mx-auto mt-8 max-w-2xl space-y-1 text-center text-sm text-muted">
    {RATES.notes.map((note) => <li>{note}</li>)}
  </ul>
</WidgetWrapper>
