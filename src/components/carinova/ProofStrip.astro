---
// The strip under the home hero: three things that are true of the service (two ways of shipping,
// one route, for a person, a family or a company). No figures: the site states none it cannot back.
import { Icon } from 'astro-icon/components';
import { i18n } from '~/i18n';

const { ui } = i18n(Astro);
const t = ui.proofStrip;

// One per item, in the order of the dictionary: the two ways a package travels, the route, the people.
const ICONS = [['tabler:plane', 'tabler:ship'], ['tabler:route'], ['tabler:heart-handshake']];
---

<section class="border-b border-[#e1e7f0] bg-white" aria-label={t.label}>
  <ul class="mx-auto grid max-w-7xl px-4 sm:px-6 md:grid-cols-3">
    {
      t.items.map((item, index) => (
        <li class="flex items-center gap-4 border-[#e4eaf2] py-5 max-md:border-b max-md:last:border-b-0 md:min-h-28 md:border-e md:px-5 md:first:ps-0 md:last:border-e-0">
          <span class="flex h-12 shrink-0 items-center justify-center gap-1 rounded-xl bg-[#fff0df] px-3 text-[#b85600]">
            {ICONS[index]?.map((icon) => (
              <Icon name={icon} class="h-6 w-6" />
            ))}
          </span>
          <p>
            <strong class="block text-[0.9375rem] font-extrabold text-heading">{item.title}</strong>
            <span class="mt-0.5 block text-sm text-muted">{item.text}</span>
          </p>
        </li>
      ))
    }
  </ul>
</section>
