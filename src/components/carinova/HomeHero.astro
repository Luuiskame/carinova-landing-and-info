---
// Home hero, as in Carinova's prototype: its line, the title in two lines (the second one orange),
// the promise and two buttons. "Cotizá tu envío" leads to the calculator a little further down the
// page; "Crear cuenta" to the sign-up form (a customer who is signed in gets their account instead).
// Text only, centred, on navy: the ring at the right is decoration.
import { Icon } from 'astro-icon/components';
import { i18n } from '~/i18n';

const { href, data } = i18n(Astro);
const { CTA, HEADLINE, TAGLINE, VALUE_PROPOSITION } = data;
---

<section
  class="dark relative isolate overflow-hidden bg-[radial-gradient(ellipse_at_54%_38%,#14345c_0%,#081d3d_47%,#020d21_100%)]"
>
  <div
    class="pointer-events-none absolute top-1/2 -right-64 -z-10 h-[44rem] w-[44rem] -translate-y-1/2 rounded-full border border-cta/10 bg-[radial-gradient(circle,transparent_58%,rgb(255_138_0/0.1)_58.2%,transparent_58.7%)] max-sm:-right-60 max-sm:h-[22rem] max-sm:w-[22rem]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-5xl px-4 py-16 text-center sm:px-6 md:py-24 lg:py-28">
    <p class="eyebrow justify-center">Carinova · {TAGLINE}</p>

    <h1
      class="mx-auto mt-7 font-heading text-[clamp(3rem,8.1vw,7.5rem)] leading-[0.98] font-extrabold tracking-[-0.065em] text-balance text-white"
    >
      {HEADLINE[0]}
      <span class="block text-accent">{HEADLINE[1]}</span>
    </h1>

    <p class="mx-auto mt-7 max-w-2xl text-base leading-relaxed text-pretty text-muted sm:text-lg md:text-xl">
      {VALUE_PROPOSITION}
    </p>

    <div class="mx-auto mt-9 flex max-w-sm flex-col justify-center gap-3.5 sm:max-w-none sm:flex-row">
      <a class="btn-primary" href="#cotizador">
        {CTA.quote.text}
        <Icon name="tabler:arrow-up-right" class="h-5 w-5 shrink-0" />
      </a>
      <a class="btn" href={href(CTA.signup.path)} data-auth="out">
        {CTA.signup.text}
        <Icon name="tabler:arrow-up-right" class="h-5 w-5 shrink-0" />
      </a>
      <a class="btn" href={href(CTA.account.path)} data-auth="in">
        {CTA.account.text}
        <Icon name="tabler:arrow-up-right" class="h-5 w-5 shrink-0" />
      </a>
    </div>
  </div>
</section>
