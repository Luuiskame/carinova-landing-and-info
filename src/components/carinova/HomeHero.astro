---
// Home hero, as in Carinova's "Signature" design: on the left, the page's title (a first line that
// says what Carinova does, in the words people search for, and the brand's line in display size),
// the promise, the two calls to action and three facts; on the right, Carinova's emblem inside the
// route it covers, from the warehouse in the United States to Nicaragua. Under both, a line with the
// route and the way into the page.
//
// - The title is one <h1>: its small first line carries the keywords, its big lines the brand. The
//   last word of the headline sits on an orange stroke.
// - The emblem is the only image above the fold: it is loaded eagerly, in AVIF or WebP, at the size
//   it is shown (about 25 KB on a phone).
// - Everything else on the right is drawn with CSS and one SVG path; the labels are real text.
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import emblem from '~/assets/images/carinova-emblem.jpg';
import { i18n } from '~/i18n';

const { href, data, ui } = i18n(Astro);
const { CTA, HEADLINE, TAGLINE } = data;
const t = ui.homeHero;

// "para acá." → "para" + "acá" + ".": the last word takes the stroke and its full stop the orange.
// A language that writes the line without spaces (Chinese) gives the whole line to the stroke.
const lastLine = HEADLINE[1];
const cut = lastLine.lastIndexOf(' ');
const lead = cut < 0 ? '' : lastLine.slice(0, cut);
const accent = cut < 0 ? lastLine : lastLine.slice(cut + 1);
const stop = /[.。!！؟?]$/.test(accent) ? accent.slice(-1) : '';
const word = stop ? accent.slice(0, -1) : accent;
---

<section
  class="dark relative isolate overflow-hidden bg-navy bg-[radial-gradient(ellipse_42rem_30rem_at_83%_43%,rgb(255_138_0/0.085)_0,transparent_72%),radial-gradient(ellipse_52rem_46rem_at_70%_0%,#12305a_0,#0a2247_53%,transparent_88%)]"
>
  <div
    class="pointer-events-none absolute -top-52 -end-72 -z-10 h-[42rem] w-[42rem] rounded-full border border-cta/10 shadow-[0_0_0_9rem_rgb(255_146_43/0.014)] rtl:-left-72 rtl:right-auto"
    aria-hidden="true"
  >
  </div>

  <div
    class="mx-auto grid max-w-7xl items-center gap-x-6 gap-y-10 px-4 pt-12 pb-8 sm:px-6 md:pt-16 lg:min-h-[38rem] lg:grid-cols-[1.06fr_0.94fr] lg:pt-10 lg:pb-10"
  >
    <div class="relative z-10 min-w-0">
      <h1>
        <span class="eyebrow">{t.eyebrow}</span>{' '}
        <span class="hero-display mt-7 block">
          <span class="block">{HEADLINE[0]}</span>{' '}
          <span class="block"
            >{lead}{lead && ' '}<span class="hero-accent">{word}{stop && <span class="text-cta">{stop}</span>}</span
            ></span
          >
        </span>
      </h1>

      <p class="mt-7 max-w-xl text-base leading-relaxed text-pretty text-[#c0cde0] sm:text-lg">{t.lead}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a class="btn-primary min-h-14 px-6 text-base" href={href(CTA.signup.path)} data-auth="out">
          {CTA.signup.text}
          <Icon name="tabler:arrow-up-right" class="h-5 w-5 shrink-0" />
        </a>
        <a class="btn-primary min-h-14 px-6 text-base" href={href(CTA.account.path)} data-auth="in">
          {CTA.account.text}
          <Icon name="tabler:arrow-up-right" class="h-5 w-5 shrink-0" />
        </a>
        <a class="btn min-h-14 px-6 text-base" href="#cotizador">
          {CTA.quote.text}
          <Icon name="tabler:arrow-right" class="h-5 w-5 shrink-0" />
        </a>
      </div>

      <ul class="mt-9 flex flex-col gap-2.5 text-sm text-[#b9c8dc] sm:flex-row sm:flex-wrap sm:gap-x-6">
        {
          t.facts.map((fact) => (
            <li class="flex items-center gap-2.5">
              <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-cta/15 text-secondary">
                <Icon name="tabler:check" class="h-4 w-4" />
              </span>
              {fact}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative mx-auto grid aspect-square w-full max-w-[26rem] place-items-center lg:max-w-[34rem]">
      <div
        class="absolute inset-[11%_0] rounded-full bg-[radial-gradient(circle,rgb(255_129_17/0.15)_0,rgb(22_44_83/0.6)_43%,transparent_74%)]"
        aria-hidden="true"
      >
      </div>
      <div class="absolute w-[84%] rounded-full border border-[#fba144]/25 [aspect-ratio:1]" aria-hidden="true"></div>
      <div class="absolute w-[103%] rounded-full border border-[#fba144]/10 [aspect-ratio:1]" aria-hidden="true"></div>

      <div
        class="relative z-[1] w-[62%] overflow-hidden rounded-full border border-cta/25 bg-[#0b1630] shadow-[0_0_0_0.5rem_rgb(255_138_0/0.035),0_1.9rem_6rem_rgb(0_0_0/0.25)] [aspect-ratio:1]"
      >
        <Picture
          src={emblem}
          width={520}
          formats={['avif', 'webp']}
          widths={[260, 340, 520, 680]}
          sizes="(min-width: 64rem) 340px, 260px"
          alt={t.emblemAlt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>

      <svg
        class="pointer-events-none absolute inset-0 z-[2] h-full w-full rtl:-scale-x-100"
        viewBox="0 0 550 550"
        aria-hidden="true"
      >
        <path
          d="M107 122C420 62 140 480 457 404"
          fill="none"
          stroke="#ff961f"
          stroke-dasharray="5 10"
          stroke-linecap="round"
          stroke-width="2"
          opacity="0.8"></path>
        <circle cx="107" cy="122" r="7" fill="#ff961f"></circle>
        <circle cx="457" cy="404" r="7" fill="#ff8a00"></circle>
        <path d="m429 401 20 5-7-21" fill="none" stroke="#ff8a00" stroke-linejoin="round" stroke-width="2.5"></path>
      </svg>

      <p
        class="absolute start-0 top-[7%] z-[3] flex items-center gap-2.5 rounded-xl border border-[#3d4a65] bg-[#02132f]/95 px-3.5 py-2.5 text-white shadow-[0_1.1rem_2.5rem_rgb(0_7_23/0.25)] sm:px-5 sm:py-3"
      >
        <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-[#ff9d32] ring-[5px] ring-cta/15" aria-hidden="true"></span>
        <span>
          <span class="block text-[0.625rem] font-black tracking-[0.15em] text-[#98aac3] uppercase">{t.origin}</span>
          <strong class="text-sm">{t.originPlace}</strong>
        </span>
      </p>
      <p
        class="absolute end-0 bottom-[13%] z-[3] flex items-center gap-2.5 rounded-xl border border-[#3d4a65] bg-[#02132f]/95 px-3.5 py-2.5 text-white shadow-[0_1.1rem_2.5rem_rgb(0_7_23/0.25)] sm:px-5 sm:py-3"
      >
        <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-cta ring-[5px] ring-cta/15" aria-hidden="true"></span>
        <span>
          <span class="block text-[0.625rem] font-black tracking-[0.15em] text-[#98aac3] uppercase"
            >{t.destination}</span
          >
          <strong class="text-sm">{t.destinationPlace}</strong>
        </span>
      </p>
      <p
        class="absolute start-0 bottom-0 z-[4] flex items-center gap-3 rounded-2xl border border-[#425879] bg-[#061b3d] px-3.5 py-3 text-white shadow-[0_1.3rem_2.8rem_rgb(0_5_17/0.3)] sm:px-4"
      >
        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-cta text-navy">
          <Icon name="tabler:route" class="h-5 w-5" />
        </span>
        <span>
          <strong class="block text-[0.8125rem] leading-snug">{t.bridgeTitle}</strong>
          <span class="mt-0.5 block text-xs text-[#acbfd5]">{t.bridgeText}</span>
        </span>
      </p>
    </div>
  </div>

  <div
    class="mx-auto flex min-h-14 max-w-7xl items-center justify-between gap-4 border-t border-white/15 px-4 text-[0.6875rem] font-extrabold tracking-[0.17em] text-[#b4c0d0] uppercase sm:px-6"
  >
    <p class="flex items-center gap-2">
      {t.route[0]}
      <Icon name="tabler:arrow-right" class="h-3.5 w-3.5 text-cta" aria-hidden="true" />
      {t.route[1]}
    </p>
    <p class="hidden items-center gap-2 md:flex">
      {TAGLINE}
      <Icon name="tabler:north-star" class="h-3.5 w-3.5 text-cta" aria-hidden="true" />
    </p>
    <a class="flex min-h-11 items-center gap-1.5 text-secondary hover:text-white" href="#soluciones">
      {t.explore}
      <Icon name="tabler:arrow-down" class="h-3.5 w-3.5" aria-hidden="true" />
    </a>
  </div>
</section>
