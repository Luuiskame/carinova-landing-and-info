---
// Shown on every page while the site still has placeholder content (SITE_STATUS.isPreview).
import { Icon } from 'astro-icon/components';
import { SITE_STATUS } from '~/data/carinova';
---

{
  SITE_STATUS.isPreview && (
    <div class="bg-amber-100 px-4 py-2 text-center text-sm font-medium text-amber-950">
      <Icon name="tabler:alert-triangle" class="mr-1 inline-block h-4 w-4 align-[-3px]" />
      Vista previa: precios, direcciones y horarios son de ejemplo y están por confirmar.
    </div>
  )
}
