---
// "Tu negocio no se detiene. Nosotros tampoco." (home page): the band for companies. What Carinova
// explores with a company and the form are on /empresas, where the button leads; here only the
// invitation and three tiles that draw it (the service's name, the route, the pace). The tiles are
// decoration: the band says the same in its text.
import { Icon } from 'astro-icon/components';
import SectionHeading from '~/components/carinova/SectionHeading.astro';
import { i18n } from '~/i18n';

const { href, ui } = i18n(Astro);
const t = ui.businessBand;
---

<section
  id="empresas"
  class="dark relative isolate scroll-mt-20 overflow-hidden bg-[linear-gradient(120deg,#031530,#071d3f_75%,#0e2648)]"
>
  <div class="mx-auto grid max-w-7xl items-center gap-x-10 px-4 sm:px-6 md:grid-cols-[1.1fr_0.9fr]">
    <div class="relative z-10 py-16 md:py-20 lg:py-24">
      <SectionHeading eyebrow={t.eyebrow} title={t.title} titleClass="max-w-xl !text-[clamp(2.2rem,4vw,3.4rem)]" />
      <p class="mt-5 max-w-xl text-base leading-relaxed text-[#c1cde0] sm:text-lg">{t.intro}</p>
      <a class="btn-primary mt-8 w-full sm:w-auto" href={href('/empresas')}>
        {t.button}
        <Icon name="tabler:arrow-up-right" class="h-5 w-5 shrink-0" />
      </a>
    </div>

    <div class="relative mx-auto h-64 w-full max-w-md md:h-96" aria-hidden="true">
      <div
        class="absolute top-1/2 left-1/2 h-60 w-60 -translate-x-1/2 -translate-y-1/2 rounded-full border border-cta/35 shadow-[0_0_0_3.4rem_rgb(255_136_23/0.035),0_0_0_7.2rem_rgb(255_136_23/0.018)] md:h-[21rem] md:w-[21rem]"
      >
      </div>
      <p
        class="absolute top-[12%] start-[8%] -rotate-[8deg] rounded-2xl border border-[#3b5276] bg-[#0b254c] px-5 py-5 text-base font-extrabold tracking-[0.04em] text-white shadow-[0_1.4rem_3.75rem_rgb(0_7_24/0.23)] md:top-[24%] md:px-6 md:py-6 md:text-lg"
      >
        {t.tiles.name[0]}{' '}<span class="text-cta">{t.tiles.name[1]}</span>
      </p>
      <p
        class="absolute top-[42%] end-[4%] flex rotate-[8deg] items-center gap-2.5 rounded-2xl border border-[#3b5276] bg-[#0b254c] px-5 py-5 text-sm font-extrabold text-white shadow-[0_1.4rem_3.75rem_rgb(0_7_24/0.23)]"
      >
        <Icon name="tabler:package" class="h-5 w-5 text-[#ffae58]" />
        {t.tiles.route[0]}
        <Icon name="tabler:arrow-right" class="h-4 w-4 text-[#ffae58]" />
        {t.tiles.route[1]}
      </p>
      <p
        class="absolute bottom-[10%] start-[22%] flex -rotate-3 items-center gap-2.5 rounded-2xl border border-[#ffd2ac] bg-[#fff0e0] px-6 py-4 text-sm font-extrabold text-[#82400c] shadow-[0_1.4rem_3.75rem_rgb(0_7_24/0.23)] md:bottom-[18%]"
      >
        <Icon name="tabler:briefcase" class="h-5 w-5" />
        {t.tiles.pace}
      </p>
    </div>
  </div>
</section>
