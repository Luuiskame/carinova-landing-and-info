---
// The customer's address in Miami, as the fields of a store checkout (Carinova's "Tu dirección en
// Miami" graphic), with the notes that go under it. Shown when a sign-up is confirmed and in the
// customer's casillero.
//
// The two name rows depend on the customer, and the pages are static: the page's script fills them
// in ([data-cn-fill="firstName"] and [data-cn-fill="lastName"]) with MIAMI_ADDRESS.firstName() and
// .lastName().
import { Icon } from 'astro-icon/components';
import { i18n } from '~/i18n';

const { locale, data } = i18n(Astro);
const { MIAMI_ADDRESS, miamiAddressRows } = data;

const rows = miamiAddressRows('', '');
const personal = ['firstName', 'lastName'];

const t = {
  es: {
    title: 'Tu dirección en Miami',
    intro: 'Usala como dirección de envío cuando compres en tiendas de Estados Unidos.',
  },
  en: {
    title: 'Your address in Miami',
    intro: 'Use it as the shipping address when you buy at stores in the United States.',
  },
}[locale];
---

<div class="rounded-2xl bg-white p-6 text-left shadow-lg ring-1 ring-slate-200 sm:p-8">
  <h2 class="font-heading text-2xl font-bold text-heading">{t.title}</h2>
  <p class="mt-1 text-muted">{t.intro}</p>
  <dl class="mt-5 divide-y divide-slate-100">
    {
      rows.map((row) => (
        <div class="flex flex-col gap-0.5 py-2.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
          <dt class="text-sm text-muted">{row.label}</dt>
          <dd
            class="select-all font-semibold text-heading sm:text-right"
            data-cn-fill={personal.includes(row.id) ? row.id : undefined}
          >
            {personal.includes(row.id) ? '' : row.value}
          </dd>
        </div>
      ))
    }
  </dl>
  <ul class="mt-5 space-y-2 text-sm">
    {
      MIAMI_ADDRESS.notes.map((note) => (
        <li class="flex gap-2">
          <Icon name="tabler:info-circle" class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
          <span>{note}</span>
        </li>
      ))
    }
  </ul>
</div>
