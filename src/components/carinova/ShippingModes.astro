---
// "Dos modalidades. Un destino." (home page): the two ways a package travels, one card each, with
// what it is for, its base rate and its delivery estimate. The foot of each card opens the
// calculator of this page on that rate; "Ver detalle" leads to the service on /servicios, which owns
// its description. Under the cards, the conditions that go with every rate (RATES.notes).
import { Icon } from 'astro-icon/components';
import SectionHeading from '~/components/carinova/SectionHeading.astro';
import { LOCALE_INFO, i18n } from '~/i18n';
import { formatUSD } from '~/utils/rates';

const { locale, href, data, ui } = i18n(Astro);
// Between two sentences: a space, or nothing in Chinese.
const gap = LOCALE_INFO[locale].wordGap;
const { RATES, SERVICES } = data;
const { air, sea } = RATES;
const t = ui.shippingModes;

/** "US$6.50" → ["US$", "6.50"]: the currency is set smaller than the amount. */
const amount = (value: number) => {
  const text = formatUSD(value);
  const at = text.search(/\d/);
  return { currency: text.slice(0, at), number: text.slice(at) };
};

const modes = [
  { rate: air, text: t.air, extra: t.electronics, sea: false },
  { rate: sea, text: t.sea, extra: t.orPerCubicFoot(formatUSD(sea.pricePerCubicFoot)), sea: true },
].map((mode) => ({
  ...mode,
  price: amount(mode.rate.pricePerLb),
  service: SERVICES.find((item) => item.id === mode.rate.id)!,
  // The calculator of this page, on this rate: it reads the address (QuoteCalculator.astro).
  calculator: href(`/?tarifa=${mode.rate.id}#cotizador`),
}));
---

<section id="tarifas" class="scroll-mt-20 bg-[linear-gradient(180deg,#eff3fa_0%,#f5f7fb_100%)]">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-20 lg:py-28">
    <SectionHeading number="02" eyebrow={t.eyebrow} title={t.title} aside={t.intro} center />

    <div class="mt-11 grid gap-5 md:grid-cols-2 md:gap-6">
      {
        modes.map((mode) => (
          <article
            id={`modalidad-${mode.rate.id}`}
            class:list={[
              'relative flex flex-col overflow-hidden rounded-[1.4rem] border border-[#dfe6f0] bg-white shadow-[0_1.05rem_2.8rem_rgb(5_26_59/0.06)] transition duration-300 before:absolute before:inset-x-0 before:top-0 before:h-1 hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0',
              mode.sea ? 'before:bg-[#1b4173]' : 'before:bg-cta',
            ]}
          >
            <div class="flex flex-1 flex-col p-6 sm:p-9">
              <div class="flex items-center justify-between gap-3">
                <span
                  class:list={[
                    'grid h-[3.75rem] w-[3.75rem] shrink-0 place-items-center rounded-2xl',
                    mode.sea ? 'bg-[#e7eef9] text-[#174575]' : 'bg-[#fff0de] text-[#b85600]',
                  ]}
                >
                  <Icon name={mode.rate.icon} class="h-8 w-8" />
                </span>
                <span class="rounded-full bg-[#f2f4f9] px-3 py-1.5 text-[0.6875rem] font-black tracking-[0.07em] text-[#56657c] uppercase">
                  {mode.text.tag}
                </span>
              </div>

              <p
                class:list={[
                  'mt-7 text-xs font-black tracking-[0.18em] uppercase',
                  mode.sea ? 'text-[#315781]' : 'text-secondary',
                ]}
              >
                {mode.text.overline}
              </p>
              <h3 class="mt-2 max-w-sm font-heading text-[1.9rem] leading-[1.12] font-extrabold tracking-[-0.045em] text-heading">
                {mode.text.title}
              </h3>
              <p class="mt-3 mb-7 max-w-sm text-base leading-relaxed text-muted">{mode.text.text}</p>

              <dl class="mt-auto flex flex-wrap items-end justify-between gap-x-6 gap-y-5 border-t border-[#e3e9f1] pt-6">
                <div>
                  <dt class="text-[0.6875rem] font-extrabold tracking-[0.12em] text-[#56657c] uppercase">
                    {t.baseRate}
                  </dt>
                  <dd class="mt-1.5 font-heading text-[3.1rem] leading-none font-extrabold tracking-[-0.055em] text-navy tabular-nums">
                    {/* "US$ 6.50/lb" keeps its order in a page written from right to left. */}
                    <span dir="ltr">
                      <span class="me-1 text-lg tracking-normal text-secondary">{mode.price.currency}</span>
                      {mode.price.number}
                      <span class="text-lg font-semibold tracking-normal text-[#56657c]">{t.perPound}</span>
                    </span>
                  </dd>
                  {mode.extra && <dd class="mt-1.5 text-sm font-semibold text-[#56657c]">{mode.extra}</dd>}
                </div>
                <div class="flex items-center gap-3 border-[#e3e9f1] sm:border-s sm:ps-6">
                  <Icon
                    name="tabler:clock"
                    class:list={['h-6 w-6 shrink-0', mode.sea ? 'text-[#315e92]' : 'text-[#b85600]']}
                  />
                  <div>
                    <dt class="sr-only">{t.delivery}</dt>
                    <dd class="text-base font-extrabold text-heading">{mode.rate.transit}</dd>
                    <dd class="text-xs text-[#56657c]" aria-hidden="true">
                      {t.delivery}
                    </dd>
                  </div>
                </div>
              </dl>
              <a
                class="mt-4 inline-flex min-h-11 items-center gap-1.5 self-start text-sm font-semibold text-link underline underline-offset-4"
                href={href(`/servicios#${mode.rate.id}`)}
              >
                {t.details(mode.rate.name)}
              </a>
            </div>

            <a
              class:list={[
                'flex min-h-16 items-center justify-between gap-4 px-6 text-sm font-extrabold transition sm:px-9',
                mode.sea
                  ? 'bg-[#eaf0f9] text-[#193f70] hover:bg-[#dbe7f6]'
                  : 'bg-[#fff0e2] text-[#8c4600] hover:bg-[#ffe4ca]',
              ]}
              href={mode.calculator}
            >
              {mode.service.link?.text}
              <Icon name="tabler:arrow-right" class="h-5 w-5 shrink-0" />
            </a>
          </article>
        ))
      }
    </div>

    <p class="mx-auto mt-8 flex max-w-4xl gap-3 text-sm leading-relaxed text-[#56657c]">
      <Icon name="tabler:info-circle" class="mt-0.5 h-5 w-5 shrink-0" />
      <span><b class="text-heading">{t.important}</b>{gap}{RATES.notes.join(gap)}</span>
    </p>
  </div>
</section>
