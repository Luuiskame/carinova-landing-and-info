---
// "Mi cuenta" on the home page: the three parts of a Carinova account (ACCOUNT_PARTS), the sign-up
// button, a link to /mi-cuenta and, for companies, a link to their own page.
import { Icon } from 'astro-icon/components';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import CtaGroup from '~/components/carinova/CtaGroup.astro';
import { i18n } from '~/i18n';

const { locale, href, data } = i18n(Astro);
const { ACCOUNT_PARTS } = data;

const t = {
  es: {
    tagline: 'Mi cuenta',
    title: 'Un Carinova ID para todos tus envíos',
    subtitle:
      'Al abrir tu casillero recibís tu Carinova ID y tu dirección en Estados Unidos, y retirás en la sucursal que te quede más cerca.',
    more: 'Conocé tu cuenta',
    company: '¿Comprás para tu empresa?',
    companyLink: 'Conocé Carinova para empresas',
  },
  en: {
    tagline: 'My account',
    title: 'One Carinova ID for all your shipments',
    subtitle:
      'When you open your mailbox you get your Carinova ID and your address in the United States, and you pick up at the branch closest to you.',
    more: 'Get to know your account',
    company: 'Buying for your company?',
    companyLink: 'See Carinova for companies',
  },
}[locale];

const linkClass = 'font-semibold text-link underline underline-offset-4';
---

<WidgetWrapper id="mi-cuenta" containerClass="max-w-6xl" bg='<div class="absolute inset-0 bg-slate-50"></div>'>
  <Headline tagline={t.tagline} title={t.title} subtitle={t.subtitle} />
  <ul class="grid gap-5 md:grid-cols-3">
    {
      ACCOUNT_PARTS.map((part) => (
        <li class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
          <Icon name={part.icon} class="h-8 w-8 text-primary" />
          <h3 class="mt-4 font-heading text-lg font-bold text-heading">{part.title}</h3>
          <p class="mt-1 text-muted">{part.summary}</p>
        </li>
      ))
    }
  </ul>
  <div class="mt-10 flex flex-col items-center gap-4">
    <CtaGroup quote={false} />
    <a class={linkClass} href={href('/mi-cuenta')}>{t.more}</a>
    <p class="flex flex-wrap justify-center gap-x-1.5 text-muted">
      <span>{t.company}</span>
      <a class={linkClass} href={href('/empresas')}>{t.companyLink}</a>
    </p>
  </div>
</WidgetWrapper>
