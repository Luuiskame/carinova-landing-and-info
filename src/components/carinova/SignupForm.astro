---
// Sign-up form (/registro). Its fields follow Carinova's address sheet (country, name, last name,
// phone, address, apt/suite, city, state, postal code) plus the e-mail that gets confirmed.
// The script posts it to /api/signup, which validates it and e-mails the confirmation link
// (worker/api.ts); the options, the rules per country and the examples shown as placeholders come
// from src/data/signup.ts. The form says which language it was filled in (`lang`), so the errors and
// the e-mails come back in that language.
import { Icon } from 'astro-icon/components';
import WhatsAppHelp from '~/components/carinova/WhatsAppHelp.astro';
import { CONFIRM_LINK_HOURS, SIGNUP_NAME_EXAMPLES } from '~/data/signup';
import { i18n } from '~/i18n';

const { locale, href, data } = i18n(Astro);
const { CTA, SIGNUP_COUNTRIES, WA_MESSAGES } = data;

const [initial] = SIGNUP_COUNTRIES;

const t = {
  es: {
    signedIn: 'Ya tenés un casillero abierto en este navegador.',
    title: 'Tus datos',
    intro: 'Te toma un par de minutos.',
    noscript:
      'Para registrarte en línea necesitás activar JavaScript en tu navegador. También podés abrir tu casillero por WhatsApp.',
    country: 'País',
    firstName: 'Nombre',
    lastName: 'Apellido',
    email: 'Correo electrónico',
    emailHint: 'Te enviaremos un enlace para confirmar tu cuenta.',
    phone: 'Teléfono',
    phoneHint: 'De preferencia, el número que usás en WhatsApp.',
    address1: 'Dirección',
    address2: 'Apto / Suite',
    optional: '(opcional)',
    city: 'Ciudad',
    choose: 'Elegí uno',
    postalCode: 'Código postal',
    honeypot: 'Dejá este campo vacío',
    sending: 'Enviando…',
    afterSubmit: 'Al enviar, te mandamos un correo para confirmar tu cuenta.',
    sentTitle: 'Revisá tu correo',
    sentNotes: [
      'Puede tardar un par de minutos en llegar.',
      'Si no lo ves, revisá la carpeta de spam o correo no deseado.',
      `El enlace vence en ${CONFIRM_LINK_HOURS} horas.`,
    ],
    edit: '¿Escribiste mal tu correo? Corregilo',
    // For the script.
    messages: {
      missing: 'Completá este campo.',
      terms: 'Para continuar, aceptá los términos y la política de privacidad.',
      unavailable:
        'El registro en línea no está disponible en este momento. Escribinos por WhatsApp y abrimos tu casillero.',
      busy: 'Recibimos demasiados intentos seguidos. Esperá un minuto y volvé a intentarlo.',
      failed: 'No pudimos enviar tu registro. Revisá tu conexión e intentalo de nuevo, o escribinos por WhatsApp.',
      oneError: 'Hay un campo por corregir.',
      manyErrors: 'Hay {count} campos por corregir.',
    },
  },
  en: {
    signedIn: 'You already have a mailbox open on this browser.',
    title: 'Your details',
    intro: 'It takes a couple of minutes.',
    noscript:
      'To sign up online you need to turn on JavaScript in your browser. You can also open your mailbox through WhatsApp.',
    country: 'Country',
    firstName: 'First name',
    lastName: 'Last name',
    email: 'E-mail',
    emailHint: 'We will send you a link to confirm your account.',
    phone: 'Phone',
    phoneHint: 'Preferably the number you use on WhatsApp.',
    address1: 'Address',
    address2: 'Apt / Suite',
    optional: '(optional)',
    city: 'City',
    choose: 'Choose one',
    postalCode: 'Postal code',
    honeypot: 'Leave this field empty',
    sending: 'Sending…',
    afterSubmit: 'When you submit, we send you an e-mail to confirm your account.',
    sentTitle: 'Check your e-mail',
    sentNotes: [
      'It can take a couple of minutes to arrive.',
      'If you do not see it, check your spam or junk folder.',
      `The link expires in ${CONFIRM_LINK_HOURS} hours.`,
    ],
    edit: 'Wrong e-mail? Correct it',
    messages: {
      missing: 'Fill in this field.',
      terms: 'To continue, accept the terms and the privacy policy.',
      unavailable: 'Online sign-up is not available right now. Write to us on WhatsApp and we will open your mailbox.',
      busy: 'We received too many attempts in a row. Wait a minute and try again.',
      failed: 'We could not send your sign-up. Check your connection and try again, or write to us on WhatsApp.',
      oneError: 'There is one field to correct.',
      manyErrors: 'There are {count} fields to correct.',
    },
  },
}[locale];

const labelClass = 'block text-sm font-semibold text-slate-700';
const inputClass =
  'mt-1.5 block w-full rounded-xl border-2 border-slate-200 bg-white px-3 py-2.5 text-base text-[#011028] outline-none transition placeholder:text-slate-400 focus:border-[#053A86] aria-[invalid=true]:border-red-600';
const hintClass = 'mt-1 text-xs text-slate-500';
const errorClass = 'mt-1 text-sm font-medium text-red-700';
const legalLinkClass = 'font-medium text-link underline';
---

<cn-signup class="block" data-messages={JSON.stringify(t.messages)}>
  <p
    class="mb-4 flex flex-wrap items-center gap-x-2 rounded-xl bg-green-50 p-4 text-sm text-green-950 ring-1 ring-green-200"
    data-auth="in"
  >
    <Icon name="tabler:circle-check" class="h-5 w-5 shrink-0 text-green-700" />
    <span>{t.signedIn}</span>
    <a class="font-semibold text-link underline underline-offset-4" href={href(CTA.mailbox.path)}>{CTA.mailbox.text}</a>
  </p>

  <!--
    method="dialog" with no <dialog> around it: submitting does nothing by itself, so if the script
    has not loaded yet the form neither reloads the page nor puts personal data in the address bar.
  -->
  <form
    method="dialog"
    novalidate
    class="rounded-2xl bg-white p-5 text-left text-slate-800 shadow-xl ring-1 ring-slate-200 sm:p-8"
  >
    <h2 class="font-heading text-2xl font-bold text-[#011028]">{t.title}</h2>
    <p class="mt-1 text-sm text-slate-600">{t.intro}</p>

    <noscript>
      <p class="mt-4 rounded-xl bg-amber-100 p-4 text-sm text-amber-950">{t.noscript}</p>
    </noscript>

    <input type="hidden" name="lang" value={locale} />

    <div class="mt-6 grid gap-x-4 gap-y-5 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <label for="cn-country" class={labelClass}>{t.country}</label>
        <select
          id="cn-country"
          name="country"
          autocomplete="country"
          required
          class={inputClass}
          aria-describedby="cn-country-error"
        >
          {
            SIGNUP_COUNTRIES.map((country) => (
              <option
                value={country.code}
                data-examples={JSON.stringify(country.examples)}
                data-postal-required={country.postalCode.required ? '' : undefined}
              >
                {country.name}
              </option>
            ))
          }
        </select>
        <p id="cn-country-error" class={errorClass} hidden></p>
      </div>

      <div>
        <label for="cn-firstName" class={labelClass}>{t.firstName}</label>
        <input
          id="cn-firstName"
          name="firstName"
          type="text"
          autocomplete="given-name"
          required
          maxlength="60"
          placeholder={SIGNUP_NAME_EXAMPLES.firstName}
          class={inputClass}
          aria-describedby="cn-firstName-error"
        />
        <p id="cn-firstName-error" class={errorClass} hidden></p>
      </div>

      <div>
        <label for="cn-lastName" class={labelClass}>{t.lastName}</label>
        <input
          id="cn-lastName"
          name="lastName"
          type="text"
          autocomplete="family-name"
          required
          maxlength="60"
          placeholder={SIGNUP_NAME_EXAMPLES.lastName}
          class={inputClass}
          aria-describedby="cn-lastName-error"
        />
        <p id="cn-lastName-error" class={errorClass} hidden></p>
      </div>

      <div>
        <label for="cn-email" class={labelClass}>{t.email}</label>
        <input
          id="cn-email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          required
          maxlength="254"
          placeholder={SIGNUP_NAME_EXAMPLES.email}
          class={inputClass}
          aria-describedby="cn-email-hint cn-email-error"
        />
        <p id="cn-email-hint" class={hintClass}>{t.emailHint}</p>
        <p id="cn-email-error" class={errorClass} hidden></p>
      </div>

      <div>
        <label for="cn-phone" class={labelClass}>{t.phone}</label>
        <input
          id="cn-phone"
          name="phone"
          type="tel"
          inputmode="tel"
          autocomplete="tel"
          required
          maxlength="30"
          placeholder={initial.examples.phone}
          class={inputClass}
          aria-describedby="cn-phone-hint cn-phone-error"
        />
        <p id="cn-phone-hint" class={hintClass}>{t.phoneHint}</p>
        <p id="cn-phone-error" class={errorClass} hidden></p>
      </div>

      <div class="sm:col-span-2">
        <label for="cn-address1" class={labelClass}>{t.address1}</label>
        <input
          id="cn-address1"
          name="address1"
          type="text"
          autocomplete="address-line1"
          required
          maxlength="120"
          placeholder={initial.examples.address1}
          class={inputClass}
          aria-describedby="cn-address1-error"
        />
        <p id="cn-address1-error" class={errorClass} hidden></p>
      </div>

      <div>
        <label for="cn-address2" class={labelClass}>
          {t.address2}{' '}
          <span class="font-normal text-slate-500">{t.optional}</span>
        </label>
        <input
          id="cn-address2"
          name="address2"
          type="text"
          autocomplete="address-line2"
          maxlength="60"
          placeholder={initial.examples.address2}
          class={inputClass}
          aria-describedby="cn-address2-error"
        />
        <p id="cn-address2-error" class={errorClass} hidden></p>
      </div>

      <div>
        <label for="cn-city" class={labelClass}>{t.city}</label>
        <input
          id="cn-city"
          name="city"
          type="text"
          autocomplete="address-level2"
          required
          maxlength="60"
          placeholder={initial.examples.city}
          class={inputClass}
          aria-describedby="cn-city-error"
        />
        <p id="cn-city-error" class={errorClass} hidden></p>
      </div>

      {
        /* One list per country; the script shows the one of the chosen country and disables the rest. */
        SIGNUP_COUNTRIES.map((country) => (
          <div data-cn-states={country.code} hidden={country !== initial}>
            <label for={`cn-state-${country.code}`} class={labelClass}>
              {country.stateLabel}
            </label>
            <select
              id={`cn-state-${country.code}`}
              name="state"
              autocomplete="address-level1"
              required
              disabled={country !== initial}
              class={inputClass}
              aria-describedby={`cn-state-${country.code}-error`}
            >
              <option value="">{t.choose}</option>
              {country.states.map((state) => (
                <option value={state}>{state}</option>
              ))}
            </select>
            <p id={`cn-state-${country.code}-error`} class={errorClass} hidden />
          </div>
        ))
      }

      <div>
        <label for="cn-postalCode" class={labelClass}>
          {t.postalCode}{' '}
          <span class="font-normal text-slate-500" data-cn-postal-optional hidden={initial.postalCode.required}>
            {t.optional}
          </span>
        </label>
        <input
          id="cn-postalCode"
          name="postalCode"
          type="text"
          autocomplete="postal-code"
          required={initial.postalCode.required}
          maxlength="10"
          placeholder={initial.examples.postalCode}
          class={inputClass}
          aria-describedby="cn-postalCode-error"
        />
        <p id="cn-postalCode-error" class={errorClass} hidden></p>
      </div>

      <div class="sm:col-span-2">
        <label class="flex items-start gap-3 text-sm text-slate-700">
          <input
            type="checkbox"
            name="terms"
            required
            class="mt-0.5 h-5 w-5 shrink-0 accent-[#053A86]"
            aria-describedby="cn-terms-error"
          />
          {/* Explicit spaces: line breaks between text and tags are dropped from the output. */}
          {
            locale === 'en' ? (
              <span>
                I accept the{' '}
                <a class={legalLinkClass} href={href('/terminos')} target="_blank" rel="noopener">
                  Terms and conditions
                </a>{' '}
                and the{' '}
                <a class={legalLinkClass} href={href('/privacidad')} target="_blank" rel="noopener">
                  Privacy policy
                </a>
                .
              </span>
            ) : (
              <span>
                Acepto los{' '}
                <a class={legalLinkClass} href={href('/terminos')} target="_blank" rel="noopener">
                  Términos y condiciones
                </a>{' '}
                y la{' '}
                <a class={legalLinkClass} href={href('/privacidad')} target="_blank" rel="noopener">
                  Política de privacidad
                </a>
                .
              </span>
            )
          }
        </label>
        <p id="cn-terms-error" class={errorClass} hidden></p>
      </div>

      <!-- Honeypot: people never see or reach this field; whatever fills it is not a person. -->
      <div class="hidden" aria-hidden="true">
        <label for="cn-contact-time">{t.honeypot}</label>
        <input id="cn-contact-time" name="contact_time" type="text" tabindex="-1" autocomplete="off" />
      </div>
    </div>

    <div
      class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-900"
      role="alert"
      data-cn-alert
      hidden
    >
      <p data-cn-alert-text></p>
      <WhatsAppHelp class="mt-1" message={WA_MESSAGES.signupHelp} />
    </div>
    <p class="sr-only" aria-live="polite" data-cn-status></p>

    <button type="submit" class="btn-primary mt-6 w-full" data-cn-submit data-busy-label={t.sending}>
      {CTA.signup.text}
    </button>
    <p class="mt-3 text-center text-xs text-slate-500">{t.afterSubmit}</p>
  </form>

  <div
    class="rounded-2xl bg-white p-6 text-left text-slate-800 shadow-xl ring-1 ring-slate-200 sm:p-8"
    data-cn-sent
    hidden
  >
    <Icon name="tabler:mail-check" class="h-12 w-12 text-primary" />
    <h2 class="mt-4 font-heading text-2xl font-bold text-[#011028] outline-none" tabindex="-1" data-cn-sent-title>
      {t.sentTitle}
    </h2>
    {
      locale === 'en' ? (
        <p class="mt-3">
          We sent a link to <strong class="break-all" data-cn-sent-email />. Open it to confirm your account and get
          your Carinova ID and your address in Miami.
        </p>
      ) : (
        <p class="mt-3">
          Te mandamos un enlace a <strong class="break-all" data-cn-sent-email />. Abrilo para confirmar tu cuenta y
          recibir tu Carinova ID y tu dirección en Miami.
        </p>
      )
    }
    <ul class="mt-4 list-disc space-y-1.5 pl-5 text-sm text-slate-600">
      {t.sentNotes.map((note) => <li>{note}</li>)}
    </ul>
    <button type="button" class="mt-6 text-sm font-semibold text-link underline" data-cn-edit>{t.edit}</button>
  </div>
</cn-signup>

<script>
  import { clearError, missingFields, postJson, setBusy, showErrors, type Control } from '~/utils/forms';
  import { fill } from '~/utils/template';

  /** The sentences of the page's language (see `messages` above). */
  type Messages = Record<'missing' | 'terms' | 'unavailable' | 'busy' | 'failed' | 'oneError' | 'manyErrors', string>;

  class CnSignup extends HTMLElement {
    private form!: HTMLFormElement;
    private messages!: Messages;
    private busy = false;

    connectedCallback() {
      const form = this.querySelector('form');
      if (!form) return;
      this.form = form;
      this.messages = JSON.parse(this.dataset.messages ?? '{}');

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        void this.submit();
      });
      form.addEventListener('input', (event) => clearError(event.target as Control));
      form.addEventListener('change', (event) => {
        const control = event.target as Control;
        if (control.name === 'country') this.applyCountry();
        clearError(control);
      });
      this.querySelector('[data-cn-edit]')?.addEventListener('click', () => this.showForm());

      // Browsers can restore the previous choice when coming back to the page.
      this.applyCountry();
    }

    /** State list, postal code rule and placeholders of the chosen country. */
    private applyCountry() {
      const select = this.form.querySelector<HTMLSelectElement>('select[name="country"]');
      const option = select?.selectedOptions[0];
      if (!select || !option) return;

      for (const group of this.querySelectorAll<HTMLElement>('[data-cn-states]')) {
        const active = group.dataset.cnStates === select.value;
        group.hidden = !active;
        const states = group.querySelector('select');
        if (states) states.disabled = !active;
      }

      const postal = this.form.querySelector<HTMLInputElement>('input[name="postalCode"]');
      const optional = this.querySelector<HTMLElement>('[data-cn-postal-optional]');
      const required = option.dataset.postalRequired !== undefined;
      if (postal) {
        postal.required = required;
        clearError(postal);
      }
      if (optional) optional.hidden = required;

      // The examples are keyed by field name (src/data/signup.ts).
      const examples = JSON.parse(option.dataset.examples ?? '{}') as Record<string, string>;
      for (const [name, example] of Object.entries(examples)) {
        const input = this.form.querySelector<HTMLInputElement>(`input[name="${name}"]`);
        if (input) input.placeholder = example;
      }
    }

    private showErrors(fields: Record<string, string>) {
      const count = showErrors(this.form, fields);
      const status = this.querySelector('[data-cn-status]');
      if (status) {
        status.textContent = count === 1 ? this.messages.oneError : fill(this.messages.manyErrors, { count });
      }
    }

    private showAlert(message: string | null) {
      const alert = this.querySelector<HTMLElement>('[data-cn-alert]');
      const text = this.querySelector('[data-cn-alert-text]');
      if (!alert || !text) return;
      text.textContent = message ?? '';
      alert.hidden = message === null;
    }

    private showSent(email: string) {
      const panel = this.querySelector<HTMLElement>('[data-cn-sent]');
      const address = this.querySelector('[data-cn-sent-email]');
      if (!panel || !address) return;
      address.textContent = email;
      this.form.hidden = true;
      panel.hidden = false;
      this.querySelector<HTMLElement>('[data-cn-sent-title]')?.focus();
      panel.scrollIntoView({ block: 'center' });
    }

    private showForm() {
      const panel = this.querySelector<HTMLElement>('[data-cn-sent]');
      if (panel) panel.hidden = true;
      this.form.hidden = false;
      this.form.querySelector<HTMLInputElement>('input[name="email"]')?.focus();
    }

    private async submit() {
      if (this.busy) return;
      this.showAlert(null);
      const { messages } = this;

      // Only "is it filled in" is checked here; the rules live on the server (worker/signup/validate.ts).
      const missing = missingFields(this.form, messages.missing, { terms: messages.terms });
      if (Object.keys(missing).length > 0) return this.showErrors(missing);

      const data = new FormData(this.form);
      const body = { ...Object.fromEntries(data), terms: data.get('terms') === 'on' };
      const button = this.querySelector<HTMLButtonElement>('[data-cn-submit]');

      this.busy = true;
      setBusy(button, true);
      const { status, result } = await postJson('/api/signup', body);
      this.busy = false;
      setBusy(button, false);

      if (status === 200 && result?.ok) return this.showSent(String(data.get('email') ?? '').trim());
      if (status === 422 && result?.fields) return this.showErrors(result.fields);
      this.showAlert(status === 503 ? messages.unavailable : status === 429 ? messages.busy : messages.failed);
    }
  }

  if (!customElements.get('cn-signup')) customElements.define('cn-signup', CnSignup);
</script>
