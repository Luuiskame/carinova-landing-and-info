---
// The end of the home page: "Así de simple." on navy, with the two calls to action. A customer who
// is signed in gets their account in the place of "Crear cuenta". The rings are decoration.
import { Icon } from 'astro-icon/components';
import { i18n } from '~/i18n';

const { href, data, ui } = i18n(Astro);
const { CTA, TAGLINE } = data;
const t = ui.homeClosing;
---

<section
  class="dark relative isolate overflow-hidden bg-navy bg-[radial-gradient(ellipse_43rem_29rem_at_50%_25%,#0f2b55_0,transparent_78%)]"
>
  <div
    class="pointer-events-none absolute -top-[28rem] left-1/2 -z-10 h-[53rem] w-[53rem] -translate-x-1/2 rounded-full border border-cta/15 shadow-[0_0_0_8rem_rgb(255_131_16/0.018),0_0_0_16rem_rgb(255_131_16/0.012)]"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 pt-20 pb-16 text-center sm:px-6 md:pt-28 md:pb-20">
    <Icon name="tabler:north-star" class="mx-auto h-14 w-14 text-cta" aria-hidden="true" />
    <p class="eyebrow mt-7 justify-center">{t.eyebrow}</p>
    <h2
      class="mt-5 font-heading text-[clamp(3.75rem,9vw,6.9rem)] leading-[0.98] font-extrabold tracking-[-0.07em] text-balance text-white"
    >
      {t.title[0]}{' '}<em class="cn-em">{t.title[1]}</em>
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-[#c5cede] sm:text-lg">{t.text}</p>

    <div class="mx-auto mt-8 flex max-w-sm flex-col justify-center gap-3 sm:max-w-none sm:flex-row">
      <a class="btn-primary min-h-14 px-6 text-base" href={href(CTA.signup.path)} data-auth="out">
        {CTA.signup.text}
        <Icon name="tabler:arrow-up-right" class="h-5 w-5 shrink-0" />
      </a>
      <a class="btn-primary min-h-14 px-6 text-base" href={href(CTA.account.path)} data-auth="in">
        {CTA.account.text}
        <Icon name="tabler:arrow-up-right" class="h-5 w-5 shrink-0" />
      </a>
      <a class="btn min-h-14 px-6 text-base" href="#cotizador">
        {CTA.quote.text}
        <Icon name="tabler:arrow-right" class="h-5 w-5 shrink-0" />
      </a>
    </div>

    <p class="mt-16 text-[0.6875rem] font-extrabold tracking-[0.23em] text-[#8798b4] uppercase">
      Carinova · {TAGLINE}
    </p>
  </div>
</section>
