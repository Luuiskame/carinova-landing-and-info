---
// Signing in from wherever the visitor is: "Ingresá" in the header (and every other link marked
// `data-dialog-open` with SIGNIN_DIALOG_ID, src/data/account.ts) opens this dialog, which holds the same form as the
// sign-in page (SigninForm.astro): the e-mail of the account, then the code sent to it. Signed in,
// the customer lands on their account.
//
// PageLayout puts one in every page except the sign-in page itself, which already has the form.
// Without JavaScript, or where there is no dialog, the links simply lead to the sign-in page.
// Opening and closing: DialogKit.astro.
import { Icon } from 'astro-icon/components';
import SigninForm from '~/components/carinova/SigninForm.astro';
import { SIGNIN_DIALOG_ID } from '~/data/account';
import { i18n } from '~/i18n';

const { locale } = i18n(Astro);
const t = {
  es: { label: 'Ingresá a tu cuenta', close: 'Cerrar' },
  en: { label: 'Sign in to your account', close: 'Close' },
}[locale];
---

<dialog id={SIGNIN_DIALOG_ID} class="cn-dialog" aria-label={t.label}>
  <div class="relative">
    <button
      type="button"
      class="absolute top-3 right-3 z-10 flex h-11 w-11 items-center justify-center rounded-full text-slate-500 transition hover:bg-slate-100 hover:text-navy focus-visible:outline-2 focus-visible:outline-brand"
      aria-label={t.close}
      data-cn-dialog-close
    >
      <Icon name="tabler:x" class="h-5 w-5" />
    </button>
    <SigninForm inDialog />
  </div>
</dialog>
