---
// "Una solución para cada necesidad." (home page): the four ways of using Carinova, one card each.
//
// 1. Compras online: the stores people buy from, as a carousel inside the card. One store at a
//    time; it moves on by itself until someone touches it, and each store opens its card (what it
//    sells, a button to its site, the way to ask Carinova to buy there).
// 2. Compra asistida: opens the form where a product's link becomes a request on WhatsApp
//    (ProductLinkForm.astro).
// 3. Encomiendas: a WhatsApp link with its own message.
// 4. Carinova Business: the button to the page for companies.
//
// Cards 2 to 4 have room for a photograph. Drop a file named after the card into
// src/assets/images/soluciones/ (compra-asistida, encomiendas or negocios; .jpg, .png, .webp or
// .avif) and the card shows it: the build resizes it to three widths in AVIF and WebP and the
// browser loads it only when it is about to be seen. While a card has no file it shows its drawing.
// (src/assets/images/soluciones/README.md)
//
// Without JavaScript the carousel is a list that scrolls sideways and each store is a link to its
// site; "Solicitar asistencia" leads to the service's description. Names only, no logos: the
// stores' logos are trademarks of their owners.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import ProductLinkForm from '~/components/carinova/ProductLinkForm.astro';
import SectionHeading from '~/components/carinova/SectionHeading.astro';
import WhatsAppHelp from '~/components/carinova/WhatsAppHelp.astro';
import { CONTACT, type StoreCategoryId } from '~/data/carinova';
import { i18n } from '~/i18n';
import { whatsappLink } from '~/utils/whatsapp';

const { href, data, ui } = i18n(Astro);
const { CTA, STORES, STORE_CATEGORIES, WA_MESSAGES } = data;
const t = ui.solutions;

// The photographs that exist, by the name of their file.
const files = import.meta.glob<ImageMetadata>('/src/assets/images/soluciones/*.{avif,jpeg,jpg,png,webp}', {
  eager: true,
  import: 'default',
});
const photoOf = (id: string): ImageMetadata | undefined =>
  Object.entries(files).find(
    ([path]) =>
      path
        .split('/')
        .pop()
        ?.replace(/\.[a-z]+$/i, '') === id
  )?.[1];

/** A soft colour per category behind the store's name. */
const TINTS: Record<StoreCategoryId, string> = {
  moda: '#f9e6e8',
  tecnologia: '#f7eab9',
  hogar: '#e3edfa',
  marketplaces: '#eaf0df',
  belleza: '#f1e2e5',
};
const categoryName = Object.fromEntries(STORE_CATEGORIES.map((category) => [category.id, category.name]));
const two = (value: number) => String(value).padStart(2, '0');

const ASSIST_DIALOG = 'cn-assist-dialog';

const cards = [
  { id: 'compras-online', text: t.cards.shopping, icon: 'tabler:shopping-bag', tone: 'primary' },
  { id: 'compra-asistida', text: t.cards.assisted, icon: 'tabler:link', tone: 'sand' },
  { id: 'encomiendas', text: t.cards.family, icon: 'tabler:gift', tone: 'ice' },
  { id: 'negocios', text: t.cards.business, icon: 'tabler:building-warehouse', tone: 'business' },
].map((card, index) => ({ ...card, number: two(index + 1), photo: index === 0 ? undefined : photoOf(card.id) }));

const TONES: Record<string, { card: string; icon: string; glyph: string; rule: string }> = {
  primary: {
    card: 'dark border-[#173e64] bg-[linear-gradient(155deg,#001633_3%,#062a53_100%)] text-white',
    icon: 'bg-white/15 text-[#ffb36a]',
    glyph: '',
    rule: 'border-white/20',
  },
  sand: {
    card: 'border-navy/10 bg-[linear-gradient(155deg,#fff4e9,#ffe8d0)] text-[#112442]',
    icon: 'bg-cta/15 text-[#a44c00]',
    glyph: 'text-[#c17e42]',
    rule: 'border-navy/15',
  },
  ice: {
    card: 'border-navy/10 bg-[linear-gradient(150deg,#f0f5fc,#e6edf8)] text-[#112442]',
    icon: 'bg-[#133869]/10 text-[#163b6e]',
    glyph: 'text-[#4d7db3]',
    rule: 'border-navy/15',
  },
  business: {
    card: 'dark border-[#273658] bg-[linear-gradient(150deg,#0d2044_0%,#000e2d_100%)] text-white',
    icon: 'bg-white/15 text-[#ffa34d]',
    glyph: 'text-[#d9e5f5]',
    rule: 'border-white/20',
  },
};

// "Carinova Business: …": the word of the service is orange, in whatever language the sentence is.
const BRAND_WORD = 'Business';
const [beforeBrand, afterBrand] = t.cards.business.title.includes(BRAND_WORD)
  ? t.cards.business.title.split(BRAND_WORD)
  : [t.cards.business.title, undefined];

const config = {
  text: {
    ...t.script,
    // The WhatsApp message of a store's card, with the store still to fill in.
    assist: WA_MESSAGES.storeAssist('{store}'),
  },
};

const actionClass =
  'mt-5 flex min-h-12 items-center justify-between gap-3 border-t pt-4 text-sm font-extrabold transition hover:text-accent';
const roundButton =
  'grid h-11 w-11 place-items-center rounded-full border border-white/25 bg-white/10 text-white transition hover:border-cta hover:bg-cta hover:text-navy focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cta';
const closeButton =
  'absolute end-3 top-3 flex h-11 w-11 items-center justify-center rounded-full text-slate-500 transition hover:bg-slate-100 hover:text-navy focus-visible:outline-2 focus-visible:outline-brand';
---

<!-- The dialogs are outside the section: a dialog keeps the colours of where it is written. -->
<cn-solutions class="block" data-config={JSON.stringify(config)}>
  <section id="soluciones" class="scroll-mt-20 bg-[#fbfcff]">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-20 lg:py-28">
      <SectionHeading number="01" eyebrow={t.eyebrow} title={t.title} aside={t.aside} titleClass="max-w-2xl" />

      <div class="mt-10 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {
          cards.map((card, index) => {
            const tone = TONES[card.tone];
            return (
              <article
                id={index === 0 ? 'compras' : undefined}
                class:list={[
                  'group relative flex scroll-mt-24 flex-col overflow-hidden rounded-[1.15rem] border p-5 shadow-[0_0.55rem_1.75rem_rgb(4_23_50/0.035)] transition duration-300 before:absolute before:inset-x-0 before:top-0 before:h-1 before:bg-[linear-gradient(90deg,#ff8a00,rgb(255_138_0/0.16))] hover:-translate-y-1 hover:shadow-[0_1.5rem_3.6rem_rgb(5_22_51/0.12)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:p-6',
                  tone.card,
                ]}
              >
                <div class="flex items-center justify-between gap-2">
                  <p class="text-[0.6875rem] font-black tracking-[0.08em] uppercase opacity-80">
                    {`${card.number} / ${card.text.label}`}
                  </p>
                  <span class:list={['grid h-10 w-10 shrink-0 place-items-center rounded-xl', tone.icon]}>
                    <Icon name={card.icon} class="h-5 w-5" />
                  </span>
                </div>

                <div class="my-5 h-[12.5rem]">
                  {index === 0 ? (
                    <div class="flex h-full flex-col" data-cn-stores>
                      <ul
                        class="flex min-h-0 flex-1 snap-x snap-mandatory gap-3 overflow-x-auto overscroll-x-contain rounded-xl [scrollbar-width:none] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cta [&::-webkit-scrollbar]:hidden"
                        aria-label={t.stores.label}
                        tabindex="0"
                        data-cn-track
                      >
                        {STORES.map((store) => (
                          <li class="h-full w-full shrink-0 snap-center">
                            <a
                              href={store.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              data-cn-store={JSON.stringify({
                                name: store.name,
                                url: store.url,
                                about: store.about,
                                category: categoryName[store.category],
                              })}
                              style={`background-color:${TINTS[store.category]}`}
                              class="flex h-full flex-col justify-between rounded-xl p-4 text-start text-navy focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-brand"
                            >
                              <span class="flex items-center justify-between gap-2 text-[0.625rem] font-black tracking-[0.14em] text-navy/70 uppercase">
                                {categoryName[store.category]}
                                <Icon name="tabler:arrow-up-right" class="h-4 w-4 shrink-0" />
                              </span>
                              <strong class="font-heading text-[2.15rem] leading-none font-black tracking-[-0.06em] break-words">
                                {store.name}
                              </strong>
                              <span class="text-xs leading-snug text-[#334f6a]">{store.tagline}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                      <div class="mt-2 flex h-11 shrink-0 items-center justify-between gap-3">
                        <p
                          class="text-xs font-extrabold tracking-[0.13em] text-secondary tabular-nums"
                          aria-hidden="true"
                          data-cn-counter
                        >
                          {`${two(1)} / ${two(STORES.length)}`}
                        </p>
                        <p class="sr-only" role="status" aria-live="polite" data-cn-status />
                        <div class="flex gap-1.5" data-cn-controls hidden>
                          <button
                            type="button"
                            class={roundButton}
                            aria-label={t.stores.pause}
                            data-label-pause={t.stores.pause}
                            data-label-play={t.stores.play}
                            data-cn-toggle
                            hidden
                          >
                            <Icon name="tabler:player-pause" class="h-4 w-4" data-icon-pause />
                            <Icon name="tabler:player-play" class="hidden h-4 w-4" data-icon-play />
                          </button>
                          <button type="button" class={roundButton} aria-label={t.stores.previous} data-cn-step="-1">
                            <Icon name="tabler:arrow-left" class="h-5 w-5" />
                          </button>
                          <button type="button" class={roundButton} aria-label={t.stores.next} data-cn-step="1">
                            <Icon name="tabler:arrow-right" class="h-5 w-5" />
                          </button>
                        </div>
                      </div>
                    </div>
                  ) : card.photo ? (
                    <Picture
                      src={card.photo}
                      width={640}
                      formats={['avif', 'webp']}
                      widths={[320, 480, 640]}
                      sizes="(min-width: 80rem) 17rem, (min-width: 40rem) 45vw, 92vw"
                      quality={62}
                      alt={card.text.imageAlt ?? ''}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full rounded-xl object-cover"
                      pictureAttributes={{ class: 'block h-full w-full' }}
                    />
                  ) : (
                    <div class:list={['grid h-full place-items-center', tone.glyph]} aria-hidden="true">
                      {card.id === 'compra-asistida' && (
                        <svg viewBox="0 0 220 180" fill="none" class="h-full max-h-40 w-auto">
                          <rect x="28" y="22" width="165" height="124" rx="16" stroke="currentColor" stroke-width="5" />
                          <path
                            d="M28 54h165M52 39h4M68 39h4M84 39h4"
                            stroke="currentColor"
                            stroke-width="5"
                            stroke-linecap="round"
                          />
                          <path
                            d="M56 84h58M56 104h36"
                            stroke="currentColor"
                            stroke-width="5"
                            stroke-linecap="round"
                            opacity="0.5"
                          />
                          <path
                            d="m124 78 46 18-19 8 12 21-11 6-12-21-13 14-3-46Z"
                            fill="#ff8a00"
                            stroke="#ff8a00"
                            stroke-width="4"
                            stroke-linejoin="round"
                          />
                        </svg>
                      )}
                      {card.id === 'encomiendas' && (
                        <svg viewBox="0 0 220 180" fill="none" class="h-full max-h-40 w-auto">
                          <path
                            d="m45 62 65-33 66 33v73l-66 35-65-35V62Z"
                            stroke="currentColor"
                            stroke-width="5"
                            stroke-linejoin="round"
                          />
                          <path
                            d="m45 62 65 37 66-37M110 99v71"
                            stroke="currentColor"
                            stroke-width="5"
                            stroke-linejoin="round"
                          />
                          <path
                            d="M110 80s-25-15-25-29c0-15 20-18 25-5 5-13 25-10 25 5 0 14-25 29-25 29Z"
                            fill="#ff8a00"
                          />
                        </svg>
                      )}
                      {card.id === 'negocios' && (
                        <svg viewBox="0 0 220 180" fill="none" class="h-full max-h-40 w-auto">
                          <path
                            d="M30 152h160M50 152v13M110 152v13M170 152v13"
                            stroke="currentColor"
                            stroke-width="5"
                            stroke-linecap="round"
                          />
                          <rect x="42" y="90" width="64" height="56" rx="7" stroke="currentColor" stroke-width="5" />
                          <rect x="114" y="90" width="64" height="56" rx="7" stroke="currentColor" stroke-width="5" />
                          <rect x="78" y="28" width="64" height="56" rx="7" stroke="currentColor" stroke-width="5" />
                          <path
                            d="M74 91v19M146 91v19M110 29v19"
                            stroke="#ff9b43"
                            stroke-width="8"
                            stroke-linecap="round"
                          />
                        </svg>
                      )}
                    </div>
                  )}
                </div>

                <div class="mt-auto">
                  <h3 class="font-heading text-[1.3125rem] leading-[1.24] font-extrabold tracking-[-0.035em] text-balance">
                    {card.id === 'negocios' && afterBrand !== undefined ? (
                      <>
                        {beforeBrand}
                        <span class="text-cta">{BRAND_WORD}</span>
                        {afterBrand}
                      </>
                    ) : (
                      card.text.title
                    )}
                  </h3>
                  <p class="mt-2.5 text-sm leading-relaxed opacity-80">{card.text.text}</p>

                  {card.id === 'compras-online' && (
                    <>
                      <a class:list={[actionClass, tone.rule]} href={href(CTA.signup.path)} data-auth="out">
                        {card.text.action}
                        <Icon name="tabler:arrow-up-right" class="h-5 w-5 shrink-0" />
                      </a>
                      <a class:list={[actionClass, tone.rule]} href={href(CTA.account.path)} data-auth="in">
                        {CTA.account.text}
                        <Icon name="tabler:arrow-up-right" class="h-5 w-5 shrink-0" />
                      </a>
                    </>
                  )}
                  {card.id === 'compra-asistida' && (
                    <a
                      class:list={[actionClass, tone.rule]}
                      href={href('/servicios#compras-asistidas')}
                      data-dialog-open={ASSIST_DIALOG}
                    >
                      {card.text.action}
                      <Icon name="tabler:arrow-up-right" class="h-5 w-5 shrink-0" />
                    </a>
                  )}
                  {card.id === 'encomiendas' && (
                    <a
                      class:list={[actionClass, tone.rule]}
                      href={whatsappLink(CONTACT.whatsapp, WA_MESSAGES.homeFamily)}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {card.text.action}
                      <Icon name="tabler:brand-whatsapp" class="h-5 w-5 shrink-0" />
                    </a>
                  )}
                  {card.id === 'negocios' && (
                    <a class="btn-primary mt-5 w-full" href={href('/empresas#solicitud')}>
                      {card.text.action}
                      <Icon name="tabler:arrow-up-right" class="h-5 w-5 shrink-0" />
                    </a>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>

      <p class="mt-5 text-xs leading-relaxed text-muted">
        {t.stores.disclosure}{' '}
        <a class="font-semibold text-link underline underline-offset-4" href={href('/tiendas')}>{t.stores.all}</a>
      </p>
    </div>
  </section>

  <dialog id="cn-store-dialog" class="cn-dialog" aria-labelledby="cn-store-name">
    <div class="relative p-6 sm:p-9">
      <button type="button" class={closeButton} aria-label={t.close} data-cn-dialog-close>
        <Icon name="tabler:x" class="h-5 w-5" />
      </button>
      <p class="eyebrow" data-cn-category></p>
      <h2 id="cn-store-name" class="mt-3 pe-10 font-heading text-4xl font-extrabold text-navy" data-cn-name></h2>
      <p class="mt-3 text-lg text-slate-700" data-cn-about></p>
      <p class="mt-5 rounded-xl bg-[#eef4fb] p-4 text-sm leading-relaxed text-[#375777]">{t.storeNotice}</p>
      <a class="btn-primary mt-6 w-full" target="_blank" rel="noopener noreferrer" data-cn-visit>
        {t.visit}
        <Icon name="tabler:external-link" class="h-5 w-5 shrink-0" />
      </a>
      <div class="mt-3 flex flex-col gap-1 text-sm">
        <WhatsAppHelp message={WA_MESSAGES.storeAssist('…')} text={t.assist} data-cn-assist />
        <a
          class="inline-flex min-h-11 items-center gap-2 font-semibold text-link underline underline-offset-4"
          href={href('/articulos-prohibidos')}
        >
          <Icon name="tabler:search" class="h-5 w-5 shrink-0" />
          {t.restricted}
        </a>
      </div>
    </div>
  </dialog>

  <dialog id={ASSIST_DIALOG} class="cn-dialog" aria-labelledby="cn-assist-title">
    <div class="relative p-6 sm:p-9">
      <button type="button" class={closeButton} aria-label={t.close} data-cn-dialog-close>
        <Icon name="tabler:x" class="h-5 w-5" />
      </button>
      <p class="eyebrow">{t.cards.assisted.label}</p>
      <h2 id="cn-assist-title" class="mt-3 pe-10 font-heading text-3xl font-extrabold text-navy">{t.assistTitle}</h2>
      <p class="mt-3 text-slate-600">{t.assistIntro}</p>

      <div class="mt-6">
        <ProductLinkForm place="home" autofocus />
      </div>
      <a
        class="mt-2 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-link underline underline-offset-4"
        href={href('/articulos-prohibidos')}
      >
        <Icon name="tabler:search" class="h-5 w-5 shrink-0" />
        {t.restricted}
      </a>
    </div>
  </dialog>
</cn-solutions>

<script>
  import { CONTACT } from '~/data/carinova';
  import { fill } from '~/utils/template';
  import { whatsappLink } from '~/utils/whatsapp';

  /** What each store link carries (STORES in src/data/carinova.ts). */
  interface Store {
    name: string;
    url: string;
    about: string;
    category: string;
  }

  interface Config {
    text: Record<'status' | 'assist', string>;
  }

  /** Milliseconds a store stays in view while the carousel moves on by itself. */
  const DWELL = 3400;

  class CnSolutions extends HTMLElement {
    private config!: Config;
    private track!: HTMLElement;
    private items: Array<HTMLElement> = [];
    private index = 0;
    private frame = 0;
    private timer = 0;
    /** The carousel moves on by itself until the visitor takes over (or asks it to stop). */
    private playing = false;
    private hovered = false;
    private inView = false;
    private observer?: IntersectionObserver;

    connectedCallback() {
      const track = this.querySelector<HTMLElement>('[data-cn-track]');
      if (!track) return;
      this.track = track;
      this.config = JSON.parse(this.dataset.config ?? '{}');
      this.items = Array.from(track.children) as Array<HTMLElement>;

      for (const button of this.querySelectorAll<HTMLButtonElement>('[data-cn-step]')) {
        button.addEventListener('click', () => {
          this.stop();
          this.go(this.index + Number(button.dataset.cnStep), true);
        });
      }
      // The store being shown follows the scroll, whoever moved it: a finger, the arrows, the keyboard.
      track.addEventListener(
        'scroll',
        () => {
          window.cancelAnimationFrame(this.frame);
          this.frame = window.requestAnimationFrame(() => this.follow());
        },
        { passive: true }
      );
      track.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        this.stop();
        const forward = (event.key === 'ArrowRight') !== this.rtl();
        this.go(this.index + (forward ? 1 : -1), true);
      });
      // A finger or the wheel on the stores: the visitor is driving now.
      for (const type of ['touchstart', 'wheel'] as const) {
        track.addEventListener(type, () => this.stop(), { passive: true });
      }

      // A store's link opens its card; with Ctrl, ⌘, Shift or Alt it still opens the store, as links do.
      for (const link of this.querySelectorAll<HTMLAnchorElement>('[data-cn-store]')) {
        link.addEventListener('click', (event) => {
          if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          this.open(link);
        });
      }

      const controls = this.querySelector<HTMLElement>('[data-cn-controls]');
      if (controls) controls.hidden = false;
      this.autoplay();
    }

    disconnectedCallback() {
      window.cancelAnimationFrame(this.frame);
      window.clearInterval(this.timer);
      this.observer?.disconnect();
    }

    private rtl(): boolean {
      return getComputedStyle(this.track).direction === 'rtl';
    }

    /** How far apart two stores are, along the track. */
    private stride(): number {
      if (this.items.length < 2) return this.track.clientWidth;
      return Math.abs(this.items[1].offsetLeft - this.items[0].offsetLeft);
    }

    /**
     * The carousel moves on by itself while it is on screen, nobody is pointing at it and the visitor
     * has not asked for less motion. The pause button and any use of the carousel stop it for good.
     */
    private autoplay() {
      const stores = this.querySelector<HTMLElement>('[data-cn-stores]');
      const toggle = this.querySelector<HTMLButtonElement>('[data-cn-toggle]');
      if (!stores || !toggle || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      toggle.hidden = false;
      toggle.addEventListener('click', () => (this.playing ? this.stop() : this.start()));
      stores.addEventListener('pointerenter', () => (this.hovered = true));
      stores.addEventListener('pointerleave', () => (this.hovered = false));
      stores.addEventListener('focusin', (event) => {
        if (event.target !== toggle) this.hovered = true;
      });
      stores.addEventListener('focusout', () => (this.hovered = false));

      this.observer = new IntersectionObserver(([entry]) => (this.inView = entry.isIntersecting), { threshold: 0.6 });
      this.observer.observe(stores);
      this.start();
    }

    private start() {
      this.playing = true;
      this.showToggle();
      window.clearInterval(this.timer);
      this.timer = window.setInterval(() => {
        const dialogOpen = this.querySelector('dialog[open]') !== null;
        if (document.hidden || !this.inView || this.hovered || dialogOpen) return;
        this.go(this.index + 1, false);
      }, DWELL);
    }

    private stop() {
      if (!this.playing) return;
      this.playing = false;
      window.clearInterval(this.timer);
      this.showToggle();
    }

    private showToggle() {
      const toggle = this.querySelector<HTMLButtonElement>('[data-cn-toggle]');
      if (!toggle) return;
      toggle.setAttribute('aria-label', (this.playing ? toggle.dataset.labelPause : toggle.dataset.labelPlay) ?? '');
      toggle.querySelector('[data-icon-pause]')?.classList.toggle('hidden', !this.playing);
      toggle.querySelector('[data-icon-play]')?.classList.toggle('hidden', this.playing);
    }

    private setCounter(announce: boolean) {
      const two = (value: number) => String(value).padStart(2, '0');
      const counter = this.querySelector('[data-cn-counter]');
      if (counter) counter.textContent = `${two(this.index + 1)} / ${two(this.items.length)}`;
      if (!announce) return;
      const link = this.items[this.index]?.querySelector<HTMLAnchorElement>('[data-cn-store]');
      const status = this.querySelector('[data-cn-status]');
      if (link && status) {
        const { name } = JSON.parse(link.dataset.cnStore ?? '{}') as Store;
        status.textContent = fill(this.config.text.status, { name, index: this.index + 1, total: this.items.length });
      }
    }

    /** Shows a store; past either end it goes round. Works the same from right to left. */
    private go(index: number, announce: boolean) {
      const total = this.items.length;
      if (total === 0) return;
      this.index = ((index % total) + total) % total;
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      this.track.scrollTo({
        left: this.index * this.stride() * (this.rtl() ? -1 : 1),
        behavior: calm ? 'auto' : 'smooth',
      });
      this.setCounter(announce);
    }

    /** After a scroll: the store nearest to the start of the track is the one being shown. */
    private follow() {
      const stride = this.stride();
      if (stride === 0) return;
      const nearest = Math.min(this.items.length - 1, Math.round(Math.abs(this.track.scrollLeft) / stride));
      if (nearest === this.index) return;
      this.index = nearest;
      this.setCounter(false);
    }

    private open(link: HTMLAnchorElement) {
      const dialog = this.querySelector<HTMLDialogElement>('#cn-store-dialog');
      if (!dialog) return;
      const store = JSON.parse(link.dataset.cnStore ?? '{}') as Store;
      const set = (selector: string, value: string) => {
        const element = dialog.querySelector(selector);
        if (element) element.textContent = value;
      };
      set('[data-cn-category]', store.category);
      set('[data-cn-name]', store.name);
      set('[data-cn-about]', store.about);
      dialog.querySelector('[data-cn-visit]')?.setAttribute('href', store.url);
      dialog
        .querySelector('[data-cn-assist]')
        ?.setAttribute('href', whatsappLink(CONTACT.whatsapp, fill(this.config.text.assist, { store: store.name })));
      if (!dialog.open) dialog.showModal();
    }
  }

  if (!customElements.get('cn-solutions')) customElements.define('cn-solutions', CnSolutions);
</script>
