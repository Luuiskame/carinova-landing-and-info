---
// "Preguntas frecuentes." on the home page, in two columns: what the section is on one side, with the
// way to ask something else, and the featured questions on the other (FEATURED_FAQS, in their
// order), one open at a time. Native <details>: no JavaScript. These questions and the rest of them
// live on /preguntas-frecuentes, which is also the one page that describes them to search engines
// (FAQPage): the same questions marked up on two pages would compete with each other.
import { Icon } from 'astro-icon/components';
import SectionHeading from '~/components/carinova/SectionHeading.astro';
import WhatsAppHelp from '~/components/carinova/WhatsAppHelp.astro';
import { i18n } from '~/i18n';

const { href, data, ui } = i18n(Astro);
const { FEATURED_FAQS, WA_MESSAGES } = data;
const t = ui.homeFaq;
---

<section id="preguntas" class="scroll-mt-20 bg-white">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 md:py-20 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20 lg:py-28">
    <div>
      <SectionHeading number="07" eyebrow={t.eyebrow} title={t.title} />
      <p class="mt-5 max-w-xs text-base leading-relaxed text-muted sm:text-lg">{t.intro}</p>
      <div class="mt-5 flex flex-col items-start gap-1">
        <WhatsAppHelp message={WA_MESSAGES.homeFaq} text={t.help} />
        <a
          class="inline-flex min-h-11 items-center gap-1 font-semibold text-link underline underline-offset-4"
          href={href('/preguntas-frecuentes')}
        >
          {t.all}
          <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
        </a>
      </div>
    </div>

    <div class="border-t border-[#e0e7f0]">
      {
        FEATURED_FAQS.map((item, index) => (
          <details name="home-faq" class="group border-b border-[#e0e7f0]" open={index === 0}>
            <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-5 py-3.5 font-heading text-base leading-snug font-extrabold text-[#0b2241] transition hover:text-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:text-[1.0625rem] [&::-webkit-details-marker]:hidden">
              {item.title}
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-[#fff0e2] text-[#b85600]">
                <Icon
                  name="tabler:plus"
                  class="h-4 w-4 transition group-open:rotate-45 motion-reduce:transition-none"
                />
              </span>
            </summary>
            <p class="pe-12 pb-5 leading-relaxed text-[#48607c]" set:html={item.description} />
          </details>
        ))
      }
    </div>
  </div>
</section>
