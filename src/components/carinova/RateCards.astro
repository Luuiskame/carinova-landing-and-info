---
// The rates (/cotizador): one card per rate, the conditions under them, and how each price is worked
// out, with the cubic-foot example of Carinova's brief. Everything comes from RATES and is computed
// with utils/rates.ts, like the calculator above it. A shipment is quoted on one basis at a time and
// the arithmetic is exact: which basis applies is confirmed by Carinova on reception.
import { Icon } from 'astro-icon/components';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import ServiceBadge from '~/components/carinova/ServiceBadge.astro';
import { LAST_MILE } from '~/data/carinova';
import { quotePath } from '~/data/services';
import { i18n } from '~/i18n';
import {
  CUBIC_CM_PER_CUBIC_FOOT,
  describeUnitLine,
  describeVolume,
  describeWeight,
  formatNumber,
  formatUSD,
  quoteByVolume,
  quoteByWeight,
  quoteUnits,
} from '~/utils/rates';

const { locale, href, data } = i18n(Astro);
const { BRANCHES, FORMULA_EXAMPLE, RATES } = data;

const { air, sea, electronics } = RATES;

const t = {
  es: {
    tagline: 'Tarifas',
    title: 'Dos caminos. Un mismo destino.',
    subtitle:
      'Las tarifas contemplan seguro e impuestos cuando correspondan al envío. Los plazos cuentan desde la recepción física de tu paquete.',
    cities: BRANCHES.map((branch) => branch.city).join(' y '),
    perPound: 'por libra',
    perCubicFoot: 'por pie³',
    airFacts: ['Pensado para lo que querés recibir pronto.', 'Algunos electrónicos tienen tarifa fija por unidad.'],
    seaFacts: [
      'Ideal para cargas grandes y compras planificadas.',
      'La base por peso o por volumen se determina según la carga, su empaque y las condiciones del servicio.',
    ],
    calculate: (name: string) => `Calcular envío ${name.toLowerCase()}`,
    calculateUnits: 'Calcular por unidad',
    electronicsNote: 'Tarifa por unidad en envíos aéreos. No se suma a la tarifa por libra.',
    pickup: 'Retiro en sucursal:',
    homeDelivery: 'Entrega a domicilio',
    howTitle: 'Cómo calculamos',
    howIntro: 'Una base de cálculo a la vez: el peso, el volumen y la tarifa por unidad no se suman.',
    byPound: {
      title: 'Por libra',
      applies: 'Aéreo y marítimo',
      rule: 'Peso en libras × tarifa por libra, sin mínimos ni redondeos. El peso se valida en la recepción.',
    },
    byCubicFoot: {
      title: 'Por pie cúbico',
      applies: 'Marítimo',
      rule: `Largo × ancho × alto de la caja ÷ 1,728 si medís en pulgadas, o ÷ ${formatNumber(CUBIC_CM_PER_CUBIC_FOOT)} si medís en centímetros = pies cúbicos; × ${formatUSD(sea.pricePerCubicFoot)}.`,
      link: 'Probalo en el cotizador',
    },
    byUnit: {
      title: 'Por unidad',
      applies: 'Electrónicos, por aéreo',
      rule: 'Cantidad × tarifa del equipo. No se le suma la tarifa por libra.',
    },
  },
  en: {
    tagline: 'Rates',
    title: 'Two routes. One destination.',
    subtitle:
      'Rates include insurance and taxes where they apply to the shipment. Delivery times count from the physical reception of your package.',
    cities: BRANCHES.map((branch) => branch.city).join(' and '),
    perPound: 'per pound',
    perCubicFoot: 'per ft³',
    airFacts: ['Made for what you want to receive soon.', 'Some electronics have a flat rate per unit.'],
    seaFacts: [
      'Ideal for large loads and planned purchases.',
      'Whether weight or volume applies is determined by the cargo, its packaging and the conditions of the service.',
    ],
    calculate: (name: string) => `Calculate ${name.toLowerCase()} shipping`,
    calculateUnits: 'Calculate per unit',
    electronicsNote: 'Rate per unit on air shipments. It is not added to the rate per pound.',
    pickup: 'Branch pickup:',
    homeDelivery: 'Home delivery',
    howTitle: 'How we calculate',
    howIntro: 'One basis at a time: weight, volume and the rate per unit are not added together.',
    byPound: {
      title: 'Per pound',
      applies: 'Air and sea',
      rule: 'Weight in pounds × rate per pound, with no minimums and no rounding. The weight is validated on reception.',
    },
    byCubicFoot: {
      title: 'Per cubic foot',
      applies: 'Sea',
      rule: `Length × width × height of the box ÷ 1,728 if you measure in inches, or ÷ ${formatNumber(CUBIC_CM_PER_CUBIC_FOOT)} if you measure in centimeters = cubic feet; × ${formatUSD(sea.pricePerCubicFoot)}.`,
      link: 'Try it in the calculator',
    },
    byUnit: {
      title: 'Per unit',
      applies: 'Electronics, by air',
      rule: 'Quantity × rate of the device. The rate per pound is not added to it.',
    },
  },
}[locale];

const cards = [
  {
    id: air.id,
    icon: air.icon,
    name: air.name,
    badge: air.badge,
    prices: [{ amount: formatUSD(air.pricePerLb), unit: t.perPound }],
    transit: air.transit,
    facts: t.airFacts,
  },
  {
    id: sea.id,
    icon: sea.icon,
    name: sea.name,
    badge: sea.badge,
    prices: [
      { amount: formatUSD(sea.pricePerLb), unit: t.perPound },
      { amount: formatUSD(sea.pricePerCubicFoot), unit: t.perCubicFoot },
    ],
    transit: sea.transit,
    facts: t.seaFacts,
  },
];

// Worked examples of each way of pricing.
const byWeight = quoteByWeight(5, air.pricePerLb);
const byVolume = quoteByVolume(FORMULA_EXAMPLE.dims, sea.pricePerCubicFoot, { unit: FORMULA_EXAMPLE.unit });
const byUnit = quoteUnits({ [electronics.items[0].id]: 2 }, electronics.items);

const formulas = [
  {
    icon: 'tabler:scale',
    title: t.byPound.title,
    applies: t.byPound.applies,
    rule: t.byPound.rule,
    example: [describeWeight(byWeight)],
  },
  {
    icon: 'tabler:ruler-measure',
    title: t.byCubicFoot.title,
    applies: t.byCubicFoot.applies,
    rule: t.byCubicFoot.rule,
    example: [`${FORMULA_EXAMPLE.item}: ${describeVolume(byVolume, locale)}`],
    link: { text: t.byCubicFoot.link, path: FORMULA_EXAMPLE.path },
  },
  {
    icon: 'tabler:devices',
    title: t.byUnit.title,
    applies: t.byUnit.applies,
    rule: t.byUnit.rule,
    example: byUnit.lines.map(describeUnitLine),
  },
];
---

<WidgetWrapper id="tarifas" containerClass="max-w-5xl" bg='<div class="absolute inset-0 bg-slate-50"></div>'>
  <Headline tagline={t.tagline} title={t.title} subtitle={t.subtitle} />

  <div class="grid gap-6 md:grid-cols-3">
    {
      cards.map((card) => (
        <article class="flex flex-col rounded-2xl border-t-[5px] border-cta bg-white p-6 shadow-sm ring-1 ring-slate-200">
          <p class="w-fit rounded-full border border-[#ffdbbb] bg-[#fff5eb] px-3 py-1 text-xs font-bold text-secondary">
            {card.badge}
          </p>
          <h3 class="mt-4 flex items-center gap-2 font-heading text-2xl font-bold text-heading">
            <Icon name={card.icon} class="h-7 w-7 text-primary" />
            {card.name}
          </h3>
          <ul class="mt-5 space-y-1">
            {card.prices.map((price) => (
              <li class="flex items-baseline gap-1.5 text-heading">
                <span class="font-heading text-4xl font-extrabold tracking-tight">{price.amount}</span>
                <span class="text-muted">{price.unit}</span>
              </li>
            ))}
          </ul>
          <p class="mt-3 flex items-center gap-1.5 text-sm font-medium text-slate-700">
            <Icon name="tabler:clock" class="h-4 w-4" />
            {card.transit}
          </p>
          <ul class="mt-5 flex-1 space-y-2.5 text-sm">
            {card.facts.map((fact) => (
              <li class="flex gap-2">
                <Icon name="tabler:circle-check-filled" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                <span>{fact}</span>
              </li>
            ))}
          </ul>
          <a
            class="mt-6 font-semibold text-link underline underline-offset-4"
            href={href(quotePath({ tarifa: card.id }))}
          >
            {t.calculate(card.name)}
          </a>
        </article>
      ))
    }

    <article class="flex flex-col rounded-2xl border-t-[5px] border-navy bg-white p-6 shadow-sm ring-1 ring-slate-200">
      <h3 class="flex items-center gap-2 font-heading text-2xl font-bold text-heading">
        <Icon name={electronics.icon} class="h-7 w-7 text-primary" />
        {electronics.name}
      </h3>
      <p class="mt-1 text-sm text-muted">{t.electronicsNote}</p>
      <dl class="mt-4 divide-y divide-slate-100">
        {
          electronics.items.map((item) => (
            <div class="flex items-center justify-between gap-3 py-2">
              <dt class="flex items-center gap-2">
                <Icon name={item.icon} class="h-5 w-5 text-slate-500" />
                {item.name}
              </dt>
              <dd class="font-heading text-lg font-bold text-heading">{formatUSD(item.price)}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-3 flex flex-1 items-start gap-1.5 text-sm font-medium text-slate-700">
        <Icon name="tabler:clock" class="mt-0.5 h-4 w-4" />
        {electronics.transit}
      </p>
      <a
        class="mt-6 font-semibold text-link underline underline-offset-4"
        href={href(quotePath({ tarifa: air.id, base: electronics.items[0].id }))}
      >
        {t.calculateUnits}
      </a>
    </article>
  </div>

  <div
    class="mt-6 flex flex-col gap-3 rounded-2xl bg-white p-5 text-sm ring-1 ring-slate-200 sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="flex items-center gap-2">
      <Icon name="tabler:building-store" class="h-5 w-5 shrink-0 text-primary" />
      <span><strong class="text-heading">{t.pickup}</strong> {t.cities}.</span>
    </p>
    {
      LAST_MILE.available && (
        <p class="flex flex-wrap items-center gap-2">
          <Icon name="tabler:truck-delivery" class="h-5 w-5 shrink-0 text-primary" />
          <strong class="text-heading">{t.homeDelivery}</strong>
          {LAST_MILE.extraCharge && <ServiceBadge kind="extra" />}
        </p>
      )
    }
  </div>

  <ul class="mx-auto mt-6 max-w-3xl space-y-1.5 text-center text-sm text-muted">
    {RATES.notes.map((note) => <li>{note}</li>)}
  </ul>

  <h2
    class="mt-16 text-center font-heading text-3xl font-bold tracking-tight text-heading md:text-4xl"
    id="como-calculamos"
  >
    {t.howTitle}
  </h2>
  <p class="mx-auto mt-3 max-w-2xl text-center text-muted">{t.howIntro}</p>
  <div class="mt-8 grid gap-6 md:grid-cols-3">
    {
      formulas.map((formula) => (
        <article class="flex flex-col rounded-2xl bg-white p-6 ring-1 ring-slate-200">
          <h3 class="flex items-center gap-2 font-heading text-xl font-bold text-heading">
            <Icon name={formula.icon} class="h-6 w-6 text-primary" />
            {formula.title}
          </h3>
          <p class="mt-1 text-sm font-semibold text-secondary">{formula.applies}</p>
          <p class="mt-3 text-sm">{formula.rule}</p>
          <div class="mt-4 flex-1 rounded-xl bg-slate-100 p-3 text-sm font-semibold break-words text-heading tabular-nums">
            {formula.example.map((line) => (
              <p>{line}</p>
            ))}
          </div>
          {formula.link && (
            <a class="mt-4 font-semibold text-link underline underline-offset-4" href={href(formula.link.path)}>
              {formula.link.text}
            </a>
          )}
        </article>
      ))
    }
  </div>
</WidgetWrapper>
