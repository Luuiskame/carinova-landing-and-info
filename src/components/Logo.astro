---
// Carinova's wordmark, as Carinova supplied it with its prototype: white letters with the orange
// globe in the place of the "o", on a transparent background. It is made for navy: the header and
// the footer are the only places it is used. (On a light background use the logo image,
// src/assets/images/carinova-logo.jpeg.)
import { Image } from 'astro:assets';
import { SITE } from 'astrowind:config';
import { twMerge } from 'tailwind-merge';
import wordmark from '~/assets/images/carinova-wordmark.webp';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<Image
  src={wordmark}
  alt={SITE?.name ?? 'Carinova'}
  width={400}
  densities={[1, 2]}
  loading="eager"
  class={twMerge('block h-8 w-auto max-w-none shrink-0 sm:h-9', className)}
/>
