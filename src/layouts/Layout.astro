---
import '~/assets/styles/tailwind.css';

import { Font } from 'astro:assets';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import Intersect from '~/components/common/Intersect.astro';
import SessionState from '~/components/carinova/SessionState.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import { LOCALE_INFO, i18n } from '~/i18n';
import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
  /**
   * Whether links to other pages are followed by Astro's client router (a swap of the page's body).
   * Off on a page that carries the home page's own parts (D-137): as on the home page, a link that
   * leaves it or leads to it is a plain navigation, so the home page's stylesheet and the site's
   * never stay together in one page.
   */
  router?: boolean;
}

const { metadata = {}, router = true } = Astro.props;
// The language of the page comes from its address: Spanish at the root, a translation under its
// prefix (/en, /fr…). The language decides which way the page is written too (Arabic: right to left).
const { locale } = i18n(Astro);
const { htmlLang, dir } = LOCALE_INFO[locale];
// The font is fetched ahead only for the letters this page is written with (astro.config.ts → fonts):
// Latin, plus Cyrillic in Russian, and nothing in Arabic, which is set in the device's own font
// (tailwind.css).
const fontSubsets = locale === 'ar' ? [] : locale === 'ru' ? ['latin', 'cyrillic'] : ['latin'];
---

<!doctype html>
<html lang={htmlLang} dir={dir} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <Font
      cssVariable="--font-inter"
      preload={fontSubsets.length > 0 ? fontSubsets.map((subset) => ({ subset })) : false}
    />
    <CustomStyles />
    <ApplyColorMode />
    <SessionState />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    <!-- Comment the line below to disable View Transitions -->
    {router && <ClientRouter fallback="swap" />}

    <!-- Extra head content from pages: structured data, rel=prev/next, … -->
    <slot name="head" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight min-h-screen flex flex-col">
    <slot />

    <Intersect />
  </body>
</html>
