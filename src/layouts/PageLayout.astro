---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import DialogKit from '~/components/carinova/DialogKit.astro';
import SigninDialog from '~/components/carinova/SigninDialog.astro';
import TopStrip from '~/components/carinova/TopStrip.astro';
import WhatsAppFloat from '~/components/carinova/WhatsAppFloat.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import { i18n, spanishPath } from '~/i18n';
import { getFooterData, getHeaderData } from '~/navigation';
import { getCanonical } from '~/utils/permalinks';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  /**
   * The page's name in the trail search engines show above a result ("Inicio › Cotizador"). Left out
   * on the home page and on pages that are not indexed.
   */
  breadcrumb?: string;
}

const { metadata, breadcrumb } = Astro.props;

// Header and footer in the language of the page (its address decides: src/i18n).
const page = i18n(Astro);
const { pathname } = Astro.url;

// "Ingresá" opens the sign-in dialog on every page but the sign-in page, which is the form itself.
const hasSigninDialog = spanishPath(pathname) !== page.data.CTA.signin.path;

const trail = breadcrumb && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { name: { es: 'Inicio', en: 'Home' }[page.locale], url: String(getCanonical(page.href('/'))) },
    { name: breadcrumb, url: String(getCanonical(pathname)) },
  ].map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, item: item.url })),
};
---

<Layout metadata={metadata}>
  {trail && <StructuredData slot="head" schema={trail} />}
  <slot name="head" slot="head" />
  {
    /*
    Slot fallbacks are rendered explicitly. With `<slot name="x">fallback</slot>`
    Astro still evaluates the fallback when the page overrides the slot, and
    astro-icon then believes the icons inside it (the RSS icon of the default
    header, for instance) were already emitted, so their SVG sprite symbol
    goes missing on that page.
  */
  }
  {
    Astro.slots.has('header') ? (
      <slot name="header" />
    ) : (
      <>
        <TopStrip />
        <Header {...getHeaderData(page, pathname)} isSticky isDark position="right" />
      </>
    )
  }
  <main class="flex-1">
    <slot />
  </main>
  {Astro.slots.has('footer') ? <slot name="footer" /> : <Footer {...getFooterData(page, pathname)} />}
  <WhatsAppFloat path={pathname} />
  {hasSigninDialog && <SigninDialog />}
  <DialogKit />
</Layout>
