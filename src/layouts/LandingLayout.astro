---
// The layout of the home page: the page Carinova wrote on 2026-11-18, which has its own look, its
// own header and its own footer (src/components/landing). It shares nothing visible with the rest
// of the site (Layout.astro, Tailwind), only what a page needs in its <head>: the language and the
// direction of the address, the metadata, the favicons and whether the visitor is signed in.
//
// What it does for the first paint:
// - The stylesheet of the page (landing.css) is written into the page: nothing else has to arrive
//   before the text is drawn. The dialogs' own rules load when a dialog opens (landing-dialog.css).
// - The text shows at once, in a fallback with the metrics of Manrope, and Manrope takes its place
//   when it arrives without moving anything. It is not fetched ahead (no preload): a browser holds
//   the first paint back for a font it is already fetching, and by the time the font had come the
//   whole page was waiting to be laid out in one go. On a slow phone that put the first paint at
//   0.82 s instead of 0.37 to 0.59 s, to gain 0.06 s on the font (docs/PROJECT-LOG.md → D-108).
//   The fallback is "Manrope Fallback", in landing.css.
// - No client router: a link to another page of the site is a plain navigation, so the two
//   stylesheets never meet.
//
// The language a visitor chose in the page's menu is remembered, as Carinova's page remembered it:
// whoever arrives from elsewhere at the Spanish home page (the address without a language) is taken
// to the home page of their language. Only from elsewhere: inside the site, the address says which
// language is wanted (docs/PROJECT-LOG.md → D-121).
import { Font } from 'astro:assets';

import css from '~/assets/styles/landing.css?inline';
import SessionState from '~/components/carinova/SessionState.astro';
import Analytics from '~/components/common/Analytics.astro';
import CommonMeta from '~/components/common/CommonMeta.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Favicons from '~/components/Favicons.astro';

import { LOCALE_INFO, i18n, languagesOf } from '~/i18n';
import { DEFAULT_LOCALE } from '~/i18n/locales';
import { getPermalink } from '~/utils/permalinks';
import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { locale } = i18n(Astro);
const { htmlLang, dir } = LOCALE_INFO[locale];
/** On the Spanish home page: the home page of each other language that is live, for the visitor who chose one. */
const others =
  locale === DEFAULT_LOCALE && Astro.url.pathname === '/'
    ? languagesOf('/').filter((language) => language.locale !== DEFAULT_LOCALE)
    : [];
const homes = Object.fromEntries(others.map((language) => [language.locale, getPermalink(language.home)]));
/**
 * Runs before the page is drawn. The language is the one the menu stored (scripts/boot.ts), under
 * the name Carinova's page used; a visit that comes from a page of the site is left alone.
 */
const remembered = others.length
  ? `try{var c=JSON.parse(localStorage.getItem('carinova-language')||'null'),h=${JSON.stringify(homes).replace(/</g, '\\u003c')},i=document.referrer&&new URL(document.referrer).origin===location.origin;if(!i&&typeof c==='string'&&h.hasOwnProperty(c))location.replace(h[c]+location.search+location.hash)}catch(e){}`
  : '';
---

<!doctype html>
<html lang={htmlLang} dir={dir}>
  <head>
    <CommonMeta />
    <meta name="theme-color" content="#001127" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <Favicons />
    <Font cssVariable="--font-manrope" />
    <style is:inline set:html={css}></style>
    <SessionState />
    {remembered && <script is:inline set:html={remembered} />}
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    <slot name="head" />
  </head>

  <body>
    <slot />
  </body>
</html>
