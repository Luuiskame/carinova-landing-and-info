# build output
dist/
.output/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables and secrets (.env.example is the template that is committed)
.env
.env.*
!.env.example
.dev.vars*

# macOS-specific files
.DS_Store

# pnpm-specific files: pnpm is supported for local use (see .pnpmrc), but
# package-lock.json is the tracked lockfile and npm is what CI, Docker and
# the deploy targets run. Committing these would let the two trees diverge.
pnpm-lock.yaml
pnpm-workspace.yaml

.astro

# Cloudflare Wrangler: local dev state and temporary bundles
.wrangler